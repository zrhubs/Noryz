    })

    local function Separator(Order)
        return New("Frame", {
            BackgroundColor3 = "OutlineColor",
            LayoutOrder = Order,
            Size = UDim2.fromOffset(1, 14),
            Parent = Frame,
        })
    end

    local function Stat(Order, Unit, Width)
        local Holder = New("Frame", {
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            LayoutOrder = Order,
            Size = UDim2.fromOffset(0, 32),
            Parent = Frame,
        })
        New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            Padding = UDim.new(0, 4),
            Parent = Holder,
        })
        local Value = New("TextLabel", {
            FontFace = Fonts.SemiBold,
            Size = UDim2.fromOffset(Width, 32),
            Text = "0",
            TextColor3 = Palette.AccentText,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = Holder,
        })
        New("TextLabel", {
            AutomaticSize = Enum.AutomaticSize.X,
            LayoutOrder = 1,
            Size = UDim2.fromOffset(0, 32),
            Text = Unit,
            TextSize = 12,
            TextTransparency = 0.45,
            Parent = Holder,
        })
        return Holder, Value
    end

    local FpsSeparator = Separator(2)
    local FpsHolder, FpsValue = Stat(3, "fps", 30)
    local PingSeparator = Separator(4)
    local PingHolder, PingValue = Stat(5, "ms", 30)
    local TimeSeparator = Separator(6)
    local TimeLabel = New("TextLabel", {
        AutomaticSize = Enum.AutomaticSize.X,
        LayoutOrder = 7,
        Size = UDim2.fromOffset(0, 32),
        Text = "00:00",
        TextSize = 13,
        TextTransparency = 0.3,
        Parent = Frame,
    })

    Library:MakeDraggable(Frame, Frame, true)
    table.insert(Library.DraggableElements, Frame)

    Watermark.Frame = Frame
    Watermark.Title = Title
    Watermark.ShowStats = true
    Watermark.ShowTime = true

    local function ApplyStatsVisibility()
        FpsSeparator.Visible = Watermark.ShowStats
        FpsHolder.Visible = Watermark.ShowStats
        PingSeparator.Visible = Watermark.ShowStats
        PingHolder.Visible = Watermark.ShowStats
        TimeSeparator.Visible = Watermark.ShowTime
        TimeLabel.Visible = Watermark.ShowTime
    end

    function Watermark:SetText(Text)
        Text = tostring(Text)
        Title.Text = Text
        --// scripts that already print their own fps/ping into the watermark keep a single readout
        Watermark.ShowStats = Text:lower():find("fps") == nil
        ApplyStatsVisibility()
    end

    function Watermark:SetVisible(Visible)
        Frame.Visible = Visible == true
    end

    function Watermark:SetShowStats(Value)
        Watermark.ShowStats = Value ~= false
        ApplyStatsVisibility()
    end

    function Watermark:SetShowTime(Value)
        Watermark.ShowTime = Value ~= false
        ApplyStatsVisibility()
    end

    local FrameCount = 0
    local Elapsed = 0
    Library:GiveSignal(RunService.RenderStepped:Connect(function(DeltaTime)
        FrameCount += 1
        Elapsed += DeltaTime
        if Elapsed < 0.5 then
            return
        end

        Library.FPS = math.floor(FrameCount / Elapsed + 0.5)
        FrameCount = 0
        Elapsed = 0

        local PingValueMs = nil
        pcall(function()
            PingValueMs = StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if not PingValueMs then
            pcall(function()
                PingValueMs = LocalPlayer:GetNetworkPing() * 1000
            end)
        end
        Library.Ping = math.floor((PingValueMs or 0) + 0.5)

        if Frame.Visible then
            FpsValue.Text = tostring(Library.FPS)
            PingValue.Text = tostring(Library.Ping)
            TimeLabel.Text = os.date("%H:%M:%S")
        end
    end))

    ApplyStatsVisibility()
end
Library.Watermark = Watermark

function Library:SetWatermark(Text)
    Watermark:SetText(Text)
end

function Library:SetWatermarkVisibility(Visible)
    Watermark:SetVisible(Visible)
end

