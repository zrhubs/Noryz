local TooltipFrame, TooltipLabel, TooltipStroke
do
    TooltipFrame = New("Frame", {
        AutomaticSize = Enum.AutomaticSize.XY,
        BackgroundColor3 = Palette.Popup,
        Size = UDim2.fromOffset(0, 0),
        Visible = false,
        ZIndex = 1,
        Parent = TooltipLayer,
    })
    AddCorner(TooltipFrame, 0.55)
    AddScale(TooltipFrame)
    TooltipStroke = AddStroke(TooltipFrame, "OutlineColor", 0)
    AddPadding(TooltipFrame, 5, 9, 6, 9)

    TooltipLabel = New("TextLabel", {
        AutomaticSize = Enum.AutomaticSize.XY,
        Size = UDim2.fromOffset(0, 0),
        Text = "",
        TextSize = 13,
        TextTransparency = 0.08,
        TextWrapped = true,
        Parent = TooltipFrame,
    })
    New("UISizeConstraint", { MaxSize = Vector2.new(280, math.huge), Parent = TooltipLabel })
