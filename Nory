        if Title then
            Data.Title = tostring(Text)
            Title.Text = Data.Title
            Data:Resize()
        end
    end

    function Data:ChangeDescription(Text)
        if Desc then
            Data.Description = tostring(Text)
            Desc.Text = Data.Description
            Data:Resize()
        end
    end

    function Data:ChangeStep(NewStep)
        if Data.Steps then
            NewStep = math.clamp(tonumber(NewStep) or 0, 0, Data.Steps)
            Tween(TimerBar, Library.SmoothTweenInfo, { Size = UDim2.new(NewStep / Data.Steps, 0, 0, 2) })
        end
    end

    function Data:Destroy(Reason)
        if Data.Destroyed then
            return
        end

        Data.Destroyed = true
        Reason = Reason or "script"

        if Data.Callback then
            pcall(Data.Callback, Reason)
        end
        if typeof(Data.Time) == "Instance" then
            pcall(Data.Time.Destroy, Data.Time)
        end
        if DeleteConnection then
            DeleteConnection:Disconnect()
        end

        local Index = table.find(NotifyOrder, Slot)
        if Index then
            table.remove(NotifyOrder, Index)
        end

        local Left = tostring(Library.NotifySide):lower() == "left"
        Tween(Card, Library.NotifyTweenInfo, {
            Position = UDim2.new(Left and -1 or 1, Left and -20 or 20, 0, 0),
        })

        Library:UpdateNotificationPositions()

        task.delay(Library.NotifyTweenInfo.Time, function()
            Library.Notifications[Slot] = nil
            Slot:Destroy()
            Library:UpdateNotificationPositions()
        end)
    end

    if Data.SoundId then
        local SoundId = Data.SoundId
        if typeof(SoundId) == "number" then
            SoundId = string.format("rbxassetid://%d", SoundId)
        end
        pcall(function()
            local Sound = New("Sound", {
                SoundId = SoundId,
                Volume = tonumber(Data.Volume) or 3,
                PlayOnRemove = true,
                Parent = SoundService,
            })
            Sound:Destroy()
        end)
    end

    Data.Holder = Card
    Data.Card = Card
    Data.Frame = Slot

    table.insert(NotifyOrder, Slot)
    Library.Notifications[Slot] = Data

    Slot.Visible = true
    Library:UpdateNotificationPositions()
    Tween(Card, Library.NotifyTweenInfo, { Position = UDim2.fromOffset(0, 0) })

    task.defer(function()
        if not Data.Destroyed then
            Library:UpdateNotificationPositions(true)
        end
    end)

    task.delay(Library.NotifyTweenInfo.Time, function()
        if Data.Persist then
            return
        elseif typeof(Data.Time) == "Instance" then
            repeat
                task.wait()
            until DeletedInstance or Data.Destroyed
        else
            local Duration = tonumber(Data.Time) or 5
            if not Data.Steps then
                Tween(TimerBar, TweenInfo.new(Duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })
            end
            task.wait(Duration)
        end

        Data:Destroy("timer")
    end)

    return Data
end

--// Addons (KeyPicker / ColorPicker) \\--
local SpecialKeys = {
    MB1 = Enum.UserInputType.MouseButton1,
    MB2 = Enum.UserInputType.MouseButton2,
    MB3 = Enum.UserInputType.MouseButton3,
}
local SpecialKeysInput = {
    [Enum.UserInputType.MouseButton1] = "MB1",
    [Enum.UserInputType.MouseButton2] = "MB2",
    [Enum.UserInputType.MouseButton3] = "MB3",
}
local ModifierKeys = {
    LAlt = Enum.KeyCode.LeftAlt,
    RAlt = Enum.KeyCode.RightAlt,
    LCtrl = Enum.KeyCode.LeftControl,
    RCtrl = Enum.KeyCode.RightControl,
    LShift = Enum.KeyCode.LeftShift,
    RShift = Enum.KeyCode.RightShift,
    Tab = Enum.KeyCode.Tab,
    CapsLock = Enum.KeyCode.CapsLock,
}
local ModifierKeysInput = {}
for Name, KeyCode in ModifierKeys do
    ModifierKeysInput[KeyCode] = Name
end

local PrettyKeyNames = {
    LeftShift = "LShift",
    RightShift = "RShift",
    LeftControl = "LCtrl",
    RightControl = "RCtrl",
    LeftAlt = "LAlt",
    RightAlt = "RAlt",
    LeftSuper = "LWin",
    RightSuper = "RWin",
    Return = "Enter",
    Backspace = "Bksp",
    Delete = "Del",
    Insert = "Ins",
    PageUp = "PgUp",
    PageDown = "PgDn",
    Escape = "Esc",
    Backquote = "`",
    Minus = "-",
    Equals = "=",
    LeftBracket = "[",
    RightBracket = "]",
    BackSlash = "\\",
    Semicolon = ";",
    Quote = "'",
    Comma = ",",
    Period = ".",
    Slash = "/",
    Space = "Space",
    Zero = "0",
    One = "1",
    Two = "2",
    Three = "3",
    Four = "4",
    Five = "5",
    Six = "6",
    Seven = "7",
    Eight = "8",
    Nine = "9",
    KeypadZero = "Num0",
    KeypadOne = "Num1",
    KeypadTwo = "Num2",
    KeypadThree = "Num3",
    KeypadFour = "Num4",
    KeypadFive = "Num5",
    KeypadSix = "Num6",
    KeypadSeven = "Num7",
    KeypadEight = "Num8",
    KeypadNine = "Num9",
}

local function PrettyKey(Display)
    Display = tostring(Display or "None")
    local Parts = Display:split(" + ")
    for Index, Part in Parts do
        Parts[Index] = PrettyKeyNames[Part] or Part
    end
    return table.concat(Parts, " + ")
end

local function IsModifierInput(Input)
    return Input.UserInputType == Enum.UserInputType.Keyboard and ModifierKeysInput[Input.KeyCode] ~= nil
end

local function GetActiveModifiers()
    local Active = {}
    for Name, KeyCode in ModifierKeys do
        if UserInputService:IsKeyDown(KeyCode) then
            table.insert(Active, Name)
        end
    end
    return Active
end

local function AreModifiersHeld(Required)
    if not (typeof(Required) == "table" and #Required > 0) then
        return true
    end
    local Active = GetActiveModifiers()
    for _, Name in Required do
        if not table.find(Active, Name) then
            return false
        end
    end
    return true
end

local function IsInputDown(Input)
    if not Input then
        return false
    end
    if SpecialKeysInput[Input.UserInputType] ~= nil then
        return UserInputService:IsMouseButtonPressed(Input.UserInputType) and not UserInputService:GetFocusedTextBox()
    elseif Input.UserInputType == Enum.UserInputType.Keyboard then
        return UserInputService:IsKeyDown(Input.KeyCode) and not UserInputService:GetFocusedTextBox()
    end
    return false
end

local function ConvertToInputModifiers(CurrentModifiers)
    local Result = {}
    for _, Name in CurrentModifiers do
        table.insert(Result, ModifierKeys[Name])
    end
    return Result
end

-- Accepts the short names ("LShift"), full KeyCode names ("LeftShift") and KeyCode EnumItems
local function VerifyModifiers(CurrentModifiers)
    if typeof(CurrentModifiers) ~= "table" then
        return {}
    end
    local Valid = {}
    for _, Modifier in CurrentModifiers do
        local Name
        if typeof(Modifier) == "EnumItem" then
            Name = ModifierKeysInput[Modifier]
        elseif typeof(Modifier) == "string" then
            if ModifierKeys[Modifier] then
                Name = Modifier
            else
                local Success, KeyCode = pcall(function()
                    return Enum.KeyCode[Modifier]
                end)
                Name = Success and ModifierKeysInput[KeyCode] or nil
            end
        end
        if Name and not table.find(Valid, Name) then
            table.insert(Valid, Name)
        end
    end
    return Valid
end

