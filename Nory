function Library:SetDPIScale(DPIScale)
    DPIScale = tonumber(DPIScale) or 100
    Library.DPIScale = DPIScale / 100
    Library.MinSize = Library.OriginalMinSize * Library.DPIScale

    for _, UIScale in Library.Scales do
        UIScale.Scale = Library.DPIScale - (tonumber(Library.ScalesOffset[UIScale]) or 0)
    end

    for _, Option in Options do
        if Option.Type == "Dropdown" and Option.RecalculateListSize then
            Option:RecalculateListSize()
        end
    end
    -- elements of the built-in theme page are kept out of Options (so scripts never see them)
    for _, Option in Library.InternalOptions do
        if Option.Type == "Dropdown" and Option.RecalculateListSize and not Option.Destroyed then
            Option:RecalculateListSize()
        end
    end

    for _, Notification in Library.Notifications do
        Notification:Resize()
    end

    if Library.UpdateNotificationPositions then
        Library:UpdateNotificationPositions(true)
    end
end

function Library:GiveSignal(Connection)
    local ConnectionType = typeof(Connection)
    if Connection and (ConnectionType == "RBXScriptConnection" or ConnectionType == "RBXScriptSignal") then
        table.insert(Library.Signals, Connection)
    end
    return Connection
end

-- Plain tables from templates are copied so two elements never share (and mutate) the same
-- default table, e.g. two dropdowns created without Values both calling :AddValues().
local function CopyTemplate(Template)
    if typeof(Template) ~= "table" or getmetatable(Template) ~= nil then
        return Template
    end
    local Copy = {}
    for Key, Value in Template do
        Copy[Key] = CopyTemplate(Value)
    end
    return Copy
end

function Library:Validate(Table, Template)
    if typeof(Table) ~= "table" then
        return CopyTemplate(Template)
    end

    for Key, Value in Template do
        if typeof(Key) == "number" then
            continue
        end

        if typeof(Value) == "table" then
            Table[Key] = Library:Validate(Table[Key], Value)
        elseif Table[Key] == nil then
            Table[Key] = Value
        end
    end

    return Table
end

function Library:GetBetterColor(Color, Add)
    Add = Add * (Library.IsLightTheme and -4 or 2)
    return Color3.fromRGB(
        math.clamp(Color.R * 255 + Add, 0, 255),
        math.clamp(Color.G * 255 + Add, 0, 255),
        math.clamp(Color.B * 255 + Add, 0, 255)
    )
end

function Library:GetLighterColor(Color)
    local H, S, V = Color:ToHSV()
    return Color3.fromHSV(H, math.max(0, S - 0.1), math.min(1, V + 0.1))
end

function Library:GetDarkerColor(Color)
    local H, S, V = Color:ToHSV()
    return Color3.fromHSV(H, S, V / 2)
end

function Library:GetKeyString(KeyCode)
    if KeyCode.EnumType == Enum.KeyCode and KeyCode.Value > 33 and KeyCode.Value < 127 then
        return string.char(KeyCode.Value)
    end
    return KeyCode.Name
end

function Library:GetTextBounds(Text, FontFace, Size, Width)
    local Scale = Library.DPIScale
    local Success, X, Y = pcall(function()
        local Params = Instance.new("GetTextBoundsParams")
        Params.Text = Text
        Params.RichText = true
        Params.Font = FontFace or Library.Scheme.Font
        Params.Size = Size * Scale
        Params.Width = Width and (Width * Scale) or (workspace.CurrentCamera.ViewportSize.X - 32)

        local Bounds = TextService:GetTextBoundsAsync(Params)
        return math.ceil(Bounds.X / Scale), math.ceil(Bounds.Y / Scale)
    end)

    if Success then
        return X, Y
    end

    local Plain = StripRichText(Text)
    return math.ceil(#Plain * Size * 0.52), Size
end

function Library:MouseIsOverFrame(Frame, Position)
    if not (Frame and Position) then
        return false
    end
    local AbsPos, AbsSize = Frame.AbsolutePosition, Frame.AbsoluteSize
    return Position.X >= AbsPos.X
        and Position.X <= AbsPos.X + AbsSize.X
        and Position.Y >= AbsPos.Y
        and Position.Y <= AbsPos.Y + AbsSize.Y
end

function Library:IsInsideFrame(ParentFrame, Frame)
    local GuiPos, GuiSize = Frame.AbsolutePosition, Frame.AbsoluteSize
    local FramePos, FrameSize = ParentFrame.AbsolutePosition, ParentFrame.AbsoluteSize

    return GuiPos.X >= FramePos.X
        and GuiPos.X + GuiSize.X <= FramePos.X + FrameSize.X
        and GuiPos.Y >= FramePos.Y
        and GuiPos.Y + GuiSize.Y <= FramePos.Y + FrameSize.Y
end

function Library:SafeCallback(Func, ...)
    if not (Func and typeof(Func) == "function") then
        return
    end

    local Result = table.pack(xpcall(Func, function(Error)
        task.defer(error, debug.traceback(tostring(Error), 2))
        if Library.NotifyOnError and Library.Notify then
            task.spawn(Library.Notify, Library, tostring(Error))
        end
        return Error
    end, ...))

    if not Result[1] then
        return nil
    end

    return table.unpack(Result, 2, Result.n)
end

--// Image manager (downloads custom assets through getcustomasset when available) \\--
local ImageManager = {}
do
    local Assets = {}

    local function EnsurePath(Path)
        if not (isfolder and makefolder) then
            return
        end
        local Segments = Path:split("/")
        table.remove(Segments, #Segments)
        local Current = ""
        for _, Segment in Segments do
            Current = Current == "" and Segment or (Current .. "/" .. Segment)
            local Ok, Exists = pcall(isfolder, Current)
            if not (Ok and Exists) then
                pcall(makefolder, Current)
            end
        end
    end

    function ImageManager.AddAsset(AssetName, RobloxAssetId, URL, ForceRedownload)
        if Assets[AssetName] ~= nil then
            error(string.format("Asset %q already exists", tostring(AssetName)))
        end

        Assets[AssetName] = {
            RobloxId = tonumber(RobloxAssetId) or 0,
            Path = string.format("Onyx/assets/%s", tostring(AssetName)),
            URL = URL,
            Id = nil,
        }

        ImageManager.DownloadAsset(AssetName, ForceRedownload)
    end

    function ImageManager.GetAsset(AssetName)
        local Data = Assets[AssetName]
        if not Data then
            return nil
        end
        if Data.Id then
            return Data.Id
        end

        local AssetId = string.format("rbxassetid://%s", tostring(Data.RobloxId))
        if getcustomasset then
            local Success, NewId = pcall(getcustomasset, Data.Path)
            if Success and NewId then
                AssetId = NewId
            end
        end

        Data.Id = AssetId
        return AssetId
    end

    function ImageManager.DownloadAsset(AssetName, ForceRedownload)
        if not (getcustomasset and writefile and isfile) then
            return false, "missing functions"
        end

        local Data = Assets[AssetName]
        if not Data or not Data.URL then
            return false, "unknown asset"
        end

        EnsurePath(Data.Path)

        local Ok, Exists = pcall(isfile, Data.Path)
        if ForceRedownload ~= true and Ok and Exists then
            return true, nil
        end

        Data.Id = nil
        return pcall(function()
            writefile(Data.Path, game:HttpGet(Data.URL))
        end)
    end
end
Library.ImageManager = ImageManager

--// Icons (lucide module, same format as lucide-roblox-direct) \\--
local IconModule = nil
local FetchIcons = false

local function IsValidCustomIcon(Icon)
    return typeof(Icon) == "string"
        and (Icon:match("^rbxasset://textures/") or Icon:match("roblox%.com/asset/%?id=") or Icon:match("^rbxthumb://type="))
end

local function IsCustomAssetIcon(Icon)
    return typeof(Icon) == "string"
        and (Icon:match("^content://") or Icon:match("^rbxasset://[^/]+/") or Icon:match("^rbxassetid://") or Icon:match("^https?://www%.roblox%.com/asset"))
end

function Library:GetIcon(IconName)
    if not FetchIcons or not IconModule or typeof(IconName) ~= "string" then
        return nil
    end

    local Success, Icon = pcall(IconModule.GetAsset, IconName)
    if not Success or not Icon then
        return nil
    end

    if IconModule.GetFontAsset then
        local FontSuccess, FontIcon = pcall(IconModule.GetFontAsset, IconName)
        if FontSuccess and FontIcon and FontIcon.FontFace and FontIcon.Text then
            local Merged = table.clone(Icon)
            Merged.FontFace = FontIcon.FontFace
            Merged.Text = FontIcon.Text
            return Merged
        end
    end

    return Icon
end

function Library:GetCustomIcon(IconName)
    if IconName == nil then
        return nil
    end

    if tonumber(IconName) then
        IconName = string.format("rbxassetid://%s", tostring(IconName))
    end

    if typeof(IconName) ~= "string" or Trim(IconName) == "" then
        return nil
    end

    if IsCustomAssetIcon(IconName) then
        return { Url = IconName, ImageRectOffset = Vector2.zero, ImageRectSize = Vector2.zero, Custom = true }
    elseif IsValidCustomIcon(IconName) then
        return { Url = IconName, ImageRectOffset = Vector2.zero, ImageRectSize = Vector2.zero, Custom = true }
    end

    return Library:GetIcon(IconName)
end

function Library:ApplyLucideIcon(ImageGui, Icon, Rotation)
    if not ImageGui or not Icon then
        return
    end
    if not (ImageGui:IsA("ImageLabel") or ImageGui:IsA("ImageButton")) then
        return
    end

    if Rotation then
        ImageGui.Rotation = Rotation
    end

    local Glyph = ImageGui:FindFirstChild("__OnyxGlyph")
    if Glyph then
        Glyph:Destroy()
    end

    local FontLabel = ImageGui:FindFirstChild("__IconFont")
    if Icon.FontFace and Icon.Text then
        if not FontLabel then
            FontLabel = Instance.new("TextLabel")
            FontLabel.Name = "__IconFont"
            FontLabel.BackgroundTransparency = 1
            FontLabel.BorderSizePixel = 0
            FontLabel.Size = UDim2.fromScale(1, 1)
            FontLabel.RichText = false
            FontLabel.TextScaled = false
            FontLabel.TextXAlignment = Enum.TextXAlignment.Center
            FontLabel.TextYAlignment = Enum.TextYAlignment.Center
            FontLabel.Parent = ImageGui

            local function SyncLabel()
                if FontLabel.Parent then
                    FontLabel.TextColor3 = ImageGui.ImageColor3
                    FontLabel.TextTransparency = ImageGui.ImageTransparency
                end
            end
            local function SyncSize()
                if FontLabel.Parent then
                    local Absolute = ImageGui.AbsoluteSize
                    local Side = math.min(Absolute.X, Absolute.Y) / math.max(Library.DPIScale, 0.01)
                    if Side <= 0 then
                        Side = math.min(ImageGui.Size.X.Offset, ImageGui.Size.Y.Offset)
                    end
                    FontLabel.TextSize = math.max(1, math.floor(Side + 0.5))
                end
            end

            ImageGui:GetPropertyChangedSignal("ImageColor3"):Connect(SyncLabel)
            ImageGui:GetPropertyChangedSignal("ImageTransparency"):Connect(SyncLabel)
            ImageGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(SyncSize)
            SyncLabel()
            SyncSize()
        end

        FontLabel.FontFace = Icon.FontFace
        FontLabel.Text = Icon.Text
        FontLabel.Visible = true
        ImageGui.Image = ""
        return
    end

    if FontLabel then
        FontLabel:Destroy()
    end

    ImageGui.Image = Icon.Url or ImageGui.Image
    ImageGui.ImageRectOffset = Icon.ImageRectOffset or Vector2.zero
    ImageGui.ImageRectSize = Icon.ImageRectSize or Vector2.zero
end

