            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 2,
            Size = UDim2.new(1, 0, 0, 0),
            Text = Info.Description,
            TextColor3 = Info.DescriptionColor or "FontColor",
            TextSize = 13.5,
            TextTransparency = Info.DescriptionColor and 0 or 0.35,
            TextWrapped = true,
            ZIndex = 2,
            Parent = Inner,
        })

        local DialogContainer = New("Frame", {
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder = 3,
            Size = UDim2.new(1, 0, 0, 0),
            Visible = false,
            ZIndex = 2,
            Parent = Inner,
        })
        New("UIListLayout", {
            Padding = UDim.new(0, 9),
            Parent = DialogContainer,
        })

        local ButtonsHolder = New("Frame", {
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder = 4,
            Size = UDim2.new(1, 0, 0, 0),
            ZIndex = 2,
            Parent = Inner,
        })
        New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            Padding = UDim.new(0, 8),
            Wraps = true,
            Parent = ButtonsHolder,
        })
        AddPadding(ButtonsHolder, 6, 0, 0, 0)

        local Dialog = {
            Destroyed = false,
            Elements = {},
            DependencyBoxes = {},
            Container = DialogContainer,
            OutsideClickDismiss = Info.OutsideClickDismiss,
            Frame = DialogFrame,
            Tab = Library.ActiveTab,
        }

        function Dialog:Resize()
            local HasElements = #Dialog.Elements > 0
            DialogContainer.Visible = HasElements
            ButtonsHolder.Visible = next(FooterButtonsList) ~= nil
        end

        function Dialog:SetTitle(Title)
            TitleLabel.Text = Title
        end

        function Dialog:SetDescription(Description)
            DescriptionLabel.Text = Description
        end

        function Dialog:Dismiss()
            if Dialog.Destroyed then
                return
            end
            Dialog.Destroyed = true

            if Library.ActiveDialog == Dialog then
                Library.ActiveDialog = nil
            end

            for _, Element in table.clone(Dialog.Elements) do
                if Element.Destroy then
                    Element:Destroy()
                end
            end

            Tween(DialogScale, Library.TweenInfo, { Scale = 0.95 })
            Tween(DialogOverlay, Library.TweenInfo, { BackgroundTransparency = 1 })
            local FadeTargets = {}
            for _, Descendant in DialogFrame:GetDescendants() do
                if Descendant:IsA("TextLabel") or Descendant:IsA("TextButton") then
                    table.insert(FadeTargets, Descendant)
                end
            end
            for _, Target in FadeTargets do
                Tween(Target, Library.TweenInfo, { TextTransparency = 1 })
            end
            Tween(DialogFrame, Library.TweenInfo, { BackgroundTransparency = 1 })

            task.delay(Library.TweenInfo.Time + 0.02, function()
                DialogOverlay:Destroy()
            end)

            if Library.Dialogues[Idx] == Dialog then
                Library.Dialogues[Idx] = nil
            end
        end

        DialogOverlay.MouseButton1Click:Connect(function()
            if Info.OutsideClickDismiss then
                Dialog:Dismiss()
            end
        end)

        function Dialog:RemoveFooterButton(ButtonIdx)
            if FooterButtonsList[ButtonIdx] then
                FooterButtonsList[ButtonIdx].Container:Destroy()
                FooterButtonsList[ButtonIdx] = nil
            end
            Dialog:Resize()
        end

        function Dialog:SetButtonDisabled(ButtonIdx, Disabled)
            if FooterButtonsList[ButtonIdx] then
                FooterButtonsList[ButtonIdx]:SetDisabled(Disabled)
            end
        end

        function Dialog:SetButtonOrder(ButtonIdx, ButtonOrder)
            if FooterButtonsList[ButtonIdx] then
                FooterButtonsList[ButtonIdx].Container.LayoutOrder = ButtonOrder
            end
        end

        function Dialog:AddFooterButton(ButtonIdx, ButtonInfo)
            Dialog:RemoveFooterButton(ButtonIdx)

            local WaitTime = tonumber(ButtonInfo.WaitTime) or 0
            local Variant = ButtonInfo.Variant or "Primary"

            local TextButton = New("TextButton", {
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = "MainColor",
                ClipsDescendants = true,
                LayoutOrder = ButtonInfo.Order or 0,
                Size = UDim2.fromOffset(0, 32),
                ZIndex = 2,
                Parent = ButtonsHolder,
            })
            AddCorner(TextButton, 0.7)
            AddPadding(TextButton, 0, 16, 0, 16)
            local Stroke = AddStroke(TextButton, "OutlineColor", 0)

            local Label = New("TextLabel", {
                AutomaticSize = Enum.AutomaticSize.X,
                FontFace = Fonts.SemiBold,
                Size = UDim2.fromScale(0, 1),
                Text = ButtonInfo.Title or tostring(ButtonIdx),
                TextSize = 13.5,
                TextXAlignment = Enum.TextXAlignment.Center,
                ZIndex = 2,
                Parent = TextButton,
            })

            local BaseColor, HoverColor = "MainColor", Palette.ControlHover
            if Variant == "Primary" then
                SetTheme(TextButton, "BackgroundColor3", "WhiteColor")
                AddAccentGradient(TextButton, 45)
                SetTheme(Label, "TextColor3", "WhiteColor")
                Stroke.Transparency = 1
                BaseColor, HoverColor = "WhiteColor", "WhiteColor"
            elseif Variant == "Destructive" then
                SetTheme(TextButton, "BackgroundColor3", "DestructiveColor")
                SetTheme(Label, "TextColor3", "WhiteColor")
                Stroke.Transparency = 1
                BaseColor = "DestructiveColor"
                HoverColor = function()
                    return Library.Scheme.DestructiveColor:Lerp(Library.Scheme.WhiteColor, 0.12)
                end
            elseif Variant == "Ghost" then
                TextButton.BackgroundTransparency = 1
                Stroke.Transparency = 1
            end

            local ButtonScale = New("UIScale", { Parent = TextButton })
            local IsActive = WaitTime <= 0

            local Progress
            if WaitTime > 0 then
                Progress = New("Frame", {
                    AnchorPoint = Vector2.new(0, 1),
                    BackgroundColor3 = "AccentColor",
                    Position = UDim2.new(0, -16, 1, 0),
                    Size = UDim2.new(0, 0, 0, 2),
                    ZIndex = 3,
                    Parent = TextButton,
                })
                Label.TextTransparency = 0.5
                TextButton.BackgroundTransparency = Variant == "Ghost" and 1 or 0.5
            end

            local ButtonWrap = {
                Container = TextButton,
            }

            function ButtonWrap:SetDisabled(Disabled)
                IsActive = not Disabled
                Tween(Label, Library.TweenInfo, { TextTransparency = Disabled and 0.5 or 0 })
                if Variant ~= "Ghost" then
                    Tween(TextButton, Library.TweenInfo, { BackgroundTransparency = Disabled and 0.5 or 0 })
                end
            end

            TextButton.MouseEnter:Connect(function()
                if not IsActive then
                    return
                end
                Tween(ButtonScale, Library.TweenInfo, { Scale = 1.03 })
                if Variant == "Ghost" then
                    Tween(TextButton, Library.TweenInfo, { BackgroundTransparency = 0 })
                elseif Variant ~= "Primary" then
                    TweenTheme(TextButton, "BackgroundColor3", HoverColor)
                end
            end)
            TextButton.MouseLeave:Connect(function()
                Tween(ButtonScale, Library.TweenInfo, { Scale = 1 })
                if Variant == "Ghost" then
                    Tween(TextButton, Library.TweenInfo, { BackgroundTransparency = 1 })
                elseif Variant ~= "Primary" then
                    TweenTheme(TextButton, "BackgroundColor3", BaseColor)
                end
            end)
            TextButton.MouseButton1Click:Connect(function()
                if not IsActive then
                    return
                end
                Ripple(TextButton)
                if ButtonInfo.Callback then
                    Library:SafeCallback(ButtonInfo.Callback, Dialog)
                end
                if Info.AutoDismiss then
                    Dialog:Dismiss()
                end
            end)

            if WaitTime > 0 then
                Tween(Progress, TweenInfo.new(WaitTime, Enum.EasingStyle.Linear), { Size = UDim2.new(1, 32, 0, 2) })
                task.delay(WaitTime, function()
                    if Dialog.Destroyed then
                        return
                    end
                    ButtonWrap:SetDisabled(false)
                    Tween(Progress, Library.TweenInfo, { BackgroundTransparency = 1 })
                end)
            end

            FooterButtonsList[ButtonIdx] = ButtonWrap
            Dialog:Resize()
        end

        for ButtonIdx, ButtonInfo in Info.FooterButtons do
            if typeof(ButtonIdx) == "number" and ButtonInfo.Id then
                ButtonIdx = ButtonInfo.Id
            end
            Dialog:AddFooterButton(ButtonIdx, ButtonInfo)
        end

        setmetatable(Dialog, BaseGroupbox)
        Library.Dialogues[Idx] = Dialog
        Dialog:Resize()

        --// elements added later should show the container
        local OriginalContainerChildAdded = DialogContainer.ChildAdded:Connect(function()
            task.defer(function()
                if not Dialog.Destroyed then
                    Dialog:Resize()
                end
            end)
        end)
        DialogOverlay.Destroying:Connect(function()
            OriginalContainerChildAdded:Disconnect()
        end)

        Library.ActiveDialog = Dialog
        return Dialog
    end

    --// Toggle (open / close) \\--
    local AnimationToken = 0
    local SavedShellPosition = nil

    local function FinishWindowAnimation()
        if Shell.Parent == WindowFader then
            Shell.Parent = ScreenGui
            if SavedShellPosition then
                Shell.Position = SavedShellPosition
            end
        end
        SavedShellPosition = nil
        WindowFader.Visible = false
    end

    local function AnimateWindow(Show)
        AnimationToken += 1
        local Token = AnimationToken

        FinishWindowAnimation()

        if not (Library.Animations and Library.Animations.ToggleWindow) then
            Shell.Visible = Show
            return
        end

        local Margin = 64
        local AbsPos, AbsSize = Shell.AbsolutePosition, Shell.AbsoluteSize

        WindowFader.Size = UDim2.fromOffset(AbsSize.X + Margin * 2, AbsSize.Y + Margin * 2)
        WindowFader.Position = UDim2.fromOffset(AbsPos.X + AbsSize.X / 2, AbsPos.Y + AbsSize.Y / 2)

        SavedShellPosition = Shell.Position
        Shell.Position = UDim2.fromOffset(Margin, Margin)
        Shell.Visible = true
        Shell.Parent = WindowFader
        WindowFader.Visible = true

        local Info = Library.WindowAnimationInfo
        if Show then
            WindowFader.GroupTransparency = 1
            FaderScale.Scale = 0.96
            Tween(WindowFader, Info, { GroupTransparency = 0 })
        else
            WindowFader.GroupTransparency = 0
            FaderScale.Scale = 1
            Tween(WindowFader, TweenInfo.new(Info.Time * 0.8, Info.EasingStyle, Info.EasingDirection), { GroupTransparency = 1 })
        end

        local ScaleTween = Tween(FaderScale, Show and Info or TweenInfo.new(Info.Time * 0.8, Info.EasingStyle, Info.EasingDirection), {
            Scale = Show and 1 or 0.96,
        })
        ScaleTween.Completed:Connect(function()
            if Token ~= AnimationToken then
                return
            end
            FinishWindowAnimation()
            Shell.Visible = Library.Toggled
        end)
    end

    local function RefreshFloatingBoxes()
        for _, Tab in Library.Tabs do
            if Tab.Groupboxes then
                for _, Groupbox in Tab.Groupboxes do
                    if Groupbox.RefreshPopOutVisibility then
                        Groupbox.RefreshPopOutVisibility()
                    end
                end
            end
            if Tab.Tabboxes then
                for _, Tabbox in Tab.Tabboxes do
                    if Tabbox.RefreshPopOutVisibility then
                        Tabbox.RefreshPopOutVisibility()
                    end
                end
            end
        end
    end

    function Window:Toggle(Value)
        if Library.Unloaded then
            return
        end

        if Library.ActiveLoading then
            if Value == true then
                return
            end
            if not Library.Toggled then
                return
            end
        end

        local NewState
        if typeof(Value) == "boolean" then
            NewState = Value
        else
            NewState = not Library.Toggled
        end

        if NewState == Library.Toggled and Shell.Visible == NewState and Shell.Parent ~= WindowFader then
            return
        end
        Library.Toggled = NewState

        AnimateWindow(Library.Toggled)
        RefreshFloatingBoxes()

        if Library.Toggled then
            RefreshKeyHint()
            MouseController:Open(WindowInfo.UnlockMouseWhileOpen)
        else
            RestoreMouseState()
            HideTooltip()

            --// first time the menu is hidden in a session, tell the user how to get it back
            if not Library.ToggleHintShown and WindowInfo.ShowToggleHint ~= false and not Library.Unloaded then
                Library.ToggleHintShown = true
                local Display = GetToggleKeyDisplay()
                if Library.IsMobile then
                    Library:Notify({ Title = "Menu hidden", Description = "Tap the Toggle button to open it again.", Icon = "eye-off", Time = 3.5 })
                elseif Display then
                    Library:Notify({ Title = "Menu hidden", Description = string.format("Press %s to open it again.", Display), Icon = "eye-off", Time = 3.5 })
                end
            end

            if SearchBox:IsFocused() then
                SearchBox:ReleaseFocus()
            end

            if CurrentMenu then
                CurrentMenu:Close()
            end
        end
    end

    function Library:Toggle(Value)
        return Window:Toggle(Value)
    end

    HideButton.MouseButton1Click:Connect(function()
        Window:Toggle(false)
    end)

    Window:SetAlwaysOnTop(WindowInfo.AlwaysOnTop)
    if WindowInfo.BackgroundImage and WindowInfo.BackgroundImage ~= "" then
        Window:SetBackgroundImage(tostring(WindowInfo.BackgroundImage))
    end

    if WindowInfo.EnableCompacting ~= false and WindowInfo.SidebarCompacted then
        Window:SetSidebarWidth(WindowInfo.SidebarCompactWidth, true)
    end

    --// Mobile toggle & lock buttons \\--
    if Library.IsMobile or WindowInfo.ShowMobileButtons == "Always" then
        local ToggleButton = Library:AddDraggableButton({
            Text = "Toggle",
            Icon = "menu",
            Func = function()
                Library:Toggle()
            end,
            ExcludeScaling = true,
        })

        local LockButton = Library:AddDraggableButton({
            Text = "Lock",
            Icon = "lock",
            Func = function(Self)
                Library.LockedDragging = not Library.LockedDragging
                Library.CantDragForced = Library.LockedDragging
                Self:SetText(Library.LockedDragging and "Unlock" or "Lock")
                Self:SetIcon(Library.LockedDragging and "lock-open" or "lock")
            end,
            ExcludeScaling = true,
        })

        local IsRight = WindowInfo.MobileButtonsSide == "Right"
        local Top = Watermark.Frame.Visible and 52 or 12
        ToggleButton.Button.AnchorPoint = Vector2.new(IsRight and 1 or 0, 0)
        LockButton.Button.AnchorPoint = Vector2.new(IsRight and 1 or 0, 0)
        ToggleButton.Button.Position = IsRight and UDim2.new(1, -12, 0, Top) or UDim2.fromOffset(12, Top)
        task.defer(function()
            local Width = ToggleButton.Button.AbsoluteSize.X
            LockButton.Button.Position = IsRight and UDim2.new(1, -(Width + 20), 0, Top) or UDim2.fromOffset(Width + 20, Top)
        end)

        if WindowInfo.ShowMobileButtons == false then
            ToggleButton.Button.Visible = false
            LockButton.Button.Visible = false
        end

        Window.MobileToggleButton = ToggleButton
        Window.MobileLockButton = LockButton
    end

    --// Input \\--
    Library:GiveSignal(SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        Library:UpdateSearch(SearchBox.Text)
    end))

    Library:GiveSignal(UserInputService.InputBegan:Connect(function(Input)
        if Library.Unloaded then
            return
        end

        if Input.KeyCode == Enum.KeyCode.Escape then
            local FocusedBox = UserInputService:GetFocusedTextBox()
            if FocusedBox then
                FocusedBox:ReleaseFocus()
                return
            end

            if Library.ActiveDialog and Library.ActiveDialog.OutsideClickDismiss ~= false then
                Library.ActiveDialog:Dismiss()
                return
            end

            if CurrentMenu then
                CurrentMenu:Close()
            end
            return
        end

        if UserInputService:GetFocusedTextBox() or Library.IsPicking then
            return
        end

        if typeof(Library.ToggleKeybind) == "EnumItem" and Input.KeyCode == Library.ToggleKeybind then
            Library:Toggle()
        end
    end))

    Library:GiveSignal(UserInputService.WindowFocused:Connect(function()
        Library.IsRobloxFocused = true
    end))
    Library:GiveSignal(UserInputService.WindowFocusReleased:Connect(function()
        Library.IsRobloxFocused = false
    end))

    Window.MainFrame = Shell
    Window.Header = Header
    Window.Holder = Main
    Window.Sidebar = Sidebar
    Window.Container = Body
    Window.DragController = DragController
    Library.Window = Window

    if WindowInfo.Settings ~= false and Library.SetupSettings then
        Library:SetupSettings(Window, WindowInfo, {
            Button = SettingsButton,
            SetActive = function(Active)
                SettingsButtonActive = Active == true
                RefreshSettingsButton(false)
            end,
        })
    end

    if WindowInfo.AutoShow and not Library.ActiveLoading then
        task.spawn(Library.Toggle, Library, true)
    end

    return Window
end

