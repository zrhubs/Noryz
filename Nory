    --// Tab transitions \\--
    local FaderContent = nil
    local FaderToken = 0
    local function FinishTabFade()
        if FaderContent then
            FaderContent.Parent = Body
            FaderContent.Position = UDim2.fromScale(0, 0)
            FaderContent = nil
        end
        TabFader.Visible = false
        TabFader.GroupTransparency = 0
    end

    local function PlayTabAnimation(Tab, Showing)
        local Container = Tab.Container
        if not Container then
            return
        end

        FaderToken += 1
        local Token = FaderToken

        if not Showing then
            if FaderContent == Container then
                FinishTabFade()
            end
            Container.Visible = false
            Container.Position = UDim2.fromScale(0, 0)
            return
        end

        FinishTabFade()

        if not (Library.Animations and Library.Animations.TabSwitch) or not Library.Toggled then
            Container.Visible = true
            Container.Position = UDim2.fromScale(0, 0)
            return
        end

        local Offset = Library.TabSwipeOffset or 12
        local From = tostring(Library.TabSwipeFrom or "bottom"):lower()
        local Start = UDim2.fromOffset(0, Offset)
        if From == "top" then
            Start = UDim2.fromOffset(0, -Offset)
        elseif From == "left" then
            Start = UDim2.fromOffset(-Offset, 0)
        elseif From == "right" then
            Start = UDim2.fromOffset(Offset, 0)
        elseif From == "auto" and Library.PreviousTab and Library.PreviousTab.Button and Tab.Button then
            Start = Tab.Button.LayoutOrder > Library.PreviousTab.Button.LayoutOrder and UDim2.fromOffset(0, Offset) or UDim2.fromOffset(0, -Offset)
        end

        FaderContent = Container
        Container.Parent = TabFader
        Container.Position = Start
        Container.Visible = true
        TabFader.GroupTransparency = 1
        TabFader.Visible = true

        local Info = Library.TabTransitionInfo
        Tween(TabFader, Info, { GroupTransparency = 0 })
        local Slide = Tween(Container, Info, { Position = UDim2.fromScale(0, 0) })
        Slide.Completed:Connect(function()
            if Token == FaderToken then
                FinishTabFade()
            end
        end)
    end

    function Library:PlayTabAnimation(Tab, Showing, OnComplete)
        PlayTabAnimation(Tab, Showing)
        if OnComplete then
            OnComplete()
        end
    end

