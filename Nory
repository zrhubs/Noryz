    -- Library.ToggleKeybind is a plain field that scripts reassign at any time (often after the window
    -- already exists, e.g. `Library.ToggleKeybind = Options.MenuKeybind`), so keep the hint in sync.
    --// The menu key is sunk through ContextActionService so the game does not also react to it
    --// (e.g. Roblox shift lock is bound to Shift by default and would toggle with RightShift).
    --// Our own listeners use UserInputService and still receive it.
    local SinkAction = "OnyxMenuKey" .. string.sub(tostring({}), 10)
    local SunkKey = nil
    local function UpdateMenuKeySink()
        local KeyCode = nil
        if WindowInfo.SinkMenuKey ~= false and not Library.Unloaded then
            local Bind = Library.ToggleKeybind
            if typeof(Bind) == "EnumItem" then
                if Bind.EnumType == Enum.KeyCode then
                    KeyCode = Bind
                end
            elseif typeof(Bind) == "table" and Bind.Type == "KeyPicker" and typeof(Bind.Value) == "string" then
                local Success, Item = pcall(function()
                    return Enum.KeyCode[Bind.Value]
                end)
                if Success and Item and Item ~= Enum.KeyCode.Unknown then
                    KeyCode = Item
                end
            end
        end

        if KeyCode == SunkKey then
            return
        end
        SunkKey = KeyCode
        pcall(function()
            ContextActionService:UnbindAction(SinkAction)
        end)
        if KeyCode then
            pcall(function()
                ContextActionService:BindActionAtPriority(SinkAction, function()
                    return Enum.ContextActionResult.Sink
                end, false, Enum.ContextActionPriority.High.Value + 50, KeyCode)
            end)
        end
    end
    Library:OnUnload(function()
        pcall(function()
            ContextActionService:UnbindAction(SinkAction)
        end)
    end)

