local function DrawGlyph(ImageGui, Kind, Thickness)
    local Shape = GlyphShapes[Kind]
    if not Shape then
        return
    end

    local Holder = Instance.new("Frame")
    Holder.Name = "__OnyxGlyph"
    Holder.BackgroundTransparency = 1
    Holder.BorderSizePixel = 0
    Holder.Size = UDim2.fromScale(1, 1)
    Holder.Parent = ImageGui

    local Bars = {}
    local Strokes = {}
    Thickness = Thickness or 2

    for _, Segment in ipairs(Shape) do
        local X1, Y1, X2, Y2 = Segment[1], Segment[2], Segment[3], Segment[4]
        local DX, DY = X2 - X1, Y2 - Y1
        local Length = math.sqrt(DX * DX + DY * DY)

        local Bar = Instance.new("Frame")
        Bar.AnchorPoint = Vector2.new(0.5, 0.5)
        Bar.BorderSizePixel = 0
        Bar.Position = UDim2.fromScale((X1 + X2) / 2, (Y1 + Y2) / 2)
        Bar.Size = UDim2.new(Length, Thickness, 0, Thickness)
        Bar.Rotation = math.deg(math.atan2(DY, DX))
        Bar.Parent = Holder

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(1, 0)
        Corner.Parent = Bar

        table.insert(Bars, Bar)
    end

    if Shape.Circle then
        local CX, CY, R = Shape.Circle[1], Shape.Circle[2], Shape.Circle[3]
        local Circle = Instance.new("Frame")
        Circle.AnchorPoint = Vector2.new(0.5, 0.5)
        Circle.BackgroundTransparency = 1
        Circle.BorderSizePixel = 0
        Circle.Position = UDim2.fromScale(CX, CY)
        Circle.Size = UDim2.fromScale(R * 2, R * 2)
        Circle.Parent = Holder

        local Corner = Instance.new("UICorner")
        Corner.CornerRadius = UDim.new(1, 0)
        Corner.Parent = Circle

        local Stroke = Instance.new("UIStroke")
        Stroke.Thickness = Thickness
        Stroke.Parent = Circle
        table.insert(Strokes, Stroke)
    end

    local function Sync()
        for _, Bar in Bars do
            Bar.BackgroundColor3 = ImageGui.ImageColor3
            Bar.BackgroundTransparency = ImageGui.ImageTransparency
        end
        for _, Stroke in Strokes do
            Stroke.Color = ImageGui.ImageColor3
            Stroke.Transparency = ImageGui.ImageTransparency
        end
    end

    ImageGui:GetPropertyChangedSignal("ImageColor3"):Connect(Sync)
    ImageGui:GetPropertyChangedSignal("ImageTransparency"):Connect(Sync)
    Sync()
end

--// Creates an icon ImageLabel. Uses lucide when available, falls back to a drawn glyph.
local function MakeIcon(IconName, Properties, Fallback)
    local Image = New("ImageLabel", Properties)
    local Icon = Library:GetCustomIcon(IconName)
    if Icon then
        Library:ApplyLucideIcon(Image, Icon)
        return Image, true, Icon
    end

    if Fallback ~= false then
        local Kind = typeof(Fallback) == "string" and Fallback or IconName
        if GlyphShapes[Kind] then
            DrawGlyph(Image, Kind)
            return Image, true, nil
        end
    end

    return Image, false, nil
end

local function SetIcon(Image, IconName, Fallback)
    local Icon = Library:GetCustomIcon(IconName)
    if Icon then
        Library:ApplyLucideIcon(Image, Icon)
        return true, Icon
    end

    Image.Image = ""
    local FontLabel = Image:FindFirstChild("__IconFont")
    if FontLabel then
        FontLabel:Destroy()
    end
    local Glyph = Image:FindFirstChild("__OnyxGlyph")
    if Glyph then
        Glyph:Destroy()
    end

    local Kind = typeof(Fallback) == "string" and Fallback or IconName
    if Fallback ~= false and typeof(Kind) == "string" and GlyphShapes[Kind] then
        DrawGlyph(Image, Kind)
        return true, nil
    end

    return false, nil
end

--// GUI parenting \\--
local function SafeParentUI(Object, Parent)
    local Success = pcall(function()
        if not Parent then
            Parent = CoreGui
        end
        Object.Parent = typeof(Parent) == "function" and Parent() or Parent
    end)

    if not (Success and Object.Parent) then
        Object.Parent = LocalPlayer:WaitForChild("PlayerGui", math.huge)
    end
end

local function ParentUI(UI, SkipHiddenUI)
    if SkipHiddenUI then
        SafeParentUI(UI, CoreGui)
        return
    end

    pcall(protectgui, UI)
    SafeParentUI(UI, gethui)
end

