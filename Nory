local function New(ClassName, Properties)
    local Object = Instance.new(ClassName)

    local Template = Defaults[ClassName]
    if Template then
        ApplyProperties(Object, Template)
    end
    if Properties then
        ApplyProperties(Object, Properties)
    end

    return Object
end

--// Sets a themed property (updates registry and value)
local function SetTheme(Object, Property, Value)
    local Registry = Library.Registry[Object]
    local IsTheme, Resolved = ResolveThemeValue(Value)
    if IsTheme then
        if not Registry then
            Registry = {}
            Library.Registry[Object] = Registry
        end
        Registry[Property] = Value
        Object[Property] = Resolved
    else
        if Registry then
            Registry[Property] = nil
        end
        Object[Property] = Value
    end
end

--// Tween a themed property while keeping the registry in sync
local function TweenTheme(Object, Property, Value, Info)
    local Registry = Library.Registry[Object]
    local IsTheme, Resolved = ResolveThemeValue(Value)
    if IsTheme then
        if not Registry then
            Registry = {}
            Library.Registry[Object] = Registry
        end
        Registry[Property] = Value
    else
        Resolved = Value
        if Registry then
            Registry[Property] = nil
        end
    end

    return Tween(Object, Info, { [Property] = Resolved })
end

local CornerFactors = setmetatable({}, { __mode = "k" })
local function AddCorner(Parent, Factor)
    if Factor == "full" then
        return New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Parent })
    end

    Factor = Factor or 1
    local Corner = New("UICorner", {
        CornerRadius = UDim.new(0, math.floor(Library.CornerRadius * Factor + 0.5)),
        Parent = Parent,
    })
    CornerFactors[Corner] = Factor
    table.insert(Library.Corners, Corner)
    return Corner
end

local function AddScale(Parent, Offset)
    local Scale = New("UIScale", {
        Scale = Library.DPIScale - (Offset or 0),
        Parent = Parent,
    })
    table.insert(Library.Scales, Scale)
    if Offset then
        Library.ScalesOffset[Scale] = Offset
    end
    return Scale
end

-- Product of every UIScale affecting a gui (its own and its ancestors'), used to convert
-- AbsoluteSize back into layout offsets regardless of DPI scale or running animations.
local function GetEffectiveScale(Gui)
    local Scale = 1
    local Current = Gui
    while Current and (Current:IsA("GuiObject") or Current:IsA("LayerCollector")) do
        local UIScale = Current:FindFirstChildOfClass("UIScale")
        if UIScale then
            Scale *= UIScale.Scale
        end
        Current = Current.Parent
    end
    return Scale
end

local function AddStroke(Parent, Color, Transparency, Thickness)
    return New("UIStroke", {
        Color = Color or "OutlineColor",
        Transparency = Transparency or 0,
        Thickness = Thickness or 1,
