--// Checkerboard (transparency preview) built from frames
local function MakeChecker(Parent, Width, Height, Cell)
    local Holder = New("Frame", {
        BackgroundColor3 = Color3.fromRGB(205, 205, 210),
        ClipsDescendants = true,
        Size = UDim2.fromScale(1, 1),
        Parent = Parent,
    })

    local Columns = math.ceil(Width / Cell)
    local Rows = math.ceil(Height / Cell)
    for Row = 0, Rows - 1 do
        for Column = 0, Columns - 1 do
            if (Row + Column) % 2 == 0 then
                local Square = Instance.new("Frame")
                Square.BackgroundColor3 = Color3.fromRGB(150, 150, 158)
                Square.BorderSizePixel = 0
                Square.Position = UDim2.fromOffset(Column * Cell, Row * Cell)
                Square.Size = UDim2.fromOffset(Cell, Cell)
                Square.Parent = Holder
            end
        end
    end

    return Holder
end

