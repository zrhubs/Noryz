        --// Config helpers \--
        local function FolderExists(Path)
            if not FileApi() then
                return false
            end
            local Ok, Exists = pcall(isfolder, Path)
            return Ok and Exists == true
        end

        local function ConfigNames()
            if not FileApi() then
                return {}
            end
            local Ok, List = pcall(SaveManager.RefreshConfigList, SaveManager)
            return (Ok and typeof(List) == "table") and List or {}
        end

        local function ConfigExists(Name)
            return table.find(ConfigNames(), Name) ~= nil
        end

        local function AutoloadName()
            if not FolderExists(SaveManager.Folder) then
                return nil
            end
            local Name, Ok = SaveManager:GetAutoloadConfig()
            return Ok and Name or nil
        end

        local function ConfigTimestamp(Name)
            local Path = FileApi() and SaveManager:GetConfigFilePath(Name)
            if not Path then
                return nil
            end
            local Ok, Content = pcall(readfile, Path)
            if not Ok then
                return nil
            end
            local Stamp = typeof(Content) == "string" and Content:match('"timestamp"%s*:%s*"([^"]+)"')
            if Stamp then
                -- "13.10.2026 15:42:07" -> "13.10.2026 15:42"
                return (Stamp:gsub("(%d+:%d+):%d+$", "%1"))
            end
            return nil
        end

        --// Fingerprint of every option, used by auto-save to detect changes cheaply
        local function Fingerprint()
            local Parts, Keys = {}, {}
            for Index in Library.Toggles do
                table.insert(Keys, "T" .. tostring(Index))
            end
            for Index in Library.Options do
                table.insert(Keys, "O" .. tostring(Index))
            end
            table.sort(Keys)
            for _, Key in Keys do
                local Object = Key:sub(1, 1) == "T" and Library.Toggles[Key:sub(2)] or Library.Options[Key:sub(2)]
                local Value = Object and Object.Value
                local Text
                if typeof(Value) == "table" then
                    local Items = {}
                    for Item, State in Value do
                        if State then
                            table.insert(Items, tostring(Item))
                        end
                    end
                    table.sort(Items)
                    Text = table.concat(Items, ",")
                elseif typeof(Value) == "Color3" then
                    Text = Value:ToHex() .. tostring(Object.Transparency)
                else
                    Text = tostring(Value)
                end
                if Object and Object.Type == "KeyPicker" then
                    Text ..= tostring(Object.Mode) .. table.concat(Object.Modifiers or {}, "+")
                end
                table.insert(Parts, Key .. "=" .. Text)
            end
            return table.concat(Parts, ";")
        end

        function Settings:AutoSaveNow(Force)
            if not ConfigSystem or Prefs.Data.AutoSave ~= true or not FileApi() or (Library.Unloaded and not Force) then
                return
            end
            local Print = Fingerprint()
            if Print == Settings.LastFingerprint then
                return
            end
            Settings.LastFingerprint = Print
            pcall(SaveManager.Save, SaveManager, AutoSaveName)
            if Settings.RefreshConfigs and Settings.Tab and Library.ActiveTab == Settings.Tab then
                Settings.RefreshConfigs()
            end
        end

