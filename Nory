            TextTransparency = 0.55,
            TextXAlignment = Enum.TextXAlignment.Center,
            Visible = false,
            Parent = MenuTable.Menu,
        })

        local Pool = {}
        local FilteredEntries = {}

        function Dropdown:RecalculateListSize(Count)
            local ItemCount = Count or #FilteredEntries
            local Visible = math.clamp(ItemCount, 1, Info.MaxVisibleDropdownItems)
            local Height = Visible * ItemHeight + (Visible - 1) * ItemGap + ListPadding * 2

            MenuTable:SetSize(function()
                return UDim2.fromOffset(DisplayContainer.AbsoluteSize.X / math.max(Library.DPIScale, 0.01), Height)
            end)
            MenuTable.Menu.ScrollBarThickness = ItemCount > Info.MaxVisibleDropdownItems and 3 or 0
