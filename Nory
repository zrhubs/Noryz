        local function DragLoop(Input, Step)
            while IsDragInput(Input) and not ColorPicker.Destroyed and ColorMenu.Active do
                Step()
                RunService.RenderStepped:Wait()
            end
        end

        table.insert(ColorPicker.Connections, SatVibMap.InputBegan:Connect(function(Input)
            if not IsClickInput(Input) then
                return
            end
            DragLoop(Input, function()
                local MinX, MaxX = SatVibMap.AbsolutePosition.X, SatVibMap.AbsolutePosition.X + SatVibMap.AbsoluteSize.X
                local MinY, MaxY = SatVibMap.AbsolutePosition.Y, SatVibMap.AbsolutePosition.Y + SatVibMap.AbsoluteSize.Y
                local X = math.clamp(Mouse.X, MinX, MaxX)
                local Y = math.clamp(Mouse.Y, MinY, MaxY)

                local OldSat, OldVib = ColorPicker.Sat, ColorPicker.Vib
                ColorPicker.Sat = (X - MinX) / math.max(MaxX - MinX, 1)
                ColorPicker.Vib = 1 - ((Y - MinY) / math.max(MaxY - MinY, 1))
                if ColorPicker.Sat ~= OldSat or ColorPicker.Vib ~= OldVib then
                    ColorPicker:Update()
                end
            end)
        end))

        table.insert(ColorPicker.Connections, HueSelector.InputBegan:Connect(function(Input)
            if not IsClickInput(Input) then
                return
            end
            DragLoop(Input, function()
                local Min = HueSelector.AbsolutePosition.Y
                local Max = Min + HueSelector.AbsoluteSize.Y
                local OldHue = ColorPicker.Hue
                ColorPicker.Hue = math.clamp((math.clamp(Mouse.Y, Min, Max) - Min) / math.max(Max - Min, 1), 0, 0.9999)
                if ColorPicker.Hue ~= OldHue then
                    ColorPicker:Update()
                end
            end)
        end))

        if TransparencySelector then
            table.insert(ColorPicker.Connections, TransparencySelector.InputBegan:Connect(function(Input)
                if not IsClickInput(Input) then
                    return
                end
                DragLoop(Input, function()
                    local Min = TransparencySelector.AbsolutePosition.Y
                    local Max = Min + TransparencySelector.AbsoluteSize.Y
                    local Old = ColorPicker.Transparency
                    ColorPicker.Transparency = (math.clamp(Mouse.Y, Min, Max) - Min) / math.max(Max - Min, 1)
                    if ColorPicker.Transparency ~= Old then
                        ColorPicker:Update()
                    end
                end)
            end))
        end

        table.insert(ColorPicker.Connections, HueBox.FocusLost:Connect(function(Enter)
            if Enter then
                local Text = HueBox.Text:gsub("#", "")
                local Success, Color = pcall(Color3.fromHex, Text)
                if Success and typeof(Color) == "Color3" then
                    ColorPicker:SetHSVFromRGB(Color)
                end
            end
            ColorPicker:Update()
        end))

        table.insert(ColorPicker.Connections, RgbBox.FocusLost:Connect(function(Enter)
            if Enter then
                local R, G, B = RgbBox.Text:match("(%d+)[,%s]+(%d+)[,%s]+(%d+)")
                if R and G and B then
                    ColorPicker:SetHSVFromRGB(Color3.fromRGB(math.clamp(tonumber(R), 0, 255), math.clamp(tonumber(G), 0, 255), math.clamp(tonumber(B), 0, 255)))
                end
            end
            ColorPicker:Update()
        end))

        local CopyResetId, PasteResetId = 0, 0
        table.insert(ColorPicker.Connections, CopyButton.MouseButton1Click:Connect(function()
            Library.CopiedColor = { ColorPicker.Value, ColorPicker.Transparency }
            CopyResetId += 1
            local This = CopyResetId
            CopyButton.Text = "Copied!"
            task.delay(1, function()
                if not ColorPicker.Destroyed and This == CopyResetId then
                    CopyButton.Text = "Copy"
                end
            end)
        end))
        table.insert(ColorPicker.Connections, PasteButton.MouseButton1Click:Connect(function()
            PasteResetId += 1
            local This = PasteResetId
            if Library.CopiedColor then
                ColorPicker:SetValueRGB(Library.CopiedColor[1], Library.CopiedColor[2])
                PasteButton.Text = "Pasted!"
            else
                PasteButton.Text = "Empty"
            end
            task.delay(1, function()
                if not ColorPicker.Destroyed and This == PasteResetId then
                    PasteButton.Text = "Paste"
                end
            end)
        end))

        ColorPicker:Update()

        if not ParentObj.Addons then
            ParentObj.Addons = {}
        end
        table.insert(ParentObj.Addons, ColorPicker)

        ColorPicker.Default = ColorPicker.Value

        function ColorPicker:Destroy()
            ColorPicker.Destroyed = true
            for _, Connection in ColorPicker.Connections do
                Connection:Disconnect()
            end
            ColorMenu:Destroy()
            ContextMenu:Destroy()
            Holder:Destroy()

            if ParentObj and ParentObj.Addons then
                local Index = table.find(ParentObj.Addons, ColorPicker)
                if Index then
                    table.remove(ParentObj.Addons, Index)
                end
            end

            Options[Idx] = nil
        end

        ColorPicker.Holder = Holder
        Options[Idx] = ColorPicker

        if ParentObj.RefreshLayout then
            task.defer(ParentObj.RefreshLayout)
        end

        return self
    end

    BaseAddons.__index = Funcs
    BaseAddons.__namecall = function(_, Key, ...)
        return Funcs[Key](...)
    end
    BaseAddons.Funcs = Funcs
end

--// Groupbox elements \\--
local Builders = {}

local function RowLayout(Parent, Padding, Alignment)
    return New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Alignment or Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, Padding or 8),
        Parent = Parent,
    })
end

local function FlexFill(Object)
    return New("UIFlexItem", {
        FlexMode = Enum.UIFlexMode.Fill,
        Parent = Object,
    })
end

local function CreateAddonHolder(Parent, Order)
    local Holder = New("Frame", {
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        LayoutOrder = Order or 5,
        Size = UDim2.fromOffset(0, 20),
        Visible = false,
        Parent = Parent,
    })
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 6),
        Parent = Holder,
    })

    -- An empty holder would still take a UIListLayout padding slot and push the row out of
    -- alignment, so it only becomes visible once an addon (key picker / color picker) is added.
    local function Refresh()
        for _, Child in Holder:GetChildren() do
            if Child:IsA("GuiObject") then
                Holder.Visible = true
                return
            end
        end
        Holder.Visible = false
    end
    Holder.ChildAdded:Connect(Refresh)
    Holder.ChildRemoved:Connect(Refresh)

    return Holder
end

local function Ripple(Button)
    if not Button.ClipsDescendants then
        Button.ClipsDescendants = true
    end

    local Scale = math.max(Library.DPIScale, 0.01)
    local RelX = (Mouse.X - Button.AbsolutePosition.X) / Scale
    local RelY = (Mouse.Y - Button.AbsolutePosition.Y) / Scale
    local Max = math.max(Button.AbsoluteSize.X, Button.AbsoluteSize.Y) * 2.2 / Scale

    local Circle = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = "FontColor",
        BackgroundTransparency = 0.88,
        Position = UDim2.fromOffset(RelX, RelY),
        Size = UDim2.fromOffset(0, 0),
        ZIndex = 5,
        Parent = Button,
    })
    AddCorner(Circle, "full")

    Tween(Circle, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(Max, Max),
        BackgroundTransparency = 1,
    })
    task.delay(0.6, function()
        Circle:Destroy()
    end)
end

local BaseGroupbox = {}
do
    local Funcs = {}

    local function ElementHolder(Groupbox, Height, ClassName)
        return New(ClassName or "Frame", {
            BackgroundTransparency = 1,
            LayoutOrder = NextOrder(),
            Size = UDim2.new(1, 0, 0, Height),
            Parent = Groupbox.Container,
        })
    end

    local function RemoveElement(Groupbox, Element)
        local Index = table.find(Groupbox.Elements, Element)
        if Index then
            table.remove(Groupbox.Elements, Index)
        end
        Groupbox:Resize()
    end

    --// Divider \\--
    function Funcs:AddDivider(...)
        if self.Destroyed then
            return nil
        end

        local Params = select(1, ...)
        local Text, MarginTop, MarginBottom = nil, 0, 0
        if typeof(Params) == "table" then
            Text = Params.Text
            MarginTop = Params.MarginTop or Params.Margin or 0
            MarginBottom = Params.MarginBottom or Params.Margin or 0
        elseif typeof(Params) == "string" then
            Text = Params
        end

        local Groupbox = self
        local Holder = ElementHolder(Groupbox, (Text and 16 or 9) + MarginTop + MarginBottom)

        local Inner = New("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, MarginTop),
            Size = UDim2.new(1, 0, 1, -(MarginTop + MarginBottom)),
            Parent = Holder,
        })

        if Text then
            RowLayout(Inner, 10)
            local LeftLine = New("Frame", {
                BackgroundColor3 = "OutlineColor",
                LayoutOrder = 1,
                Size = UDim2.new(0, 0, 0, 1),
                Parent = Inner,
            })
            FlexFill(LeftLine)
            New("TextLabel", {
                AutomaticSize = Enum.AutomaticSize.X,
                FontFace = Fonts.Medium,
                LayoutOrder = 2,
                Size = UDim2.fromScale(0, 1),
                Text = Text,
                TextSize = 12.5,
                TextTransparency = 0.5,
                Parent = Inner,
            })
            local RightLine = New("Frame", {
                BackgroundColor3 = "OutlineColor",
                LayoutOrder = 3,
                Size = UDim2.new(0, 0, 0, 1),
                Parent = Inner,
            })
            FlexFill(RightLine)
        else
            New("Frame", {
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = "OutlineColor",
                Position = UDim2.fromScale(0, 0.5),
                Size = UDim2.new(1, 0, 0, 1),
                Parent = Inner,
            })
        end

        local Divider = {
            Connections = {},
            Destroyed = false,
            Holder = Holder,
            Text = Text,
            MarginTop = MarginTop,
            MarginBottom = MarginBottom,
            Visible = true,
            Type = "Divider",
            Parent = Groupbox,
        }

        function Divider:SetVisible(Value)
            Divider.Visible = Value == true
            Holder.Visible = Divider.Visible
            Groupbox:Resize()
        end

        function Divider:Destroy()
            Divider.Destroyed = true
            Holder:Destroy()
            RemoveElement(Groupbox, Divider)
        end

        table.insert(Groupbox.Elements, Divider)
        Groupbox:Resize()
        return Divider
    end

    --// Label \\--
    function Funcs:AddLabel(...)
        if self.Destroyed then
            return nil
        end

        local Data = {}
        local First, Second = select(1, ...), select(2, ...)
        if typeof(First) == "table" or typeof(Second) == "table" then
            local Params = typeof(First) == "table" and First or Second
            Data.Text = Params.Text or ""
            Data.DoesWrap = Params.DoesWrap or false
            Data.Size = Params.Size or 14
            Data.Visible = typeof(Params.Visible) == "boolean" and Params.Visible or (Params.Visible == nil)
            Data.Idx = typeof(Second) == "table" and First or Params.Idx
        else
            Data.Text = First or ""
            Data.DoesWrap = Second or false
            Data.Size = 14
            Data.Visible = true
            Data.Idx = select(3, ...)
        end

        local Groupbox = self
        local IsKeyTab = Groupbox.IsKeyTab == true

        local Label = {
            Connections = {},
            Destroyed = false,

            Text = tostring(Data.Text),
            DoesWrap = Data.DoesWrap,
            Addons = {},
            Visible = Data.Visible,
            Type = "Label",
            Parent = Groupbox,
        }

        local LineHeight = math.max(18, Data.Size + 4)
        local Holder = New("Frame", {
            BackgroundTransparency = 1,
            LayoutOrder = NextOrder(),
            Size = UDim2.new(1, 0, 0, LineHeight),
            Visible = Label.Visible,
            Parent = Groupbox.Container,
        })
        RowLayout(Holder, 8, Label.DoesWrap and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Center)

        local TextLabel = New("TextLabel", {
            LayoutOrder = 1,
            Size = UDim2.fromScale(0, 1),
            Text = Label.Text,
            TextSize = Data.Size,
            TextTransparency = 0.12,
            TextTruncate = Label.DoesWrap and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
            TextWrapped = Label.DoesWrap,
            TextXAlignment = IsKeyTab and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
            TextYAlignment = Label.DoesWrap and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
            Parent = Holder,
        })
        FlexFill(TextLabel)

        local AddonHolder = CreateAddonHolder(Holder, 2)

        -- Wrapped labels are measured explicitly (like the original library) instead of relying on
        -- AutomaticSize inside a flex row, which Roblox resolves inconsistently across frames.
        local LastWidth
        function Label:Display()
            if not Label.DoesWrap or Label.Destroyed then
                return
            end

            local Scale = GetEffectiveScale(TextLabel)
            local Width = TextLabel.AbsoluteSize.X / math.max(Scale, 0.01)
            if Width <= 1 then
                return
            end

            local _, Y = Library:GetTextBounds(TextLabel.Text, TextLabel.FontFace, TextLabel.TextSize, Width)
            local Height = math.max(LineHeight, math.ceil(Y) + 4)
            if Holder.Size.Y.Offset ~= Height then
                Holder.Size = UDim2.new(1, 0, 0, Height)
                Groupbox:Resize()
            end
        end

        if Label.DoesWrap then
            table.insert(Label.Connections, TextLabel:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                local Scale = GetEffectiveScale(TextLabel)
                local Width = math.floor(TextLabel.AbsoluteSize.X / math.max(Scale, 0.01) + 0.5)
                if Width == LastWidth then
                    return
                end
                LastWidth = Width
                Label:Display()
            end))
            task.defer(function()
                Label:Display()
            end)
        end

        function Label:SetVisible(Visible)
            Label.Visible = Visible == true
            Holder.Visible = Label.Visible
            Groupbox:Resize()
        end

        function Label:SetText(Text)
            Label.Text = tostring(Text)
            TextLabel.Text = Label.Text
            Label:Display()
            Groupbox:Resize()
        end

        function Label:Destroy()
            Label.Destroyed = true
            for _, Connection in Label.Connections do
                Connection:Disconnect()
            end
            for Index = #Label.Addons, 1, -1 do
                local Addon = table.remove(Label.Addons, Index)
                if Addon and Addon.Destroy then
                    Addon:Destroy()
                end
            end
            Holder:Destroy()
            RemoveElement(Groupbox, Label)

            if Data.Idx then
                Labels[Data.Idx] = nil
            else
                local Index = table.find(Labels, Label)
                if Index then
                    table.remove(Labels, Index)
                end
            end
        end

        Label.TextLabel = TextLabel
        Label.Container = Groupbox.Container
        Label.Holder = Holder
        Label.AddonHolder = AddonHolder
        setmetatable(Label, BaseAddons)

        table.insert(Groupbox.Elements, Label)
        if Data.Idx then
            Labels[Data.Idx] = Label
        else
            table.insert(Labels, Label)
        end

        Groupbox:Resize()
        return Label
    end

    --// Button \\--
    function Funcs:AddButton(...)
        if self.Destroyed then
            return nil
        end

        local function GetInfo(...)
            local Info = {}
            local First, Second = select(1, ...), select(2, ...)

            if typeof(First) == "table" or typeof(Second) == "table" then
                local Params = typeof(First) == "table" and First or Second
                Info.Text = Params.Text or ""
                Info.Func = Params.Func or Params.Callback or function() end
                Info.DoubleClick = Params.DoubleClick
                Info.Icon = Params.Icon or Params.IconName
                Info.Tooltip = Params.Tooltip
                Info.DisabledTooltip = Params.DisabledTooltip
                Info.Risky = Params.Risky or false
                Info.Disabled = Params.Disabled or false
                Info.Visible = typeof(Params.Visible) == "boolean" and Params.Visible or (Params.Visible == nil)
                Info.Idx = typeof(Second) == "table" and First or Params.Idx
            else
                Info.Text = First or ""
                Info.Func = Second or function() end
                Info.DoubleClick = false
                Info.Icon = nil
                Info.Tooltip = nil
                Info.DisabledTooltip = nil
                Info.Risky = false
                Info.Disabled = false
                Info.Visible = true
                Info.Idx = select(3, ...)
            end

            return Info
        end

        local Info = GetInfo(...)
        local Groupbox = self

        local Holder = ElementHolder(Groupbox, 30)
        RowLayout(Holder, 6)

        local AddonHolder = CreateAddonHolder(Holder, 1e7) -- after the button(s)
        AddonHolder.Size = UDim2.fromOffset(0, 30)

        local function CreateButton(Button)
            local Base = New("TextButton", {
                Active = not Button.Disabled,
                BackgroundColor3 = "MainColor",
                ClipsDescendants = true,
                LayoutOrder = NextOrder(),
                Size = UDim2.fromScale(0, 1),
                Visible = Button.Visible,
                Parent = Holder,
            })
            FlexFill(Base)
            AddCorner(Base, 0.6)
            local Stroke = AddStroke(Base, "OutlineColor", 0)

            local Content = New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(0, 16),
                Parent = Base,
            })
            New("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                HorizontalAlignment = Enum.HorizontalAlignment.Center,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                Padding = UDim.new(0, 7),
                Parent = Content,
            })

            Button.Content = Content
            Button.Label = New("TextLabel", {
                AutomaticSize = Enum.AutomaticSize.X,
                FontFace = Fonts.Medium,
                LayoutOrder = 1,
                Size = UDim2.fromOffset(0, 16),
                Text = Button.Text,
                TextColor3 = Button.Risky and "RedColor" or "FontColor",
                TextSize = 13.5,
                TextTransparency = 0.12,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = Content,
            })
            New("UISizeConstraint", { MaxSize = Vector2.new(260, 16), Parent = Button.Label })

            return Base, Stroke
        end

        local function ApplyButtonIcon(Button, IconName)
            local Icon = Library:GetCustomIcon(IconName)
            if Icon then
                if not Button.IconImage then
                    Button.IconImage = New("ImageLabel", {
                        ImageColor3 = Button.Risky and "RedColor" or (Icon.Custom and "WhiteColor" or "FontColor"),
                        LayoutOrder = 0,
                        Size = UDim2.fromOffset(14, 14),
                        Parent = Button.Content,
                    })
                end
                Button.IconImage.Visible = true
                Library:ApplyLucideIcon(Button.IconImage, Icon)
            elseif Button.IconImage then
                Button.IconImage.Visible = false
            end
        end

        local function UpdateColors(Button)
            if Library.Unloaded then
                return
            end
            StopTween(Button.Tween)
            SetTheme(Button.Base, "BackgroundColor3", Button.Disabled and "BackgroundColor" or "MainColor")
            Button.Label.TextTransparency = Button.Disabled and 0.65 or 0.12
            Button.Stroke.Transparency = Button.Disabled and 0.5 or 0
            SetTheme(Button.Stroke, "Color", "OutlineColor")
            if Button.IconImage then
                Button.IconImage.ImageTransparency = Button.Disabled and 0.65 or 0.12
            end
        end

        local function InitEvents(Button)
            local Hovering = false

            table.insert(Button.Connections, Button.Base.MouseEnter:Connect(function()
                Hovering = true
                if Button.Disabled then
                    return
                end
                Button.Tween = TweenTheme(Button.Base, "BackgroundColor3", Palette.ControlHover)
                TweenTheme(Button.Stroke, "Color", Palette.OutlineHover)
                Tween(Button.Label, Library.TweenInfo, { TextTransparency = 0 })
                if Button.IconImage then
                    Tween(Button.IconImage, Library.TweenInfo, { ImageTransparency = 0 })
                end
            end))

            table.insert(Button.Connections, Button.Base.MouseLeave:Connect(function()
                Hovering = false
                if Button.Disabled then
                    return
                end
                Button.Tween = TweenTheme(Button.Base, "BackgroundColor3", "MainColor")
                TweenTheme(Button.Stroke, "Color", "OutlineColor")
                Tween(Button.Label, Library.TweenInfo, { TextTransparency = 0.12 })
                if Button.IconImage then
                    Tween(Button.IconImage, Library.TweenInfo, { ImageTransparency = 0.12 })
                end
            end))

            table.insert(Button.Connections, Button.Base.MouseButton1Down:Connect(function()
                if Button.Disabled then
                    return
                end
                TweenTheme(Button.Stroke, "Color", "AccentColor")
                Ripple(Button.Base)
            end))

            table.insert(Button.Connections, Button.Base.MouseButton1Up:Connect(function()
                if Button.Disabled then
                    return
                end
                TweenTheme(Button.Stroke, "Color", Hovering and Palette.OutlineHover or "OutlineColor")
            end))

            table.insert(Button.Connections, Button.Base.MouseButton1Click:Connect(function()
                if Button.Disabled or Button.Locked then
                    return
                end

                if Button.DoubleClick then
                    Button.Locked = true

                    local IconWasVisible = Button.IconImage and Button.IconImage.Visible
                    if Button.IconImage then
                        Button.IconImage.Visible = false
                    end

                    Button.Label.Text = "Click again to confirm"
                    SetTheme(Button.Label, "TextColor3", "AccentColor")
                    TweenTheme(Button.Stroke, "Color", "AccentColor")

                    local Clicked = WaitForEvent(Button.Base.MouseButton1Click, 0.75)

                    Button.Label.Text = Button.Text
                    SetTheme(Button.Label, "TextColor3", Button.Risky and "RedColor" or "FontColor")
                    TweenTheme(Button.Stroke, "Color", Hovering and Palette.OutlineHover or "OutlineColor")
                    if Button.IconImage then
                        Button.IconImage.Visible = IconWasVisible
                    end

                    if Clicked then
                        Library:SafeCallback(Button.Func)
                    end

                    RunService.RenderStepped:Wait()
                    Button.Locked = false
                    return
                end

                Library:SafeCallback(Button.Func)
            end))
        end

        local Button = {
            Connections = {},
            Destroyed = false,

            Text = Info.Text,
            Func = Info.Func,
            DoubleClick = Info.DoubleClick,
            Icon = Info.Icon,

            Tooltip = Info.Tooltip,
            DisabledTooltip = Info.DisabledTooltip,
            TooltipTable = nil,

            Risky = Info.Risky,
            Disabled = Info.Disabled,
            Visible = Info.Visible,
            Locked = false,

            Addons = {},
            Type = "Button",
            Parent = Groupbox,
        }

        Button.Base, Button.Stroke = CreateButton(Button)
        ApplyButtonIcon(Button, Button.Icon)
        InitEvents(Button)
        Button.AddonHolder = AddonHolder
        Button.TextLabel = Button.Label

        function Button:AddButton(...)
            local SubInfo = GetInfo(...)

            local SubButton = {
                Connections = {},
                Destroyed = false,

                Text = SubInfo.Text,
                Func = SubInfo.Func,
                DoubleClick = SubInfo.DoubleClick,
                Icon = SubInfo.Icon,

                Tooltip = SubInfo.Tooltip,
                DisabledTooltip = SubInfo.DisabledTooltip,
                TooltipTable = nil,

                Risky = SubInfo.Risky,
                Disabled = SubInfo.Disabled,
                Visible = SubInfo.Visible,
                Locked = false,

                Addons = {},
                Type = "SubButton",
                Parent = Groupbox,
            }

            Button.SubButton = SubButton
            SubButton.Base, SubButton.Stroke = CreateButton(SubButton)
            ApplyButtonIcon(SubButton, SubButton.Icon)
            InitEvents(SubButton)
            SubButton.AddonHolder = AddonHolder
            SubButton.TextLabel = SubButton.Label

            function SubButton:UpdateColors()
                UpdateColors(SubButton)
            end

            function SubButton:SetDisabled(Disabled)
                SubButton.Disabled = Disabled
                if SubButton.TooltipTable then
                    SubButton.TooltipTable.Disabled = Disabled
                end
                SubButton.Base.Active = not Disabled
                SubButton:UpdateColors()
                Library:UpdateAddons(SubButton)
            end

            function SubButton:SetVisible(Visible)
                SubButton.Visible = Visible
                SubButton.Base.Visible = Visible
                Groupbox:Resize()
            end

            function SubButton:SetText(Text)
                SubButton.Text = Text
                SubButton.Label.Text = Text
            end

            function SubButton:SetIcon(Icon)
                SubButton.Icon = Icon
                ApplyButtonIcon(SubButton, Icon)
            end

            if typeof(SubButton.Tooltip) == "string" or typeof(SubButton.DisabledTooltip) == "string" then
                SubButton.TooltipTable = Library:AddTooltip(SubButton.Tooltip, SubButton.DisabledTooltip, SubButton.Base)
                SubButton.TooltipTable.Disabled = SubButton.Disabled
            end

            SubButton:UpdateColors()

            if SubInfo.Idx then
                Buttons[SubInfo.Idx] = SubButton
            else
                table.insert(Buttons, SubButton)
            end

            SubButton.AddKeyPicker = BaseAddons.Funcs.AddKeyPicker

            function SubButton:Destroy()
                SubButton.Destroyed = true
                for _, Connection in SubButton.Connections do
                    Connection:Disconnect()
                end
                if SubButton.TooltipTable then
                    SubButton.TooltipTable:Destroy()
                end
                for Index = #SubButton.Addons, 1, -1 do
                    local Addon = table.remove(SubButton.Addons, Index)
                    if Addon and Addon.Destroy then
                        Addon:Destroy()
                    end
                end
                SubButton.Base:Destroy()
                Button.SubButton = nil

                if SubInfo.Idx then
                    Buttons[SubInfo.Idx] = nil
                else
                    local Index = table.find(Buttons, SubButton)
                    if Index then
                        table.remove(Buttons, Index)
                    end
                end
            end

            return SubButton
        end

        function Button:UpdateColors()
            UpdateColors(Button)
        end

        function Button:SetDisabled(Disabled)
            Button.Disabled = Disabled
            if Button.TooltipTable then
                Button.TooltipTable.Disabled = Disabled
            end
            Button.Base.Active = not Disabled
            Button:UpdateColors()
            Library:UpdateAddons(Button)
        end

        function Button:SetVisible(Visible)
            Button.Visible = Visible
            Holder.Visible = Visible
            Groupbox:Resize()
        end

        function Button:SetText(Text)
            Button.Text = Text
            Button.Label.Text = Text
        end

        function Button:SetIcon(Icon)
            Button.Icon = Icon
            ApplyButtonIcon(Button, Icon)
        end

        if typeof(Button.Tooltip) == "string" or typeof(Button.DisabledTooltip) == "string" then
            Button.TooltipTable = Library:AddTooltip(Button.Tooltip, Button.DisabledTooltip, Button.Base)
            Button.TooltipTable.Disabled = Button.Disabled
        end

        Button:UpdateColors()
        Holder.Visible = Button.Visible
        Button.Base.Visible = true

        Button.Holder = Holder
        table.insert(Groupbox.Elements, Button)

        if Info.Idx then
            Buttons[Info.Idx] = Button
        else
            table.insert(Buttons, Button)
        end

        Button.AddKeyPicker = BaseAddons.Funcs.AddKeyPicker

        function Button:Destroy()
            Button.Destroyed = true
            for _, Connection in Button.Connections do
                Connection:Disconnect()
            end
            if Button.TooltipTable then
                Button.TooltipTable:Destroy()
            end
            for Index = #Button.Addons, 1, -1 do
                local Addon = table.remove(Button.Addons, Index)
                if Addon and Addon.Destroy then
                    Addon:Destroy()
                end
            end
            if Button.SubButton then
                Button.SubButton:Destroy()
            end
            Holder:Destroy()
            RemoveElement(Groupbox, Button)

            if Info.Idx then
                Buttons[Info.Idx] = nil
            else
                local Index = table.find(Buttons, Button)
                if Index then
                    table.remove(Buttons, Index)
                end
            end
        end

        Groupbox:Resize()
        return Button
    end

    --// Shared toggle builder (switch + checkbox variants) \\--
    local function BuildToggle(Groupbox, Idx, Info, Variant)
        local Toggle = {
            Connections = {},
            Destroyed = false,

            Text = Info.Text,
            Value = Info.Default == true,

            Tooltip = Info.Tooltip,
            DisabledTooltip = Info.DisabledTooltip,
            TooltipTable = nil,

            Callback = Info.Callback,
            Changed = Info.Changed,

            Risky = Info.Risky,
            Disabled = Info.Disabled,
            Visible = Info.Visible,

            Addons = {},
            AnyKeyPickerPicking = false,

            Variant = Variant,
            Type = "Toggle",
            Parent = Groupbox,
        }

        local Button = ElementHolder(Groupbox, 22, "TextButton")
        Button.Active = not Toggle.Disabled
        Button.Visible = Toggle.Visible
        RowLayout(Button, 9)

        local Label = New("TextLabel", {
            LayoutOrder = Variant == "Checkbox" and 2 or 1,
            Size = UDim2.fromScale(0, 1),
            Text = Toggle.Text,
            TextColor3 = Toggle.Risky and "RedColor" or "FontColor",
            TextSize = 14,
            TextTransparency = 0.28,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = Button,
        })
        FlexFill(Label)

        local AddonHolder = CreateAddonHolder(Button, Variant == "Checkbox" and 3 or 2)

        local Visual = {}
        if Variant == "Checkbox" then
            local Box = New("Frame", {
                BackgroundColor3 = "MainColor",
                LayoutOrder = 1,
                Size = UDim2.fromOffset(17, 17),
                Parent = Button,
            })
            AddCorner(Box, 0.45)
            local BoxStroke = AddStroke(Box, "OutlineColor", 0)

            local Fill = New("Frame", {
                BackgroundColor3 = "WhiteColor",
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Parent = Box,
            })
            AddCorner(Fill, 0.45)
            AddAccentGradient(Fill, 45)

            local Check = MakeIcon("check", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                ImageColor3 = "WhiteColor",
                ImageTransparency = 1,
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(8, 8),
                ZIndex = 2,
                Parent = Box,
            })

            function Visual.Apply(Value, Disabled, Hovering, Instant)
                local Info = Instant and TweenInfo.new(0) or Library.TweenInfo
                Tween(Fill, Info, { BackgroundTransparency = Value and (Disabled and 0.55 or 0) or 1 })
                Tween(Check, Instant and Info or Library.SmoothTweenInfo, {
                    ImageTransparency = Value and (Disabled and 0.5 or 0) or 1,
                    Size = Value and UDim2.fromOffset(11, 11) or UDim2.fromOffset(7, 7),
                })
                TweenTheme(BoxStroke, "Color", Value and "AccentColor" or (Hovering and Palette.OutlineHover or "OutlineColor"), Info)
                BoxStroke.Transparency = Disabled and 0.5 or 0
                SetTheme(Box, "BackgroundColor3", Disabled and "BackgroundColor" or "MainColor")
            end
        else
            local Track = New("Frame", {
                BackgroundColor3 = "MainColor",
                LayoutOrder = 3,
                Size = UDim2.fromOffset(34, 19),
                Parent = Button,
            })
            AddCorner(Track, "full")
            local TrackStroke = AddStroke(Track, "OutlineColor", 0)

            local Fill = New("Frame", {
                BackgroundColor3 = "WhiteColor",
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Parent = Track,
            })
            AddCorner(Fill, "full")
            AddAccentGradient(Fill, 0)

            local Knob = New("Frame", {
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = "FontColor",
                BackgroundTransparency = 0.45,
                Position = UDim2.new(0, 3, 0.5, 0),
                Size = UDim2.fromOffset(13, 13),
                ZIndex = 2,
                Parent = Track,
            })
            AddCorner(Knob, "full")

            function Visual.Apply(Value, Disabled, Hovering, Instant)
                local Info = Instant and TweenInfo.new(0) or Library.SmoothTweenInfo
                Tween(Fill, Instant and Info or Library.TweenInfo, { BackgroundTransparency = Value and (Disabled and 0.6 or 0) or 1 })
                Tween(Knob, Info, {
                    Position = Value and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                    BackgroundTransparency = Value and (Disabled and 0.4 or 0) or (Disabled and 0.75 or (Hovering and 0.25 or 0.45)),
                })
                SetTheme(Knob, "BackgroundColor3", Value and "WhiteColor" or "FontColor")
                TweenTheme(TrackStroke, "Color", Value and "AccentColor" or (Hovering and Palette.OutlineHover or "OutlineColor"), Library.TweenInfo)
                TrackStroke.Transparency = Disabled and 0.5 or 0
                SetTheme(Track, "BackgroundColor3", Disabled and "BackgroundColor" or "MainColor")
            end
        end

        local Hovering = false
        local Initialized = false

        function Toggle:UpdateColors()
            Toggle:Display()
        end

        function Toggle:Display()
            if Library.Unloaded then
                return
            end

            Visual.Apply(Toggle.Value, Toggle.Disabled, Hovering, not Initialized)
            Initialized = true

            local Transparency
            if Toggle.Disabled then
                Transparency = 0.65
            elseif Toggle.Value or Hovering then
                Transparency = 0
            else
                Transparency = 0.28
            end
            Tween(Label, Library.TweenInfo, { TextTransparency = Transparency })
        end

        function Toggle:OnChanged(Func)
            Toggle.Changed = Func
        end

        function Toggle:RunChanged()
            if Toggle.Disabled then
                return
            end
            Library:SafeCallback(Toggle.Callback, Toggle.Value)
            Library:SafeCallback(Toggle.Changed, Toggle.Value)
        end

        function Toggle:SetValue(Value)
            Toggle.Value = Value == true
            Toggle:Display()

            for _, Addon in Toggle.Addons do
                if Addon.Type == "KeyPicker" and Addon.SyncToggleState then
                    Addon.Toggled = Toggle.Value
                    Addon:Update()
                end
            end

            if not Toggle.Disabled then
                Library:UpdateDependencyBoxes()
            end

            if not Toggle.AnyKeyPickerPicking then
                Toggle:RunChanged()
            end
        end

        function Toggle:SetDisabled(Disabled)
            Toggle.Disabled = Disabled
            if Toggle.TooltipTable then
                Toggle.TooltipTable.Disabled = Disabled
            end
            Library:UpdateAddons(Toggle)
            Button.Active = not Disabled
            Toggle:Display()
            Library:UpdateDependencyBoxes()
        end

        function Toggle:SetVisible(Visible)
            Toggle.Visible = Visible
            Button.Visible = Visible
            Groupbox:Resize()
        end

        function Toggle:SetText(Text)
            Toggle.Text = Text
            Label.Text = Text
        end

        table.insert(Toggle.Connections, Button.MouseEnter:Connect(function()
            Hovering = true
            Toggle:Display()
        end))
        table.insert(Toggle.Connections, Button.MouseLeave:Connect(function()
            Hovering = false
            Toggle:Display()
        end))
        table.insert(Toggle.Connections, Button.MouseButton1Click:Connect(function()
            if Toggle.Disabled then
                return
            end
            Toggle:SetValue(not Toggle.Value)
        end))

        if typeof(Toggle.Tooltip) == "string" or typeof(Toggle.DisabledTooltip) == "string" then
            Toggle.TooltipTable = Library:AddTooltip(Toggle.Tooltip, Toggle.DisabledTooltip, Button)
            Toggle.TooltipTable.Disabled = Toggle.Disabled
        end

        Toggle:Display()

        Toggle.TextLabel = Label
        Toggle.Container = Groupbox.Container
        Toggle.Holder = Button
        Toggle.AddonHolder = AddonHolder
        setmetatable(Toggle, BaseAddons)

        table.insert(Groupbox.Elements, Toggle)
        Toggle.Default = Toggle.Value
        Toggles[Idx] = Toggle

        function Toggle:Destroy()
            Toggle.Destroyed = true
            for _, Connection in Toggle.Connections do
                Connection:Disconnect()
            end
            if Toggle.TooltipTable then
                Toggle.TooltipTable:Destroy()
            end
            for Index = #Toggle.Addons, 1, -1 do
                local Addon = table.remove(Toggle.Addons, Index)
                if Addon and Addon.Destroy then
                    Addon:Destroy()
                end
            end
            Button:Destroy()
            RemoveElement(Groupbox, Toggle)
            Toggles[Idx] = nil
        end

        Groupbox:Resize()
        return Toggle
    end

    function Funcs:AddCheckbox(Idx, Info)
        if self.Destroyed then
            return nil
        end
        Info = Library:Validate(Info, Templates.Toggle)
        return BuildToggle(self, Idx, Info, "Checkbox")
    end

    function Funcs:AddToggle(Idx, Info)
        if self.Destroyed then
            return nil
        end
        if Library.ForceCheckbox then
            return Funcs.AddCheckbox(self, Idx, Info)
        end
        Info = Library:Validate(Info, Templates.Toggle)
        return BuildToggle(self, Idx, Info, "Switch")
    end

    --// Input \\--
    function Funcs:AddInput(Idx, Info)
        if self.Destroyed then
            return nil
        end

        if typeof(Info) == "table" and typeof(Info.VerifyValue) == "function" and Info.Finished ~= true then
            Info.Finished = true
        end
        Info = Library:Validate(Info, Templates.Input)

        local Groupbox = self

        local Input = {
            Connections = {},
            Destroyed = false,

            Text = Info.Text,
            Value = tostring(Info.Default),

            Finished = Info.Finished,
            Numeric = Info.Numeric,
            ClearTextOnFocus = Info.ClearTextOnFocus,
            ClearTextOnBlur = Info.ClearTextOnBlur,
            Placeholder = Info.Placeholder,
            AllowEmpty = Info.AllowEmpty,
            EmptyReset = Info.EmptyReset,

            Tooltip = Info.Tooltip,
            DisabledTooltip = Info.DisabledTooltip,
            TooltipTable = nil,

            Callback = Info.Callback,
            Changed = Info.Changed,
            VerifyValue = Info.VerifyValue,

            Disabled = Info.Disabled,
            Visible = Info.Visible,

            Type = "Input",
            Parent = Groupbox,
        }

        local HasText = typeof(Input.Text) == "string" and Input.Text ~= ""
        local Holder = ElementHolder(Groupbox, HasText and 50 or 30)
        Holder.Visible = Input.Visible

        local Label = New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16),
            Text = Input.Text or "",
            TextSize = 14,
            TextTransparency = 0.12,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Visible = HasText,
            Parent = Holder,
        })

        local Field = New("Frame", {
            AnchorPoint = Vector2.new(0, 1),
            BackgroundColor3 = "MainColor",
            ClipsDescendants = true,
            Position = UDim2.fromScale(0, 1),
            Size = UDim2.new(1, 0, 0, 29),
            Parent = Holder,
        })
        AddCorner(Field, 0.6)
        local FieldStroke = AddStroke(Field, "OutlineColor", 0)

        local Box = New("TextBox", {
            ClearTextOnFocus = not Input.Disabled and Input.ClearTextOnFocus,
            PlaceholderText = Input.Placeholder,
            Position = UDim2.fromOffset(10, 0),
            Size = UDim2.new(1, -20, 1, 0),
            Text = Input.Value,
            TextEditable = not Input.Disabled,
            TextSize = 13.5,
            Parent = Field,
        })

        local Focused, Hovering = false, false
        local function RefreshStroke()
            if Focused and not Input.Disabled then
                TweenTheme(FieldStroke, "Color", "AccentColor")
            elseif Hovering and not Input.Disabled then
                TweenTheme(FieldStroke, "Color", Palette.OutlineHover)
            else
                TweenTheme(FieldStroke, "Color", "OutlineColor")
            end
        end

        function Input:UpdateColors()
            if Library.Unloaded then
                return
            end
            Label.TextTransparency = Input.Disabled and 0.65 or 0.12
            Box.TextTransparency = Input.Disabled and 0.6 or 0
            FieldStroke.Transparency = Input.Disabled and 0.5 or 0
            SetTheme(Field, "BackgroundColor3", Input.Disabled and "BackgroundColor" or "MainColor")
        end

        function Input:OnChanged(Func)
            Input.Changed = Func
        end

        function Input:RunChanged()
            if Input.Disabled then
                return
            end
            Library:SafeCallback(Input.Callback, Input.Value)
            Library:SafeCallback(Input.Changed, Input.Value)
        end

        function Input:SetValue(Text)
            Text = tostring(Text == nil and "" or Text)

            if not Input.AllowEmpty and Trim(Text) == "" then
                Text = Input.EmptyReset
            end

            if Info.MaxLength and #Text > Info.MaxLength then
                Text = Text:sub(1, Info.MaxLength)
            end

            if Input.Numeric and #Text > 0 and not tonumber(Text) and Text ~= "-" and Text ~= "." then
                Text = Input.Value
            end

            if typeof(Info.VerifyValue) == "function" and Text ~= Input.EmptyReset and Info.VerifyValue(Text) ~= true then
                Text = Input.EmptyReset
            end

            Input.Value = Text
            Box.Text = Text
            Input:RunChanged()
        end

        function Input:SetDisabled(Disabled)
            Input.Disabled = Disabled
            if Input.TooltipTable then
                Input.TooltipTable.Disabled = Disabled
            end
            Box.ClearTextOnFocus = not Disabled and Input.ClearTextOnFocus
            Box.TextEditable = not Disabled
            Input:UpdateColors()
            RefreshStroke()
        end

        function Input:SetVisible(Visible)
            Input.Visible = Visible
            Holder.Visible = Visible
            Groupbox:Resize()
        end

        function Input:SetText(Text)
            Input.Text = Text
            Label.Text = Text
        end

        if Input.Finished then
            table.insert(Input.Connections, Box.FocusLost:Connect(function(Enter)
                if not Enter then
                    if Input.ClearTextOnBlur then
                        Box.Text = Input.Value
                    end
                    return
                end
                Input:SetValue(Box.Text)
            end))
        else
            table.insert(Input.Connections, Box:GetPropertyChangedSignal("Text"):Connect(function()
                if Box.Text == Input.Value then
                    return
                end
                Input:SetValue(Box.Text)
            end))
        end

        table.insert(Input.Connections, Box.Focused:Connect(function()
            Focused = true
            RefreshStroke()
        end))
        table.insert(Input.Connections, Box.FocusLost:Connect(function()
            Focused = false
            RefreshStroke()
        end))
        table.insert(Input.Connections, Field.MouseEnter:Connect(function()
            Hovering = true
            RefreshStroke()
        end))
        table.insert(Input.Connections, Field.MouseLeave:Connect(function()
            Hovering = false
            RefreshStroke()
        end))

        if typeof(Input.Tooltip) == "string" or typeof(Input.DisabledTooltip) == "string" then
            Input.TooltipTable = Library:AddTooltip(Input.Tooltip, Input.DisabledTooltip, Field)
            Input.TooltipTable.Disabled = Input.Disabled
        end

        Input.Holder = Holder
        Input.Box = Box
        table.insert(Groupbox.Elements, Input)

        Input.Default = Input.Value
        if typeof(Info.VerifyValue) == "function" and Input.Default ~= Input.EmptyReset and Info.VerifyValue(Input.Default) ~= true then
            Input:SetValue(Input.EmptyReset)
            Input.Default = Input.EmptyReset
        end

        Input:UpdateColors()
        Options[Idx] = Input

        function Input:Destroy()
            Input.Destroyed = true
            for _, Connection in Input.Connections do
                Connection:Disconnect()
            end
            if Input.TooltipTable then
                Input.TooltipTable:Destroy()
            end
            Holder:Destroy()
            RemoveElement(Groupbox, Input)
            Options[Idx] = nil
        end

        Groupbox:Resize()
        return Input
    end

    --// Slider \\--
    function Funcs:AddSlider(Idx, Info)
        if self.Destroyed then
            return nil
        end

        Info = Library:Validate(Info, Templates.Slider)
        local Groupbox = self

        local Slider = {
            Connections = {},
            Destroyed = false,

            Text = Info.Text,
            Value = tonumber(Info.Default) or 0,
            Min = Info.Min,
            Max = Info.Max,

            Prefix = Info.Prefix,
            Suffix = Info.Suffix,
            Compact = Info.Compact,
            Rounding = Info.Rounding,
            HideMax = Info.HideMax,

            Tooltip = Info.Tooltip,
            DisabledTooltip = Info.DisabledTooltip,
            TooltipTable = nil,

            Callback = Info.Callback,
            Changed = Info.Changed,

            Disabled = Info.Disabled,
            Visible = Info.Visible,

            AllowRightClickInput = Info.AllowRightClickInput,

            Type = "Slider",
            Parent = Groupbox,
        }
        Slider.Value = math.clamp(Slider.Value, math.min(Slider.Min, Slider.Max), math.max(Slider.Min, Slider.Max))

        local Compact = Info.Compact == true
        local Holder = ElementHolder(Groupbox, Compact and 22 or 38)
        Holder.Visible = Slider.Visible

        local SliderLabel, ValueLabel, TrackHolder
        if Compact then
            SliderLabel = New("TextLabel", {
                Size = UDim2.new(0.38, -6, 1, 0),
                Text = Slider.Text,
                TextSize = 13.5,
                TextTransparency = 0.12,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = Holder,
            })
            ValueLabel = New("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                FontFace = Fonts.Medium,
                Position = UDim2.fromScale(1, 0),
                Size = UDim2.new(0, 52, 1, 0),
                Text = "",
                TextSize = 13,
                TextTransparency = 0.12,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = Holder,
            })
            TrackHolder = New("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0.38, 2, 0, 0),
                Size = UDim2.new(0.62, -60, 1, 0),
                Parent = Holder,
            })
        else
            SliderLabel = New("TextLabel", {
                Size = UDim2.new(1, -80, 0, 16),
                Text = Slider.Text,
                TextSize = 14,
                TextTransparency = 0.12,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = Holder,
            })
            ValueLabel = New("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                FontFace = Fonts.Medium,
                Position = UDim2.fromScale(1, 0),
                Size = UDim2.new(0, 120, 0, 16),
                Text = "",
                TextSize = 13,
                TextTransparency = 0.12,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = Holder,
            })
            TrackHolder = New("Frame", {
                AnchorPoint = Vector2.new(0, 1),
                BackgroundTransparency = 1,
                Position = UDim2.fromScale(0, 1),
                Size = UDim2.new(1, 0, 0, 16),
                Parent = Holder,
            })
        end

        local Bar = New("TextButton", {
            Active = not Slider.Disabled,
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Parent = TrackHolder,
        })

        local Track = New("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = "MainColor",
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.new(1, 0, 0, 6),
            Parent = TrackHolder,
        })
        AddCorner(Track, "full")
        local TrackStroke = AddStroke(Track, "OutlineColor", 0)

        local Fill = New("Frame", {
            BackgroundColor3 = "WhiteColor",
            Size = UDim2.fromScale(0, 1),
            Parent = Track,
        })
        AddCorner(Fill, "full")
        local FillGradient = AddAccentGradient(Fill, 0)

        local Knob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = "WhiteColor",
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(12, 12),
            ZIndex = 3,
            Parent = Track,
        })
        AddCorner(Knob, "full")
        local KnobStroke = AddStroke(Knob, "AccentColor", 0, 2)

        local InputTextBox
        if Info.AllowRightClickInput then
            InputTextBox = New("TextBox", {
                AnchorPoint = ValueLabel.AnchorPoint,
                FontFace = Fonts.Medium,
                Position = ValueLabel.Position,
                Size = ValueLabel.Size,
                Text = "",
                TextColor3 = "AccentColor",
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Right,
                Visible = false,
                Parent = Holder,
            })
        end

        local Dragging, Hovering = false, false
        local LastPercent = nil

        local function RefreshKnob()
            local Active = (Dragging or Hovering) and not Slider.Disabled
            Tween(Knob, Library.TweenInfo, { Size = Active and UDim2.fromOffset(15, 15) or UDim2.fromOffset(12, 12) })
            TweenTheme(TrackStroke, "Color", Active and Palette.OutlineHover or "OutlineColor")
        end

        function Slider:UpdateColors()
            if Library.Unloaded then
                return
            end
            SliderLabel.TextTransparency = Slider.Disabled and 0.65 or 0.12
            ValueLabel.TextTransparency = Slider.Disabled and 0.65 or 0.12
            if InputTextBox then
                InputTextBox.TextTransparency = Slider.Disabled and 0.65 or 0
            end
            FillGradient.Enabled = not Slider.Disabled
            SetTheme(Fill, "BackgroundColor3", Slider.Disabled and "OutlineColor" or "WhiteColor")
            SetTheme(KnobStroke, "Color", Slider.Disabled and "OutlineColor" or "AccentColor")
            Knob.BackgroundTransparency = Slider.Disabled and 0.4 or 0
        end

        function Slider:Display()
            if Library.Unloaded then
                return
            end

            local CustomText = nil
            if Info.FormatDisplayValue then
                CustomText = Info.FormatDisplayValue(Slider, Slider.Value)
            end

            if CustomText ~= nil then
                ValueLabel.Text = tostring(CustomText)
            elseif Compact or Info.HideMax then
                ValueLabel.Text = string.format("%s%s%s", Slider.Prefix, FormatNumber(Slider.Value), Slider.Suffix)
            else
                ValueLabel.Text = string.format(
                    "%s%s%s<font transparency=\"0.5\"> / %s%s%s</font>",
                    Slider.Prefix,
                    FormatNumber(Slider.Value),
                    Slider.Suffix,
                    Slider.Prefix,
                    FormatNumber(Slider.Max),
                    Slider.Suffix
                )
            end

            local Range = Slider.Max - Slider.Min
            local Percent = Range ~= 0 and math.clamp((Slider.Value - Slider.Min) / Range, 0, 1) or 0
            if LastPercent == nil then
                Fill.Size = UDim2.fromScale(Percent, 1)
                Knob.Position = UDim2.fromScale(Percent, 0.5)
            elseif Percent ~= LastPercent then
                local Info = Dragging and TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) or Library.SmoothTweenInfo
                Tween(Fill, Info, { Size = UDim2.fromScale(Percent, 1) })
                Tween(Knob, Info, { Position = UDim2.fromScale(Percent, 0.5) })
            end
            LastPercent = Percent
        end

        function Slider:OnChanged(Func)
            Slider.Changed = Func
        end

        function Slider:SetMax(Value)
            assert(Value > Slider.Min, "Max value cannot be less than the current min value.")
            Slider.Max = Value
            Slider:SetValue(math.clamp(Slider.Value, Slider.Min, Value))
            Slider:Display()
        end

        function Slider:SetMin(Value)
            assert(Value < Slider.Max, "Min value cannot be greater than the current max value.")
            Slider.Min = Value
            Slider:SetValue(math.clamp(Slider.Value, Value, Slider.Max))
            Slider:Display()
        end

        function Slider:RunChanged()
            if Slider.Disabled then
                return
            end
            Library:SafeCallback(Slider.Callback, Slider.Value)
            Library:SafeCallback(Slider.Changed, Slider.Value)
        end

        function Slider:SetValue(Str)
            local Num = tonumber(Str)
            if not Num or Num == Slider.Value then
                return
            end

            Num = math.clamp(Num, Slider.Min, Slider.Max)
            Slider.Value = Num
            Slider:Display()
            Slider:RunChanged()
        end

        function Slider:SetDisabled(Disabled)
            Slider.Disabled = Disabled
            if Slider.TooltipTable then
                Slider.TooltipTable.Disabled = Disabled
            end
            Bar.Active = not Disabled
            Slider:UpdateColors()
            RefreshKnob()
        end

        function Slider:SetVisible(Visible)
            Slider.Visible = Visible
            Holder.Visible = Visible
            Groupbox:Resize()
        end

        function Slider:SetAllowRightClickInput(Allow)
            Slider.AllowRightClickInput = Allow == true
        end

        function Slider:SetText(Text)
            Slider.Text = Text
            SliderLabel.Text = Text
            Slider:Display()
        end

        function Slider:SetPrefix(Prefix)
            Slider.Prefix = Prefix
            Slider:Display()
        end

        function Slider:SetSuffix(Suffix)
            Slider.Suffix = Suffix
            Slider:Display()
        end

        if InputTextBox then
            local LastValidText = ""
            table.insert(Slider.Connections, InputTextBox:GetPropertyChangedSignal("Text"):Connect(function()
                local Text = InputTextBox.Text
                if #Text > 0 and not tonumber(Text) and Text ~= "-" and Text ~= "." and Text ~= "-." then
                    InputTextBox.Text = LastValidText
                    return
                end
                if Slider.Rounding == 0 and Text:find("%.") then
                    InputTextBox.Text = LastValidText
                    return
                end
                local DecimalPosition = Text:find("%.")
                if DecimalPosition and Slider.Rounding > 0 and #Text - DecimalPosition > Slider.Rounding then
                    InputTextBox.Text = LastValidText
                    return
                end
                LastValidText = Text
            end))

            table.insert(Slider.Connections, InputTextBox.FocusLost:Connect(function()
                InputTextBox.Visible = false
                ValueLabel.Visible = true

                local Num = tonumber(InputTextBox.Text)
                if Num then
                    Slider:SetValue(Round(math.clamp(Num, Slider.Min, Slider.Max), Slider.Rounding))
                end
            end))
        end

        local LastTap = 0
        local function BeginDrag(Input)
            local IsClick = IsClickInput(Input)
            local IsRightClick = Input.UserInputType == Enum.UserInputType.MouseButton2 and Input.UserInputState == Enum.UserInputState.Begin
            if not (IsClick or IsRightClick) or Slider.Disabled then
                return
            end

            if InputTextBox and Slider.AllowRightClickInput then
                local IsDoubleTap = false
                if Library.IsMobile and Input.UserInputType == Enum.UserInputType.Touch then
                    IsDoubleTap = os.clock() - LastTap < 0.3
                    LastTap = os.clock()
                end

                if IsRightClick or IsDoubleTap then
                    InputTextBox.Text = FormatNumber(Slider.Value)
                    InputTextBox.Visible = true
                    ValueLabel.Visible = false
                    task.spawn(InputTextBox.CaptureFocus, InputTextBox)
                    return
                end
            end

            if not IsClick then
                return
            end

            Dragging = true
            RefreshKnob()

            local Tab = Library.ActiveTab
            if Tab and Tab.Sides then
                for _, Side in Tab.Sides do
                    Side.ScrollingEnabled = false
                end
            end

            while IsDragInput(Input) and not Slider.Destroyed do
                local Width = math.max(Track.AbsoluteSize.X, 1)
                local Scale = math.clamp((Mouse.X - Track.AbsolutePosition.X) / Width, 0, 1)
                local OldValue = Slider.Value
                Slider.Value = math.clamp(Round(Slider.Min + (Slider.Max - Slider.Min) * Scale, Slider.Rounding), Slider.Min, Slider.Max)
                Slider:Display()
                if Slider.Value ~= OldValue then
                    Slider:RunChanged()
                end
                RunService.RenderStepped:Wait()
            end

            if Tab and Tab.Sides then
                for _, Side in Tab.Sides do
                    Side.ScrollingEnabled = true
                end
            end

            Dragging = false
            RefreshKnob()
        end

        table.insert(Slider.Connections, Bar.InputBegan:Connect(BeginDrag))
        table.insert(Slider.Connections, Bar.MouseEnter:Connect(function()
            Hovering = true
            RefreshKnob()
        end))
        table.insert(Slider.Connections, Bar.MouseLeave:Connect(function()
            Hovering = false
            RefreshKnob()
        end))

        if typeof(Slider.Tooltip) == "string" or typeof(Slider.DisabledTooltip) == "string" then
            Slider.TooltipTable = Library:AddTooltip(Slider.Tooltip, Slider.DisabledTooltip, Bar)
            Slider.TooltipTable.Disabled = Slider.Disabled
        end

        Slider:UpdateColors()
        Slider:Display()

        Slider.Holder = Holder
        table.insert(Groupbox.Elements, Slider)
        Slider.Default = Slider.Value
        Options[Idx] = Slider

        function Slider:Destroy()
            Slider.Destroyed = true
            for _, Connection in Slider.Connections do
                Connection:Disconnect()
            end
            if Slider.TooltipTable then
                Slider.TooltipTable:Destroy()
            end
            Holder:Destroy()
            RemoveElement(Groupbox, Slider)
            Options[Idx] = nil
        end

        Groupbox:Resize()
        return Slider
    end

