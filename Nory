        local WarningAccent = New("Frame", {
            BackgroundColor3 = "RedColor",
            Size = UDim2.new(0, 3, 1, 0),
            Parent = WarningBox,
        })
        AddCorner(WarningAccent, "full")

        local WarningScroll = New("ScrollingFrame", {
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
