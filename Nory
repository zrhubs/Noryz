                return
            end
            Callback(Name)
        end

        Box:AddButton({
            Text = "Load config",
            Icon = "folder-open",
            Func = function()
                WithSelected(function(Name)
                    ShowDialog(function()
                        return true
                    end, "SaveManager_LoadConfig", "Load config", string.format("Load %q? Your current settings will be overwritten.", Name), "Load", function()
                        local Success, ErrorMessage = SaveManager:Load(Name)
                        if not Success then
                            Notify(string.format("Failed to load config %q: %s", Name, tostring(ErrorMessage)))
                            return
                        end
                        Notify(string.format("Successfully loaded config %q", Name))
                    end, "Primary")
                end)
            end,
        }):AddButton({
            Text = "Overwrite",
            Icon = "save",
            Func = function()
                WithSelected(function(Name)
                    ShowDialog(function()
                        return true
                    end, "SaveManager_OverwriteConfig", "Overwrite config", string.format("Overwrite %q with your current settings? This cannot be undone.", Name), "Overwrite", function()
                        local Success, ErrorMessage = SaveManager:Save(Name)
                        if not Success then
                            Notify(string.format("Failed to overwrite config %q: %s", Name, tostring(ErrorMessage)))
                            return
                        end
                        Notify(string.format("Successfully overwrote config %q", Name))
                    end)
                end)
            end,
        })

        Box:AddButton({
            Text = "Delete config",
            Icon = "trash-2",
            Risky = true,
            Func = function()
                WithSelected(function(Name)
                    ShowDialog(function()
                        return true
                    end, "SaveManager_DeleteConfig", "Delete config", string.format("Delete %q? This cannot be undone.", Name), "Delete", function()
                        local Success, ErrorMessage = SaveManager:Delete(Name)
                        if not Success then
                            Notify(string.format("Failed to delete config %q: %s", Name, tostring(ErrorMessage)))
                            return
                        end
                        Notify(string.format("Successfully deleted config %q", Name))
                        RefreshAutoloadLabel()
                    end)
                end)
            end,
        }):AddButton({
            Text = "Refresh list",
            Icon = "refresh-cw",
            Func = RefreshList,
        })

        Box:AddButton({
            Text = "Set as autoload",
            Icon = "star",
            Func = function()
                WithSelected(function(Name)
                    local Success, ErrorMessage = SaveManager:SaveAutoloadConfig(Name)
                    if not Success then
                        Notify(string.format("Failed to set autoload config %q: %s", Name, tostring(ErrorMessage)))
                        return
                    end
                    Notify(string.format("Successfully set autoload config to %q", Name))
                    RefreshAutoloadLabel()
                end)
            end,
        }):AddButton({
            Text = "Reset autoload",
            Icon = "rotate-ccw",
            Func = function()
                ShowDialog(function()
                    return true
                end, "SaveManager_ResetAutoload", "Reset autoload config", "Clear the autoload config? Nothing will be loaded automatically on next launch.", "Reset", function()
                    local Success, ErrorMessage = SaveManager:DeleteAutoLoadConfig()
                    if not Success then
                        Notify(string.format("Failed to reset autoload config: %s", tostring(ErrorMessage)))
                        return
                    end
                    Notify("Successfully reset autoload config.")
                    RefreshAutoloadLabel()
                end)
            end,
        })

        AutoloadLabel = Box:AddLabel("Autoload: ...", true)

        Box:AddDivider()

        Box:AddInput("SaveManager_JSON", {
            Text = "Config JSON",
            Placeholder = "paste a config here",
        })

        Box:AddButton({
            Text = "Import",
            Icon = "download",
            Func = function()
                local Content = ConfigJSONInput.Value
                if IsStringEmpty(Content) then
                    Notify("Configuration JSON cannot be empty")
                    return
                end
                ShowDialog(function()
                    return true
                end, "SaveManager_ImportConfig", "Import config", "Import this configuration? Your current settings will be overwritten.", "Import", function()
                    local Success, ErrorMessage = SaveManager:LoadJSON(Content)
                    if not Success then
                        Notify(string.format("Failed to import config: %s", tostring(ErrorMessage)))
                        return
                    end
                    Notify("Successfully imported config")
                end, "Primary")
            end,
        }):AddButton({
            Text = "Export",
            Icon = "upload",
            Func = function()
                local Encoded, Success, ErrorMessage = SaveManager:SaveJSON()
                if not Success then
                    Notify(tostring(ErrorMessage))
                    return
                end
                ConfigJSONInput:SetValue(Encoded)
                local Clipboard = setclipboard or toclipboard
                if Clipboard then
                    pcall(Clipboard, Encoded)
                    Notify("Copied config to your clipboard")
                end
            end,
        })

        ConfigNameInput = Library.Options.SaveManager_ConfigName
        ConfigList = Library.Options.SaveManager_ConfigList
        ConfigJSONInput = Library.Options.SaveManager_JSON

        RefreshAutoloadLabel()
        SaveManager:SetIgnoreIndexes({ "SaveManager_ConfigList", "SaveManager_ConfigName", "SaveManager_JSON" })

        return Box
    end

    return SaveManager
end)()

Library.ThemeManager = (function()
    --[[
        Onyx ThemeManager
        Same public API as the Linoria / Obsidian ThemeManager (ApplyToTab, ApplyToGroupbox,
        SetFolder, SetDefaultTheme, ...). Theme files use the same JSON layout.
    ]]

    local cloneref = (cloneref or clonereference or function(Object)
        return Object
    end)
    local clonefunction = (clonefunction or copyfunction or function(Func)
        return Func
    end)

    local HttpService = cloneref(game:GetService("HttpService"))

    local isfolder, isfile, listfiles = isfolder, isfile, listfiles
    if isfolder and isfile and listfiles then
        local IsFolderCopy, IsFileCopy, ListFilesCopy = clonefunction(isfolder), clonefunction(isfile), clonefunction(listfiles)
        local Success, Result = pcall(function()
            return IsFolderCopy("onyx_probe_" .. tostring(math.random(1000000, 9999999)))
        end)

        if Success == false or typeof(Result) ~= "boolean" then
            isfolder = function(Folder)
                local Ok, Data = pcall(IsFolderCopy, Folder)
                return Ok and Data or false
            end
            isfile = function(File)
                local Ok, Data = pcall(IsFileCopy, File)
                return Ok and Data or false
            end
            listfiles = function(Folder)
                local Ok, Data = pcall(ListFilesCopy, Folder)
                return Ok and Data or {}
            end
        end
    end

    local SchemeIndexes = { "FontColor", "MainColor", "AccentColor", "BackgroundColor", "OutlineColor" }
    local ContrastWarnThreshold = 4.5

    local ThemeManager = {
