            Connections = {},
            Elements = {},
            DependencyBoxes = {},
            Groupboxes = {},
            Tabboxes = {},
            DependencyGroupboxes = {},

            Window = Window,
            Button = TabButton,
            Container = Container,
            TabContainer = TabContainer,
        }
        Tab.Tab = Tab

        function Tab:AddKeyBox(...)
            local ExpectedKey, Callback = select(1, ...), select(2, ...)
            if typeof(ExpectedKey) == "function" then
                Callback = ExpectedKey
                ExpectedKey = nil
            end
            assert(typeof(Callback) == "function", "Callback must be a function")

            local Row = New("Frame", {
                BackgroundTransparency = 1,
                LayoutOrder = NextOrder(),
                Size = UDim2.new(1, 0, 0, 32),
                Parent = Container,
            })

            local Field = New("Frame", {
                BackgroundColor3 = "MainColor",
                ClipsDescendants = true,
                Size = UDim2.new(1, -92, 1, 0),
                Parent = Row,
            })
            AddCorner(Field, 0.7)
            local FieldStroke = AddStroke(Field, "OutlineColor", 0)

            local Box = New("TextBox", {
                PlaceholderText = "Enter your key",
                Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(1, -24, 1, 0),
                TextSize = 13.5,
                Parent = Field,
            })
            Box.Focused:Connect(function()
                TweenTheme(FieldStroke, "Color", "AccentColor")
            end)
            Box.FocusLost:Connect(function()
                TweenTheme(FieldStroke, "Color", "OutlineColor")
            end)

            local Submit = New("TextButton", {
                AnchorPoint = Vector2.new(1, 0),
                BackgroundColor3 = "WhiteColor",
                ClipsDescendants = true,
                FontFace = Fonts.SemiBold,
                Position = UDim2.fromScale(1, 0),
                Size = UDim2.new(0, 84, 1, 0),
                Text = "Submit",
                TextColor3 = "WhiteColor",
                TextSize = 13.5,
                Parent = Row,
            })
            AddCorner(Submit, 0.7)
            AddAccentGradient(Submit, 45)
            local SubmitScale = New("UIScale", { Parent = Submit })

            Submit.MouseEnter:Connect(function()
                Tween(SubmitScale, Library.TweenInfo, { Scale = 1.03 })
            end)
            Submit.MouseLeave:Connect(function()
                Tween(SubmitScale, Library.TweenInfo, { Scale = 1 })
            end)

            local function Run()
                local Key = Box.Text
                if ExpectedKey ~= nil then
                    local Success = Key == ExpectedKey
                    Library:SafeCallback(Callback, Success, Key)
                    TweenTheme(FieldStroke, "Color", Success and "AccentColor" or "RedColor")
                else
                    Library:SafeCallback(Callback, Key)
                end
            end

            Submit.MouseButton1Click:Connect(function()
                Ripple(Submit)
                Run()
            end)
            Box.FocusLost:Connect(function(Enter)
                if Enter then
                    Run()
                end
            end)
        end

        function Tab:Resize() end
        function Tab:RefreshSides() end
        function Tab:UpdateCorners() end

        local Hovering = false
        function Tab:Hover(Value)
            Hovering = Value
            SetTabButtonState(Entry, Library.ActiveTab == Tab, Hovering)
        end

        function Tab:Show()
            if Library.ActiveTab == Tab then
                return
            end
            if Library.ActiveTab then
                Library.ActiveTab:Hide()
            end
            Library.ActiveTab = Tab
            SetTabButtonState(Entry, true, Hovering)
            SetHeaderText(Name, Description)

            local Proxy = { Container = TabContainer, Button = TabButton }
            PlayTabAnimation(Proxy, true)
        end

        function Tab:Hide()
            PlayTabAnimation({ Container = TabContainer, Button = TabButton }, false)
            Library.PreviousTab = Tab
            if Library.ActiveTab == Tab then
                Library.ActiveTab = nil
            end
            SetTabButtonState(Entry, false, Hovering)
        end

        function Tab:SetVisible(Visible)
            TabButton.Visible = Visible
            if not Visible and Library.ActiveTab == Tab then
                Tab:Hide()
            end
        end

        function Tab:SetOrder(NewOrder)
            TabButton.LayoutOrder = NewOrder
        end

        function Tab:SetTooltip(Text)
            Tab.Tooltip = Text
            if Tab.TooltipTable then
                Tab.TooltipTable:Destroy()
                Tab.TooltipTable = nil
            end
            if typeof(Text) == "string" then
                Tab.TooltipTable = Library:AddTooltip(Text, nil, TabButton)
            end
        end

        function Tab:Destroy()
            for _, Element in table.clone(Tab.Elements) do
                if Element.Destroy then
                    Element:Destroy()
                end
            end
            TabContainer:Destroy()
            local Index = table.find(Library.TabButtons, Entry)
            if Index then
                table.remove(Library.TabButtons, Index)
            end
            TabButton:Destroy()
            if Library.ActiveTab == Tab then
                Library.ActiveTab = nil
            end
            Library.Tabs[Name] = nil
        end

        if typeof(Tooltip) == "string" then
            Tab.TooltipTable = Library:AddTooltip(Tooltip, nil, TabButton)
        end

        TabButton.MouseEnter:Connect(function()
            Tab:Hover(true)
        end)
        TabButton.MouseLeave:Connect(function()
            Tab:Hover(false)
        end)
        TabButton.MouseButton1Click:Connect(function()
            Tab:Show()
        end)

        setmetatable(Tab, BaseGroupbox)
        Library.Tabs[Name] = Tab

        if not Library.ActiveTab then
            Tab:Show()
        end

        return Tab
    end

