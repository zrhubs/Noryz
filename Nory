end

--// Soft layered drop shadow (no external assets)
local function AddShadow(Parent, Target, Spread, Strength, ZIndex)
    Spread = Spread or 18
    Strength = Strength or 0.55
    local Holder = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1, 1),
        ZIndex = ZIndex or 0,
        Parent = Parent,
    })

    local Layers = 5
    for Index = 1, Layers do
        local Grow = math.floor(Spread * (Index / Layers))
        local Layer = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Palette.Shadow,
            BackgroundTransparency = 1 - (Strength / (Layers + 1)) * (1 - (Index - 1) / Layers),
            Position = UDim2.new(0.5, 0, 0.5, math.floor(Grow * 0.25)),
            Size = UDim2.new(1, Grow * 2, 1, Grow * 2),
            ZIndex = ZIndex or 0,
            Parent = Holder,
        })
        New("UICorner", {
            CornerRadius = UDim.new(0, Library.CornerRadius + Grow),
            Parent = Layer,
        })
    end

    if Target then
        local function Sync()
            Holder.Visible = Target.Visible
        end
        Target:GetPropertyChangedSignal("Visible"):Connect(Sync)
        Sync()
    end

    return Holder
end

