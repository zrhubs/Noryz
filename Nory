            AutomaticSize = Enum.AutomaticSize.Y,
            FontFace = Fonts.Bold,
            LayoutOrder = 1,
            Size = UDim2.new(1, Info.Icon and -26 or 0, 0, 0),
            Text = Info.Title,
            TextColor3 = Info.TitleColor or "FontColor",
            TextSize = 17,
            TextWrapped = true,
            ZIndex = 2,
            Parent = TitleRow,
        })

