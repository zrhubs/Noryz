        function Dropdown:UpdateColors()
            if Library.Unloaded then
                return
            end
            Label.TextTransparency = Dropdown.Disabled and 0.65 or 0.12
            DisplayButton.TextTransparency = Dropdown.Disabled and 0.65 or 0
            DisplayImage.ImageTransparency = Dropdown.Disabled and 0.65 or 0
            DisplayStroke.Transparency = Dropdown.Disabled and 0.5 or 0
            SetTheme(DisplayContainer, "BackgroundColor3", Dropdown.Disabled and "BackgroundColor" or "MainColor")
            RefreshDisplayVisual()
        end

        function Dropdown:Display()
            if Library.Unloaded then
                return
            end

            local Parts = {}
            local ValueImage = nil
            local IsDictionary = not IsSequentialArray(Dropdown.Values)

            if Info.Multi then
                for Key, RawValue in Dropdown.Values do
                    local Value = IsDictionary and Key or RawValue
                    if Dropdown.Value[Value] then
                        if not ValueImage then
                            ValueImage = GetValueImage(Value, RawValue)
                        end
                        table.insert(Parts, Info.FormatDisplayValue and tostring(Info.FormatDisplayValue(RawValue)) or tostring(RawValue))
                    end
                end
            else
                local DisplayValue = Dropdown.Value
                if IsDictionary and Dropdown.Value ~= nil then
                    DisplayValue = Dropdown.Values[Dropdown.Value]
                end

                ValueImage = GetValueImage(Dropdown.Value, DisplayValue)
                if DisplayValue ~= nil then
                    local Text = tostring(DisplayValue)
                    if Info.FormatDisplayValue then
                        Text = tostring(Info.FormatDisplayValue(Text))
                    end
                    table.insert(Parts, Text)
                end
            end

            local Text = table.concat(Parts, ", ")
            DisplayButton.Text = Text == "" and "---" or Text
            DisplayButton.TextTransparency = Dropdown.Disabled and 0.65 or (Text == "" and 0.5 or 0)

            if ValueImage then
                Library:ApplyLucideIcon(DisplayImage, ValueImage)
                DisplayImage.Visible = true
                DisplayButton.Position = UDim2.fromOffset(32, 0)
                DisplayButton.Size = UDim2.new(1, -60, 1, 0)
            else
                DisplayImage.Visible = false
                DisplayButton.Position = UDim2.fromOffset(10, 0)
                DisplayButton.Size = UDim2.new(1, -38, 1, 0)
            end
        end

        function Dropdown:OnChanged(Func)
            Dropdown.Changed = Func
        end

        function Dropdown:GetActiveValues(ReturnCount)
            local Table = {}
            if Info.Multi then
                for Value in Dropdown.Value do
                    table.insert(Table, Value)
                end
            elseif Dropdown.Value ~= nil then
                table.insert(Table, Dropdown.Value)
            end
            return ReturnCount == true and #Table or Table
        end

        local function RecomputeFilteredEntries()
            local Values = Dropdown.Values
            local DisabledValues = Dropdown.DisabledValues or {}
            local IsDictionary = not IsSequentialArray(Values)

            local Query = SearchBox and NormalizeSearch(SearchBox.Text) or ""
            local IsSearching = Query ~= ""

            local Pending = {}
            for Key, RawValue in Values do
                local Value = IsDictionary and Key or RawValue
                local Formatted = tostring(Info.FormatListValue and Info.FormatListValue(RawValue) or RawValue)

                local Score = 0
                if IsSearching then
                    local Matched, MatchScore = FuzzyScore(NormalizeSearch(Formatted), Query)
                    if not Matched then
                        continue
                    end
                    Score = MatchScore
                end

                local IsDisabled = table.find(DisabledValues, Value) ~= nil
                    or (RawValue ~= Value and table.find(DisabledValues, RawValue) ~= nil)

                table.insert(Pending, {
                    Value = Value,
                    RawValue = RawValue,
                    FormattedValue = Formatted,
                    IsDisabled = IsDisabled,
                    ValueImage = GetValueImage(Value, RawValue),
                    SortKey = IsDictionary and Formatted:lower() or Key,
                    MatchScore = Score,
                })
            end

            if IsSearching then
                table.sort(Pending, function(A, B)
                    if A.MatchScore ~= B.MatchScore then
                        return A.MatchScore > B.MatchScore
                    end
                    return tostring(A.SortKey) < tostring(B.SortKey)
                end)
            else
                table.sort(Pending, function(A, B)
                    if typeof(A.SortKey) == typeof(B.SortKey) then
                        return A.SortKey < B.SortKey
                    end
                    return tostring(A.SortKey) < tostring(B.SortKey)
                end)
            end

            table.clear(FilteredEntries)
            if Dropdown.KeepDisabledValuePosition then
                for _, Entry in Pending do
                    table.insert(FilteredEntries, Entry)
                end
                return
            end

            for _, Entry in Pending do
                if not Entry.IsDisabled then
                    table.insert(FilteredEntries, Entry)
                end
            end
            for _, Entry in Pending do
                if Entry.IsDisabled then
                    table.insert(FilteredEntries, Entry)
                end
            end
        end

        local function IsSelected(Entry)
            if Info.Multi then
                return Dropdown.Value[Entry.Value] == true
            end
            return Dropdown.Value == Entry.Value
        end

        local function CreatePoolRow()
            local Row = { Entry = nil, Index = nil, Selected = false, Hovering = false }

