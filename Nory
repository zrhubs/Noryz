        local function RefreshList()
            -- SetValues keeps the current selection when it still exists and clears it otherwise
            ConfigList:SetValues(SaveManager:RefreshConfigList())
        end

        local function RefreshAutoloadLabel()
            local Name = SaveManager:GetAutoloadConfig()
            AutoloadLabel:SetText(string.format("Autoload: <font transparency=\"0.4\">%s</font>", tostring(Name)))
