            })
            Internal(Options, "OnyxSettings_ThemeGallery")
            local Cards = {}

            local function MakeCard(Name, Data)
                local Bg = FromHex(Data.BackgroundColor) or Color3.new()
                local Main = FromHex(Data.MainColor) or Bg
                local Accent = FromHex(Data.AccentColor) or Color3.new(1, 1, 1)
                local Outline = FromHex(Data.OutlineColor) or Main
                local FontColor = FromHex(Data.FontColor) or Color3.new(1, 1, 1)

                local Card = New("TextButton", {
                    BackgroundColor3 = Bg,
                    Text = "",
                    ZIndex = 2,
                    Parent = Grid,
                })
                AddCorner(Card, 0.75)
                local Stroke = New("UIStroke", {
                    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                    Color = Outline,
                    Thickness = 1,
                    Parent = Card,
                })

                local Preview = New("Frame", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(6, 6),
                    Size = UDim2.new(1, -12, 0, 30),
                    ZIndex = 2,
                    Parent = Card,
                })
                local Side = New("Frame", {
                    BackgroundColor3 = Main,
                    Size = UDim2.new(0, 16, 1, 0),
                    ZIndex = 2,
                    Parent = Preview,
                })
                New("UICorner", { CornerRadius = UDim.new(0, 3), Parent = Side })
                local function Bar(X, Y, Width, Color, Transparency)
                    local Line = New("Frame", {
                        BackgroundColor3 = Color,
                        BackgroundTransparency = Transparency or 0,
                        Position = UDim2.new(0, X, 0, Y),
                        Size = Width,
                        ZIndex = 2,
                        Parent = Preview,
                    })
                    New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Line })
                end
                Bar(22, 3, UDim2.new(1, -28, 0, 4), FontColor, 0.15)
                Bar(22, 12, UDim2.new(0.55, -14, 0, 4), FontColor, 0.6)
                Bar(22, 22, UDim2.new(0.7, -18, 0, 4), Accent, 0)
                local Pill = New("Frame", {
                    AnchorPoint = Vector2.new(1, 1),
                    BackgroundColor3 = Accent,
                    Position = UDim2.fromScale(1, 1),
                    Size = UDim2.fromOffset(14, 8),
                    ZIndex = 2,
                    Parent = Preview,
                })
                New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Pill })

                New("TextLabel", {
                    FontFace = Fonts.Medium,
                    Position = UDim2.new(0, 7, 1, -22),
                    Size = UDim2.new(1, -14, 0, 16),
                    Text = Name,
                    TextColor3 = FontColor,
                    TextSize = 12,
                    TextTransparency = 0.05,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 2,
                    Parent = Card,
                })

                local Badge = New("Frame", {
                    AnchorPoint = Vector2.new(1, 0),
                    BackgroundColor3 = "AccentColor",
                    Position = UDim2.new(1, -5, 0, 5),
                    Size = UDim2.fromOffset(14, 14),
                    Visible = false,
                    ZIndex = 3,
                    Parent = Card,
                })
                AddCorner(Badge, "full")
                MakeIcon("check", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    ImageColor3 = Color3.new(1, 1, 1),
                    Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(10, 10),
                    ZIndex = 3,
                    Parent = Badge,
                })

                local Entry = { Name = Name, Card = Card, Hover = false }

                function Entry:Refresh()
                    local Selected = MatchingTheme() == Name
                    Badge.Visible = Selected
                    if Selected then
                        SetTheme(Stroke, "Color", "AccentColor")
                        Stroke.Thickness = 1.5
                    else
                        SetTheme(Stroke, "Color", Entry.Hover and Outline:Lerp(FontColor, 0.35) or Outline)
                        Stroke.Thickness = 1
                    end
                end

                Card.MouseEnter:Connect(function()
                    Entry.Hover = true
                    Entry:Refresh()
                end)
                Card.MouseLeave:Connect(function()
                    Entry.Hover = false
                    Entry:Refresh()
                end)
                Card.MouseButton1Click:Connect(function()
                    ApplyThemeByName(Name)
                end)

                return Entry
            end

            function Gallery.Rebuild()
                for _, Entry in Cards do
                    Entry.Card:Destroy()
                end
                table.clear(Cards)

                for _, Name in ThemeNames() do
                    local Data = GetThemeData(Name)
                    if Data then
                        local Entry = MakeCard(Name, Data)
                        local Position = #Cards
                        local Row, Column = Position // Columns, Position % Columns
                        Entry.Card.Position = UDim2.new(Column / Columns, Column * Gap / Columns, 0, Row * (CardHeight + Gap))
                        Entry.Card.Size = UDim2.new(1 / Columns, -(Columns - 1) * Gap / Columns, 0, CardHeight)
                        table.insert(Cards, Entry)
                    end
                end

                local Rows = math.max(1, math.ceil(#Cards / Columns))
                Passthrough:SetHeight(Rows * (CardHeight + Gap) - Gap)
                Gallery.Refresh()
            end

            function Gallery.Refresh()
                for _, Entry in Cards do
                    Entry:Refresh()
                end
            end

            Gallery.Rebuild()
        end

