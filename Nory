--// Built-in theme manager page \\--
-- Opened from the palette button in the window header, needs no code in the user's script.
-- Only appearance lives here (configs stay with the script). Its elements are kept out of
-- Library.Options / Library.Toggles so a script's own config system never sees or saves them.
-- Choices are remembered per window title in Onyx/<Title>/interface.json.
do
    local HttpService = GetService("HttpService")
    local ThemeManager = Library.ThemeManager
    local SaveManager = Library.SaveManager
    local AutoSaveName = "autosave"

    local SchemeKeys = { "BackgroundColor", "MainColor", "AccentColor", "OutlineColor", "FontColor" }
    local AccentPresets = { "637eff", "4c8dff", "a46bff", "ff7eb6", "ff4d6a", "f5a524", "34d399", "22d3ee" }
    local FontChoices = { "BuilderSans", "Gotham", "Montserrat", "Ubuntu", "Nunito", "Roboto", "SourceSans", "Arimo" }
    local ScaleChoices = { "75%", "90%", "100%", "110%", "125%", "150%" }

    local function SafeName(Text)
        Text = tostring(Text or "")
        Text = Text:gsub("<[^>]->", ""):gsub('[<>:"/\\|%?%*%c]', ""):gsub("^%s+", ""):gsub("%s+$", "")
        if Text == "" then
            Text = "Default"
        end
        return Text:sub(1, 48)
    end

    local function FileApi()
        return typeof(isfile) == "function" and typeof(readfile) == "function" and typeof(writefile) == "function"
            and typeof(isfolder) == "function" and typeof(makefolder) == "function"
    end

    local function EnsureFolder(Path)
        if not FileApi() then
            return false
        end
        local Current = ""
        for Part in string.gmatch(Path, "[^/]+") do
            Current = Current == "" and Part or (Current .. "/" .. Part)
            local Ok, Exists = pcall(isfolder, Current)
            if not (Ok and Exists) then
                pcall(makefolder, Current)
            end
        end
        return true
    end

    local function ToHex(Color)
        return typeof(Color) == "Color3" and Color:ToHex() or nil
    end

    local function FromHex(Hex)
        if typeof(Hex) ~= "string" then
            return nil
        end
        local Ok, Color = pcall(Color3.fromHex, Hex)
        return Ok and Color or nil
    end

    local function FontEnum(Name)
        local Ok, Item = pcall(function()
            return Enum.Font[Name]
        end)
        return Ok and Item or nil
    end

    --// takes an element out of the public registries right after it was created
    local function Internal(Registry, Index)
        local Object = Registry[Index]
        Registry[Index] = nil
        table.insert(Library.InternalOptions, Object)
        return Object
    end

    function Library:SetupSettings(Window, WindowInfo, Ui)
        local Title = SafeName(WindowInfo.Title)
        local Folder = "Onyx/" .. Title

        if not ThemeManager.FolderCustomized then
            ThemeManager.Folder = "Onyx"
        end

        -- ConfigSystem = false keeps configs out of the page (for scripts that ship their own)
        local ConfigSystem = WindowInfo.ConfigSystem ~= false
        if ConfigSystem and not SaveManager.FolderCustomized then
            SaveManager.Folder = Folder
        end

        local Settings = {
            Tab = nil,
            Built = false,
            Guard = false,
            Controls = {},
            ConfigSystem = ConfigSystem,
            SelectedConfig = nil,
        }
        Window.Settings = Settings

        --// Remembered appearance (only what the user changed is stored) \\--
        local Prefs = { Data = {}, Path = Folder .. "/interface.json", Queued = false }
        Settings.Prefs = Prefs

        if FileApi() then
            local Ok, Exists = pcall(isfile, Prefs.Path)
            if Ok and Exists then
                local ReadOk, Content = pcall(readfile, Prefs.Path)
                if ReadOk then
                    local DecodeOk, Data = pcall(HttpService.JSONDecode, HttpService, Content)
                    if DecodeOk and typeof(Data) == "table" then
                        Prefs.Data = Data
                    end
                end
            end
        end

        function Prefs:Write()
            if not FileApi() or Library.Unloaded then
                return
            end
            EnsureFolder(Folder)
            local Ok, Encoded = pcall(HttpService.JSONEncode, HttpService, Prefs.Data)
            if Ok then
                pcall(writefile, Prefs.Path, Encoded)
            end
        end

        function Prefs:Set(Key, Value)
            Prefs.Data[Key] = Value
            if Prefs.Queued then
                return
            end
            Prefs.Queued = true
            task.delay(0.35, function()
                Prefs.Queued = false
                Prefs:Write()
            end)
        end

        local function CurrentColors()
            local Colors = {}
            for _, Key in SchemeKeys do
                Colors[Key] = ToHex(Library.Scheme[Key])
            end
            return Colors
        end

        local function SaveColors()
            Prefs:Set("Colors", CurrentColors())
        end

        --// keeps ThemeManager's own pickers (if the script also built that UI) in sync
        local function SyncOwnedOptions()
            for _, Key in SchemeKeys do
                local Option = ThemeManager.OwnedOptions[Key]
                if Option and not Option.Destroyed and Option.Value ~= Library.Scheme[Key] then
                    ThemeManager.Applying = true
                    pcall(Option.SetValueRGB, Option, Library.Scheme[Key])
                    ThemeManager.Applying = false
                end
            end
        end

        local function SetSchemeColor(Key, Color)
            Library.Scheme[Key] = Color
            Library:UpdateColorsUsingRegistry()
        end

        --// apply the remembered look right away, before the script builds its UI
        do
            local Data = Prefs.Data
            if typeof(Data.Colors) == "table" then
                for _, Key in SchemeKeys do
                    local Color = FromHex(Data.Colors[Key])
                    if Color then
                        Library.Scheme[Key] = Color
                    end
                end
                Library:UpdateColorsUsingRegistry()
            end
            if typeof(Data.Font) == "string" and FontEnum(Data.Font) then
                Library:SetFont(FontEnum(Data.Font))
                ThemeManager.CurrentFontName = Data.Font
            end
            if typeof(Data.Corner) == "number" then
                Window:SetCornerRadius(Data.Corner)
            end
            if typeof(Data.Scale) == "number" then
                Library:SetDPIScale(Data.Scale)
            end
        end

        local function Notify(TitleText, Description, Icon)
            Library:Notify({ Title = TitleText, Description = Description, Icon = Icon, Time = 4 })
        end

        local function Confirm(Index, TitleText, Description, ActionText, Variant, Action)
            if not Window.AddDialog then
                Action()
                return
            end
            Window:AddDialog(Index, {
                Title = TitleText,
                Description = Description,
                AutoDismiss = false,
                FooterButtons = {
                    Cancel = {
                        Title = "Cancel",
                        Variant = "Ghost",
                        Order = 1,
                        Callback = function(Dialog)
                            Dialog:Dismiss()
                        end,
                    },
                    Confirm = {
                        Title = ActionText,
                        Variant = Variant or "Primary",
                        Order = 2,
                        Callback = function(Dialog)
                            Dialog:Dismiss()
                            Action()
                        end,
                    },
                },
            })
        end

        local Gallery = {}
        local Swatches = {}

        local function GetThemeData(Name)
            local BuiltIn = ThemeManager.BuiltInThemes[Name]
            if BuiltIn then
                return BuiltIn[2], true
            end
            local Ok, Data = pcall(ThemeManager.GetCustomTheme, ThemeManager, Name)
            if Ok and typeof(Data) == "table" then
                return Data, false
            end
            return nil
        end

        --// which theme the current colors come from (highlight when nothing was picked yet)
        local function MatchingTheme()
            if Prefs.Data.Theme then
                return Prefs.Data.Theme
            end
            for Name, Entry in ThemeManager.BuiltInThemes do
                local Matches = true
                for _, Key in SchemeKeys do
                    local Current = ToHex(Library.Scheme[Key])
                    if not (Current and typeof(Entry[2][Key]) == "string" and Current:lower() == Entry[2][Key]:lower()) then
                        Matches = false
                        break
                    end
                end
                if Matches then
                    return Name
                end
            end
            return nil
        end

        local function ThemeNames()
            local Names = {}
            for Name in ThemeManager.BuiltInThemes do
                table.insert(Names, Name)
            end
            table.sort(Names, function(A, B)
                return ThemeManager.BuiltInThemes[A][1] < ThemeManager.BuiltInThemes[B][1]
            end)
            if FileApi() then
                pcall(ThemeManager.CheckFolderTree, ThemeManager)
                local Ok, Custom = pcall(ThemeManager.ReloadCustomThemes, ThemeManager)
                if Ok and typeof(Custom) == "table" then
                    for _, Name in Custom do
                        if not ThemeManager.BuiltInThemes[Name] then
                            table.insert(Names, Name)
                        end
                    end
                end
            end
            return Names
        end

        function Settings:SyncControls()
            if not Settings.Built then
                return
            end
            Settings.Guard = true
            local C = Settings.Controls
            for _, Key in SchemeKeys do
                local Picker = C[Key]
                if Picker and Picker.Value ~= Library.Scheme[Key] then
                    Picker:SetValueRGB(Library.Scheme[Key])
                end
            end
            if C.Corner and C.Corner.Value ~= Library.CornerRadius then
                C.Corner:SetValue(Library.CornerRadius)
            end
            local Scale = string.format("%d%%", math.floor(Library.DPIScale * 100 + 0.5))
            if C.Scale and table.find(ScaleChoices, Scale) and C.Scale.Value ~= Scale then
                C.Scale:SetValue(Scale)
            end
            local FontName = ThemeManager.CurrentFontName
            if C.Font and FontName and C.Font.Value ~= FontName and table.find(C.Font.Values, FontName) then
                C.Font:SetValue(FontName)
            end
            Settings.Guard = false
            for _, Refresh in Swatches do
                Refresh()
            end
            if Gallery.Refresh then
                Gallery.Refresh()
            end
        end

        local function ApplyThemeByName(Name)
            local Data = GetThemeData(Name)
            if not Data then
                return
            end
            ThemeManager:ApplyThemeData(Data)
            Prefs:Set("Theme", Name)
            Prefs:Set("Colors", CurrentColors())
            if typeof(Data.FontFace) == "string" and FontEnum(Data.FontFace) then
                Prefs:Set("Font", Data.FontFace)
            end
            Settings:SyncControls()
        end

        --// Theme gallery: live mini previews \\--
        local function BuildGallery(Groupbox)
