--// Notifications \\--
function Library:UpdateNotificationPositions(Snap)
    local IsLeft = tostring(Library.NotifySide):lower() == "left"
    local XScale = IsLeft and 0 or 1
    local RunningY = 0
    local Scale = math.max(Library.DPIScale, 0.01)

    for _, Slot in NotifyOrder do
        local Data = Library.Notifications[Slot]
        if not (Data and Slot.Parent) then
            continue
        end

        Slot.AnchorPoint = Vector2.new(XScale, 0)
        local Target = UDim2.new(XScale, 0, 0, RunningY)
        if Snap or not Data.PositionInitialized then
            Slot.Position = Target
            Data.PositionInitialized = true
        elseif Slot.Position ~= Target then
            Tween(Slot, Library.NotifyTweenInfo, { Position = Target })
        end

        RunningY += Slot.AbsoluteSize.Y / Scale + 8
    end
end

function Library:SetNotifySide(Side)
    Side = tostring(Side or "Right")
    Library.NotifySide = Side

    local IsLeft = Side:lower() == "left"
    NotificationArea.AnchorPoint = Vector2.new(IsLeft and 0 or 1, 0)
    NotificationArea.Position = IsLeft and UDim2.fromOffset(14, 14) or UDim2.new(1, -14, 0, 14)

    for _, Data in Library.Notifications do
        if Data.Card and not Data.Destroyed then
            Data.Card.Position = UDim2.fromOffset(0, 0)
        end
    end

    Library:UpdateNotificationPositions(true)
end

local NotificationTypes = {
    success = { Icon = "circle-check", Color = function()
        return Color3.fromRGB(52, 211, 153)
    end },
    warning = { Icon = "triangle-alert", Color = function()
        return Color3.fromRGB(245, 165, 36)
    end },
    error = { Icon = "circle-x", Color = function()
        return Library.Scheme.RedColor
    end },
    info = { Icon = "info" },
}

