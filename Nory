function Library:AddDraggableLabel(...)
    local Params = select(1, ...)
    local Text, Icon, IconPosition = "", nil, "left"

    if typeof(Params) == "table" then
        Text = Params.Text or ""
        Icon = Params.Icon
        IconPosition = Params.IconPosition or "left"
    elseif typeof(Params) == "string" then
        Text = Params
        Icon = select(2, ...)
        IconPosition = select(3, ...) or "left"
    end
    if typeof(IconPosition) ~= "string" then
        IconPosition = "left"
    end
    IconPosition = IconPosition:lower()
    assert(IconPosition == "left" or IconPosition == "right", "Icon Position needs to be either 'left' or 'right'.")

    local DraggableLabel = { Connections = {}, Destroyed = false }

    local Pill = CreateFloatPill(Floats, false)
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 8),
        Parent = Pill,
    })
    AddPadding(Pill, 7, 12, 7, 12)

    local IconImage = New("ImageLabel", {
        ImageColor3 = "AccentColor",
        LayoutOrder = 0,
        Size = UDim2.fromOffset(15, 15),
        Visible = false,
        Parent = Pill,
    })

    local Label = New("TextLabel", {
        AutomaticSize = Enum.AutomaticSize.XY,
        FontFace = Fonts.Medium,
        LayoutOrder = 1,
        Size = UDim2.fromOffset(0, 16),
        Text = Text,
        TextSize = 14,
        Parent = Pill,
    })

    Library:MakeDraggable(Pill, Pill, true)

    function DraggableLabel:SetText(NewText)
        Label.Text = tostring(NewText)
    end

    function DraggableLabel:SetIconPosition(NewPosition)
        IconPosition = tostring(NewPosition):lower()
        assert(IconPosition == "left" or IconPosition == "right", "Icon Position needs to be either 'left' or 'right'.")
        IconImage.LayoutOrder = IconPosition == "left" and 0 or 2
    end

    function DraggableLabel:SetIcon(NewIcon)
        Icon = NewIcon
        local HasIcon = Icon ~= nil and Trim(tostring(Icon)) ~= ""
        if HasIcon then
            local Found = SetIcon(IconImage, Icon)
            assert(Found, "Icon must be a valid Roblox asset or a valid URL or a valid lucide icon.")
        end
        IconImage.Visible = HasIcon
        DraggableLabel:SetIconPosition(IconPosition)
    end

    function DraggableLabel:SetVisible(Visible)
        Pill.Visible = Visible
    end

    function DraggableLabel:Destroy()
        DraggableLabel.Destroyed = true
        for _, Connection in DraggableLabel.Connections do
            Connection:Disconnect()
        end
        local Index = table.find(Library.DraggableElements, Pill)
        if Index then
            table.remove(Library.DraggableElements, Index)
        end
        Pill:Destroy()
    end

    DraggableLabel.Label = Label
    DraggableLabel.Frame = Pill
    DraggableLabel:SetIcon(Icon)

    table.insert(Library.DraggableElements, Pill)
    PositionDraggable(Pill)

    return DraggableLabel
end

