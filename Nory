            ScrollBarThickness = 2,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Size = UDim2.new(1, 0, 0, 0),
            Parent = WarningBox,
        })
        local WarningInner = New("Frame", {
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            Parent = WarningScroll,
        })
        New("UIListLayout", { Padding = UDim.new(0, 3), Parent = WarningInner })
        AddPadding(WarningInner, 10, 14, 11, 16)

        local WarningTitle = New("TextLabel", {
            AutomaticSize = Enum.AutomaticSize.Y,
            FontFace = Fonts.Bold,
            Size = UDim2.new(1, 0, 0, 0),
            Text = "",
            TextColor3 = "RedColor",
            TextSize = 14,
            TextWrapped = true,
            Parent = WarningInner,
        })
        local WarningText = New("TextLabel", {
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 1,
            Size = UDim2.new(1, 0, 0, 0),
            Text = "",
            TextSize = 13.5,
            TextTransparency = 0.12,
            TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top,
            Parent = WarningInner,
        })

        local Columns = New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Parent = TabContainer,
        })

        local function MakeSide(Index)
            local Side = New("ScrollingFrame", {
                AnchorPoint = Vector2.new(Index == 1 and 0 or 1, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                Position = Index == 1 and UDim2.fromOffset(15, 0) or UDim2.new(1, -13, 0, 0),
                ScrollBarImageColor3 = "OutlineColor",
                ScrollBarImageTransparency = 0.1,
                ScrollBarThickness = 3,
                ScrollingDirection = Enum.ScrollingDirection.Y,
                Size = UDim2.new(0.5, -18, 1, 0),
                VerticalScrollBarInset = Enum.ScrollBarInset.None,
                Parent = Columns,
            })
            New("UIListLayout", {
                Padding = UDim.new(0, 10),
                Parent = Side,
            })
            AddPadding(Side, 14, 5, 16, 1)
            return Side
        end

        local TabLeft = MakeSide(1)
        local TabRight = MakeSide(2)

        local Tab = {
            Name = Name,
            Description = Description,
            Tooltip = Tooltip,
            TooltipTable = nil,

            Connections = {},
            Destroyed = false,

            Window = Window,
            Button = TabButton,
            Container = TabContainer,
            Sides = { TabLeft, TabRight },
            WarningBox = {
                IsNormal = false,
                LockSize = false,
                Visible = false,
                Title = "WARNING",
                Text = "",
            },

            Groupboxes = {},
            Tabboxes = {},
            DependencyGroupboxes = {},
        }

        local function RefreshWarningColors()
            local Normal = Tab.WarningBox.IsNormal == true
            local Scheme = Library.Scheme
            WarningBox.BackgroundColor3 = Normal and Palette.Card() or Scheme.BackgroundColor:Lerp(Scheme.RedColor, 0.16)
            WarningStroke.Color = Normal and Scheme.OutlineColor or Scheme.BackgroundColor:Lerp(Scheme.RedColor, 0.5)
            WarningAccent.BackgroundColor3 = Normal and Scheme.AccentColor or Scheme.RedColor
            WarningTitle.TextColor3 = Normal and Scheme.FontColor or Scheme.RedColor
        end
        Library:AddToRegistry(WarningBox, {
            BackgroundColor3 = function()
                RefreshWarningColors()
                return WarningBox.BackgroundColor3
            end,
        })

        function Tab:RefreshSides()
            local Offset = 0
            if WarningBox.Visible then
                Offset = WarningBox.AbsoluteSize.Y / math.max(Library.DPIScale, 0.01) + 14
            end
            Columns.Position = UDim2.fromOffset(0, Offset)
            Columns.Size = UDim2.new(1, 0, 1, -Offset)
        end

        function Tab:Resize(ResizeWarningBox)
            if ResizeWarningBox and WarningBox.Visible then
                local MaxHeight = math.floor((Body.AbsoluteSize.Y / math.max(Library.DPIScale, 0.01)) / 3.25)
                local ContentHeight = WarningInner.AbsoluteSize.Y / math.max(Library.DPIScale, 0.01)
                if Tab.WarningBox.LockSize and ContentHeight > MaxHeight then
                    WarningScroll.AutomaticSize = Enum.AutomaticSize.None
                    WarningScroll.Size = UDim2.new(1, 0, 0, MaxHeight)
                else
                    WarningScroll.AutomaticSize = Enum.AutomaticSize.Y
                    WarningScroll.Size = UDim2.new(1, 0, 0, 0)
                end
            end
            Tab:RefreshSides()
        end

        table.insert(Tab.Connections, WarningBox:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            Tab:RefreshSides()
        end))

        function Tab:UpdateWarningBox(WarningInfo)
            WarningInfo = WarningInfo or {}
            if typeof(WarningInfo.IsNormal) == "boolean" then
                Tab.WarningBox.IsNormal = WarningInfo.IsNormal
            end
            if typeof(WarningInfo.LockSize) == "boolean" then
                Tab.WarningBox.LockSize = WarningInfo.LockSize
            end
            if typeof(WarningInfo.Visible) == "boolean" then
                Tab.WarningBox.Visible = WarningInfo.Visible
            end
            if typeof(WarningInfo.Title) == "string" then
                Tab.WarningBox.Title = WarningInfo.Title
            end
            if typeof(WarningInfo.Text) == "string" then
                Tab.WarningBox.Text = WarningInfo.Text
            end

            WarningBox.Visible = Tab.WarningBox.Visible
            WarningTitle.Text = Tab.WarningBox.Title
            WarningText.Text = Tab.WarningBox.Text
            WarningText.Visible = Tab.WarningBox.Text ~= ""
            RefreshWarningColors()
            Tab:Resize(true)
        end

        Tab.AddTabbox = function(Self, Info)
            if typeof(Info) == "string" then
                Info = { Name = Info }
            end
            return Builders.Tabbox(Tab, Info or {})
        end

        function Tab:AddLeftTabbox(TabboxName)
            return Tab:AddTabbox({ Side = 1, Name = TabboxName })
        end

        function Tab:AddRightTabbox(TabboxName)
            return Tab:AddTabbox({ Side = 2, Name = TabboxName })
        end

        function Tab:AddGroupbox(Info)
            Info = Library:Validate(Info, Templates.Groupbox)

            if typeof(Info.Side) == "string" then
                local Lower = Info.Side:lower()
                if not SideIndex[Lower] then
                    error(string.format("Invalid side: %s", Info.Side))
                end
                Info.Side = SideIndex[Lower]
            end

            local BoxHolder = New("Frame", {
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder = NextOrder(),
                Size = UDim2.new(1, 0, 0, 0),
                Parent = Info.Side == 1 and TabLeft or TabRight,
            })
            New("UIListLayout", {
                Padding = UDim.new(0, 10),
                Parent = BoxHolder,
            })

            local Card = New("Frame", {
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Palette.Card,
                Size = UDim2.new(1, 0, 0, 0),
                Parent = BoxHolder,
            })
            AddCorner(Card, 0.85)
            local CardStroke = AddStroke(Card, Palette.OutlineSoft, 0)
            New("UIListLayout", {
                Parent = Card,
            })

            -- The header is sized explicitly (no AutomaticSize): wrapped text inside AutomaticSize
            -- containers is measured inconsistently by Roblox and could leave a tall empty header.
            local Header = New("TextButton", {
                BackgroundTransparency = 1,
                LayoutOrder = 1,
                Size = UDim2.new(1, 0, 0, 40),
                Parent = Card,
            })
            AddPadding(Header, 11, 12, 11, 13)

            local BoxIcon = Library:GetCustomIcon(Info.IconName)
            local HeaderIcon
            if BoxIcon then
                HeaderIcon = New("ImageLabel", {
                    ImageColor3 = BoxIcon.Custom and "WhiteColor" or "AccentColor",
                    Position = UDim2.fromOffset(0, 0),
                    Size = UDim2.fromOffset(17, 17),
                    Parent = Header,
                })
                Library:ApplyLucideIcon(HeaderIcon, BoxIcon)
            end

            local CanCollapse = Info.DisableCollapsing ~= true
            local RightInset = (CanCollapse and 24 or 0) + (Info.PopOut ~= false and 24 or 0)

            local TextsInset = RightInset + (HeaderIcon and 26 or 0)
            local Texts = New("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(HeaderIcon and 26 or 0, 0),
                Size = UDim2.new(1, -TextsInset, 0, 18),
                Parent = Header,
            })

            New("TextLabel", {
                FontFace = Fonts.SemiBold,
                Size = UDim2.new(1, 0, 0, 18),
                Text = Info.Name,
                TextSize = 14.5,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = Texts,
            })

            local GroupboxDescription = New("TextLabel", {
                Position = UDim2.fromOffset(0, 20),
                Size = UDim2.new(1, 0, 0, 15),
                Text = "",
                TextSize = 12.5,
                TextTransparency = 0.5,
                TextWrapped = true,
                TextYAlignment = Enum.TextYAlignment.Top,
                Visible = false,
                Parent = Texts,
            })

            local HeaderDescription = Info.Description
            local LastHeaderWidth = nil
            local function LayoutHeader()
                local Text = typeof(HeaderDescription) == "string" and HeaderDescription or nil
                if Text and Text:gsub("<[^>]->", ""):match("^%s*$") then
                    Text = nil
                end

                local DescriptionHeight = 0
                if Text then
                    local Scale = GetEffectiveScale(Texts)
                    local Width = Texts.AbsoluteSize.X / math.max(Scale, 0.01)
                    local _, Y = Library:GetTextBounds(Text, GroupboxDescription.FontFace, 12.5, Width > 1 and Width or nil)
                    DescriptionHeight = math.max(15, math.ceil(Y))
                end

                GroupboxDescription.Text = Text or ""
                GroupboxDescription.Visible = Text ~= nil
                GroupboxDescription.Size = UDim2.new(1, 0, 0, DescriptionHeight)

                local TextsHeight = 18 + (Text and (2 + DescriptionHeight) or 0)
                Texts.Size = UDim2.new(1, -TextsInset, 0, TextsHeight)
                Header.Size = UDim2.new(1, 0, 0, math.max(40, TextsHeight + 22))
            end
            LayoutHeader()
            Texts:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                local Width = math.floor(Texts.AbsoluteSize.X / math.max(GetEffectiveScale(Texts), 0.01) + 0.5)
                if Width ~= LastHeaderWidth then
                    LastHeaderWidth = Width
                    LayoutHeader()
                end
