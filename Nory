    --// API \\--
    function Loading:UpdateLayout()
        local Width = Loading.ShowSidebar and (Loading.ContentWidth + Loading.SidebarWidth) or Loading.ContentWidth
        Loading.WindowWidth = Width
        local Height = Loading.IsError and Loading.WindowErrorHeight or Loading.WindowHeight
        Tween(Root, Library.SmoothTweenInfo, { Size = UDim2.fromOffset(Width, Height) })
        Tween(Shadow, Library.SmoothTweenInfo, { Size = UDim2.fromOffset(Width * Library.DPIScale, Height * Library.DPIScale) })
        ContentArea.Size = UDim2.new(0, Loading.ContentWidth, 1, 0)
        SidebarFrame.Size = UDim2.new(0, Loading.SidebarWidth, 1, 0)
        SidebarFrame.Visible = Loading.ShowSidebar
    end

    function Loading:RecalculateLoadingHeight()
        if not Loading.AutoResizeHeight then
            return
        end
        local Scale = math.max(Library.DPIScale, 0.01)
        local Needed = 58 + 98 + DescriptionLabel.AbsoluteSize.Y / Scale + 70
        Loading.WindowHeight = math.max(Loading.BaseWindowHeight, Needed)
        Loading:UpdateLayout()
    end

    function Loading:SetMessage(Text)
        MessageLabel.Text = tostring(Text)
    end

    function Loading:SetDescription(Text)
        DescriptionLabel.Text = tostring(Text)
        task.defer(Loading.RecalculateLoadingHeight, Loading)
    end

    function Loading:SetLoadingIcon(Icon)
        local Parsed = Library:GetCustomIcon(Icon)
        if Parsed then
            Library:ApplyLucideIcon(SpinnerImage, Parsed)
            SpinnerImage.Visible = true
            SpinnerStroke.Enabled = false
        else
            SpinnerImage.Visible = false
            SpinnerStroke.Enabled = true
        end
    end

    function Loading:SetLoadingIconTweenTime(TweenTime)
        SpinTime = math.max(tonumber(TweenTime) or 1, 0.05)
    end

    function Loading:SetLoadingIconColor(Color)
        if typeof(Color) == "Color3" then
            SpinnerImage.ImageColor3 = Color
            SpinnerGradient.Color = ColorSequence.new(Color)
        end
    end

    function Loading:SetCurrentStep(Step)
        Loading.CurrentStep = math.clamp(tonumber(Step) or 0, 0, Loading.TotalSteps)
        local Percent = Loading.CurrentStep / math.max(Loading.TotalSteps, 1)
        Tween(ProgressFill, Library.SmoothTweenInfo, { Size = UDim2.fromScale(Percent, 1) })
        StepLabel.Text = string.format("%d / %d", Loading.CurrentStep, Loading.TotalSteps)
    end

    function Loading:SetTotalSteps(Steps)
        Loading.TotalSteps = math.max(1, tonumber(Steps) or 1)
        Loading:SetCurrentStep(Loading.CurrentStep)
    end

    function Loading:SetWindowHeight(Height)
        Loading.WindowHeight = Height
        Loading.BaseWindowHeight = Height
        Loading:UpdateLayout()
    end

    function Loading:SetWindowWidth(Width)
        Loading.ContentWidth = Loading.ShowSidebar and math.max(200, Width - Loading.SidebarWidth) or Width
        Loading:UpdateLayout()
    end

    function Loading:SetContentWidth(Width)
        Loading.ContentWidth = Width
        Loading:UpdateLayout()
    end

    function Loading:SetSidebarWidth(Width)
        Loading.SidebarWidth = Width
        Loading:UpdateLayout()
    end

    function Loading:ShowSidebarPage(Bool)
        Loading.ShowSidebar = Bool == true
        Loading:UpdateLayout()
    end

    function Loading:RecalculateErrorHeight()
        local Scale = math.max(Library.DPIScale, 0.01)
        Loading.WindowErrorHeight = math.max(Loading.BaseWindowHeight, 58 + 68 + ErrorLabel.AbsoluteSize.Y / Scale + 80)
        if Loading.IsError then
            Loading:UpdateLayout()
        end
    end

    function Loading:ShowErrorPage(Enabled)
        Loading.IsError = Enabled == true
        ErrorPage.Visible = Loading.IsError
        MainPage.Visible = not Loading.IsError
        Loading:RecalculateErrorHeight()
        Loading:UpdateLayout()
    end

    function Loading:SetErrorMessage(Text)
        ErrorLabel.Text = tostring(Text)
        task.defer(Loading.RecalculateErrorHeight, Loading)
    end

    function Loading:SetErrorButtons(ButtonsInfo)
        for _, Child in ErrorButtons:GetChildren() do
            if Child:IsA("GuiObject") then
                Child:Destroy()
            end
        end

        for Idx, ButtonInfo in ButtonsInfo or {} do
            local Variant = ButtonInfo.Variant or "Primary"
            local Button = New("TextButton", {
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = "MainColor",
                ClipsDescendants = true,
                FontFace = Fonts.SemiBold,
                LayoutOrder = ButtonInfo.Order or 0,
                Size = UDim2.fromOffset(0, 32),
                Text = ButtonInfo.Title or tostring(Idx),
                TextSize = 13.5,
                Parent = ErrorButtons,
            })
            AddCorner(Button, 0.7)
            AddPadding(Button, 0, 16, 0, 16)

            if Variant == "Primary" then
                SetTheme(Button, "BackgroundColor3", "WhiteColor")
                AddAccentGradient(Button, 45)
                SetTheme(Button, "TextColor3", "WhiteColor")
            elseif Variant == "Destructive" then
                SetTheme(Button, "BackgroundColor3", "DestructiveColor")
                SetTheme(Button, "TextColor3", "WhiteColor")
            elseif Variant == "Ghost" then
                Button.BackgroundTransparency = 1
            else
                AddStroke(Button, "OutlineColor", 0)
            end

            Button.MouseButton1Click:Connect(function()
                Ripple(Button)
                if ButtonInfo.Callback then
                    Library:SafeCallback(ButtonInfo.Callback, Loading)
                end
            end)
        end
    end

    function Loading:Destroy()
        if Loading.Destroyed then
            return
        end
        Loading.Destroyed = true
        SpinConnection:Disconnect()

        Library.ActiveLoading = nil
        Tween(Root, Library.TweenInfo, { BackgroundTransparency = 1 })
        task.delay(Library.TweenInfo.Time, function()
            LoadingGui:Destroy()
        end)

        if Library.Toggle and Library.Toggled == false and Library.Unloaded ~= true and Library.Window then
            Library:Toggle(true)
        end
    end
    Loading.Continue = Loading.Destroy

    if LoadingInfo.LoadingIcon then
        Loading:SetLoadingIcon(LoadingInfo.LoadingIcon)
    end
    if typeof(LoadingInfo.LoadingIconColor) == "Color3" then
        Loading:SetLoadingIconColor(LoadingInfo.LoadingIconColor)
    end

    if Library.Toggle and Library.Toggled and Library.Unloaded ~= true then
        Library:Toggle(false)
    end

    Loading:UpdateLayout()
    Loading:SetCurrentStep(Loading.CurrentStep)

    Library.ActiveLoading = Loading
    return Loading
end

--// Live player / team lists \\--
local function OnPlayerChange()
    if Library.Unloaded then
        return
    end

    local PlayerList, ExcludedPlayerList = GetPlayers(false), GetPlayers(true)
    for _, Dropdown in Options do
        if Dropdown.Type == "Dropdown" and Dropdown.SpecialType == "Player" then
            Dropdown:SetValues(Dropdown.ExcludeLocalPlayer and ExcludedPlayerList or PlayerList)
        end
    end
end

local function OnTeamChange()
    if Library.Unloaded then
        return
    end

    local TeamList = GetTeams()
    for _, Dropdown in Options do
        if Dropdown.Type == "Dropdown" and Dropdown.SpecialType == "Team" then
            Dropdown:SetValues(TeamList)
        end
    end
end

Library:GiveSignal(Players.PlayerAdded:Connect(OnPlayerChange))
Library:GiveSignal(Players.PlayerRemoving:Connect(function(Player)
    task.defer(OnPlayerChange)
end))
Library:GiveSignal(Teams.ChildAdded:Connect(OnTeamChange))
Library:GiveSignal(Teams.ChildRemoved:Connect(OnTeamChange))

--// Unload \\--
function Library:Unload()
    if Library.Unloaded then
        return
    end
    Library.Unloaded = true

    RestoreMouseState()

    for Index = #Library.Signals, 1, -1 do
        local Connection = table.remove(Library.Signals, Index)
        if Connection and typeof(Connection) == "RBXScriptConnection" and Connection.Connected then
            Connection:Disconnect()
        end
    end

    for _ = 1, #Library.UnloadSignals do
        local Callback = table.remove(Library.UnloadSignals, 1)
        if Callback then
            Library:SafeCallback(Callback)
        end
    end

    for _, Tab in Library.Tabs do
        if typeof(Tab) == "table" and Tab.Destroy then
            pcall(Tab.Destroy, Tab)
        end
    end

    for Index = #Tooltips, 1, -1 do
        local Tooltip = table.remove(Tooltips, Index)
        if Tooltip and Tooltip.Destroy then
            pcall(Tooltip.Destroy, Tooltip)
        end
    end

    if Library.ActiveLoading then
        pcall(Library.ActiveLoading.Destroy, Library.ActiveLoading)
    end

    if Library.KeybindMenu then
        pcall(Library.KeybindMenu.Destroy, Library.KeybindMenu)
    end

    if ScreenGui then
        ScreenGui:Destroy()
    end

    table.clear(Library.Registry)
    table.clear(Options)
    table.clear(Toggles)
    table.clear(Buttons)
    table.clear(Labels)
    table.clear(Tooltips)
    table.clear(Library.Tabs)
    table.clear(Library.TabButtons)
    table.clear(Library.Scales)
    table.clear(Library.ScalesOffset)
    table.clear(Library.Corners)
    table.clear(Library.SpecificCorners)
    table.clear(Library.ContextMenus)
    table.clear(Library.Notifications)
    table.clear(Library.Dialogues)
    table.clear(Library.DraggableElements)
    table.clear(Library.KeybindToggles)
    table.clear(Library.DependencyBoxes)

    Library.Toggle = function() end
    Library.ScreenGui = nil
    Library.Floats = nil
    Library.Overlay = nil
    Library.WindowContainer = nil
    Library.KeybindFrame = nil
    Library.KeybindContainer = nil
    Library.KeybindMenu = nil

    local Env = getgenv()
    if Env.Library == Library then
        Env.Library = nil
    end
    if Env.Toggles == Toggles then
        Env.Toggles = nil
    end
    if Env.Options == Options then
        Env.Options = nil
    end
end

--// Built-in SaveManager & ThemeManager (same API as the standalone Linoria / Obsidian addons) \\--
Library.SaveManager = (function()
    --[[
        Onyx SaveManager
        Same public API as the Linoria / Obsidian SaveManager, so existing scripts and
        previously saved configs keep working.
    ]]

    local cloneref = (cloneref or clonereference or function(Object)
        return Object
    end)
    local clonefunction = (clonefunction or copyfunction or function(Func)
        return Func
    end)

    local HttpService = cloneref(game:GetService("HttpService"))

    --// Some executors throw instead of returning false from these, wrap them
    local isfolder, isfile, listfiles = isfolder, isfile, listfiles
    if isfolder and isfile and listfiles then
        local IsFolderCopy, IsFileCopy, ListFilesCopy = clonefunction(isfolder), clonefunction(isfile), clonefunction(listfiles)
        local Success, Result = pcall(function()
            return IsFolderCopy("onyx_probe_" .. tostring(math.random(1000000, 9999999)))
        end)

        if Success == false or typeof(Result) ~= "boolean" then
            isfolder = function(Folder)
                local Ok, Data = pcall(IsFolderCopy, Folder)
                return Ok and Data or false
            end
            isfile = function(File)
                local Ok, Data = pcall(IsFileCopy, File)
                return Ok and Data or false
            end
            listfiles = function(Folder)
                local Ok, Data = pcall(ListFilesCopy, Folder)
                return Ok and Data or {}
            end
        end
    end

    local SaveManager = {
        Library = Library,

        Folder = "OnyxSettings",
        SubFolder = "",

        Ignore = {},
        LoadingOrder = {},
        UseLoadingOrder = false,

        AutoloadConfig = nil,
    }

    function SaveManager:SetLibrary(Library)
        SaveManager.Library = Library
    end

    --// Helpers \\--
    local function Trim(Text)
        return (tostring(Text):match("^%s*(.-)%s*$"))
    end

    local function IsStringEmpty(Text)
        return typeof(Text) ~= "string" or Trim(Text) == ""
    end

    local function IsValidFolderPath(Name)
        return typeof(Name) == "string" and Trim(Name) ~= "" and not Name:find('[<>:"|%?%*%z]')
    end

    -- options created by the built-in settings page never end up in configs
    local function IsInternalIndex(Index)
        return typeof(Index) == "string" and Index:sub(1, 13) == "OnyxSettings_"
    end

    local function Notify(Text)
        if SaveManager.Library and SaveManager.Library.Notify then
            SaveManager.Library:Notify(Text)
        end
    end

    local UDim2Parser = {
        Encode = function(Value)
            return {
                X = { Scale = Value.X.Scale, Offset = Value.X.Offset },
                Y = { Scale = Value.Y.Scale, Offset = Value.Y.Offset },
            }
        end,
        Decode = function(Data)
            if typeof(Data) == "table" and Data.X and Data.Y then
                return UDim2.new(Data.X.Scale or 0, Data.X.Offset or 0, Data.Y.Scale or 0, Data.Y.Offset or 0)
            elseif typeof(Data) == "UDim2" then
                return Data
            end
            return nil
        end,
    }

    --// Dropdown values can be Player / Team instances, store them by name
    local function EncodeDropdownValue(Dropdown)
        local Value = Dropdown.Value
        if Dropdown.Multi then
            local Result = {}
            for Key, Active in Value or {} do
                if Active then
                    Result[typeof(Key) == "Instance" and Key.Name or tostring(Key)] = true
                end
            end
            return Result
        end

        if typeof(Value) == "Instance" then
            return Value.Name
        end
        return Value
    end

    local function ResolveDropdownValue(Dropdown, Raw)
        if not Dropdown.SpecialType and typeof(next(Dropdown.Values or {})) ~= "number" then
            return Raw
        end

        local function Find(Name)
            for Key, Value in Dropdown.Values do
                if typeof(Value) == "Instance" and Value.Name == Name then
                    return Value
                elseif Value == Name then
                    return Value
                elseif typeof(Key) == "string" and Key == Name then
                    return Key
                end
            end
            return nil
        end

        if Dropdown.Multi then
            local Result = {}
            for Key, Active in typeof(Raw) == "table" and Raw or {} do
                local Name = typeof(Key) == "number" and Active or Key
                local Found = Find(Name)
                if Found ~= nil then
                    Result[Found] = true
                end
            end
            return Result
        end

        if Raw == nil then
            return nil
        end
        return Find(Raw)
    end

    --// Element parsers \\--
    local ElementParser = {}
    do
        local function CreateParser(ElementType, LibraryIndex, Save, Load, CustomFetcher)
            ElementParser[ElementType] = {
                Save = function(Index, Element, ...)
                    local Data = Save(Index, Element, ...)
                    Data.type = ElementType
                    Data.idx = Index
                    return Data
                end,
                Load = function(Index, Data)
                    if CustomFetcher == true then
                        return Load(nil, Data)
                    end
                    local Elements = SaveManager.Library and SaveManager.Library[LibraryIndex]
                    local Element = Elements and Elements[Index]
                    return Load(Element, Data)
                end,
            }
        end

        CreateParser("Toggle", "Toggles", function(_, Toggle)
            return { value = Toggle.Value }
        end, function(Element, Data)
            if not Element then
                return
            end
            if Element.Value == Data.value then
                Element:RunChanged()
                return
            end
            Element:SetValue(Data.value)
        end)

        CreateParser("Slider", "Options", function(_, Slider)
            return { value = tostring(Slider.Value) }
        end, function(Element, Data)
            if not Element then
                return
            end
            if tostring(Element.Value) == tostring(Data.value) then
                Element:RunChanged()
                return
            end
            Element:SetValue(Data.value)
        end)

        CreateParser("Dropdown", "Options", function(_, Dropdown)
            return { value = EncodeDropdownValue(Dropdown), multi = Dropdown.Multi }
        end, function(Element, Data)
            if not Element then
                return
            end
            local Value = ResolveDropdownValue(Element, Data.value)
            if not Element.Multi and Element.Value == Value then
                Element:RunChanged()
                return
            end
            Element:SetValue(Value)
        end)

        CreateParser("ColorPicker", "Options", function(_, ColorPicker)
            return { value = ColorPicker.Value:ToHex(), transparency = ColorPicker.Transparency }
        end, function(Element, Data)
            if not Element then
                return
            end
            local Success, Color = pcall(Color3.fromHex, tostring(Data.value))
            if Success then
                Element:SetValueRGB(Color, Data.transparency)
            end
        end)

        CreateParser("KeyPicker", "Options", function(_, KeyPicker)
            return {
                mode = KeyPicker.Mode,
                key = KeyPicker.Value,
                modifiers = KeyPicker.Modifiers,
                toggled = KeyPicker.Toggled,
            }
        end, function(Element, Data)
            if not Element then
                return
            end
            Element:SetValue({ Data.key, Data.mode, Data.modifiers })
            if Data.mode == "Toggle" and Data.toggled ~= nil and Element.Toggled ~= Data.toggled then
                Element.Toggled = Data.toggled == true
                Element:Update()
            end
        end)

        CreateParser("Input", "Options", function(_, Input)
            return { text = Input.Value }
        end, function(Element, Data)
            if not Element or typeof(Data.text) ~= "string" then
                return
            end
            if Element.Value == Data.text then
                Element:RunChanged()
                return
            end
            Element:SetValue(Data.text)
        end)

        CreateParser("Groupbox", "Tabs", function(_, Groupbox, TabIndex)
            return {
                tabIdx = TabIndex,
                collapsed = Groupbox.Collapsed,
                poppedOut = Groupbox.PoppedOut == true,
                popoutPos = (Groupbox.PoppedOut and Groupbox.PopOutFloat) and UDim2Parser.Encode(Groupbox.PopOutFloat.Position) or nil,
            }
        end, function(_, Data)
            local TabIndex, Index = Data.tabIdx, Data.idx
            if typeof(TabIndex) ~= "string" or typeof(Index) ~= "string" then
                return
            end

            local Tabs = SaveManager.Library and SaveManager.Library.Tabs
            local Tab = Tabs and Tabs[TabIndex]
            local Groupbox = Tab and Tab.Groupboxes and Tab.Groupboxes[Index]
            if not Groupbox then
                return
            end

            if Groupbox.SetCollapsed and Groupbox.Collapsed ~= (Data.collapsed == true) then
                Groupbox:SetCollapsed(Data.collapsed == true)
            end

            if Groupbox.PopOutEnabled and Groupbox.SetPoppedOut then
                if Data.poppedOut == true then
                    Groupbox:SetPoppedOut(true, UDim2Parser.Decode(Data.popoutPos))
                elseif Groupbox.PoppedOut then
                    Groupbox:SetPoppedOut(false)
                end
            end
        end, true)

        CreateParser("Tabbox", "Tabs", function(_, Tabbox, TabIndex)
            return {
                tabIdx = TabIndex,
                poppedOut = Tabbox.PoppedOut == true,
                popoutPos = (Tabbox.PoppedOut and Tabbox.PopOutFloat) and UDim2Parser.Encode(Tabbox.PopOutFloat.Position) or nil,
            }
        end, function(_, Data)
            local TabIndex, Index = Data.tabIdx, Data.idx
            if typeof(TabIndex) ~= "string" or typeof(Index) ~= "string" then
                return
            end

            local Tabs = SaveManager.Library and SaveManager.Library.Tabs
            local Tab = Tabs and Tabs[TabIndex]
            local Tabbox = Tab and Tab.Tabboxes and Tab.Tabboxes[Index]
            if not Tabbox then
                return
            end

            if Tabbox.PopOutEnabled and Tabbox.SetPoppedOut then
                if Data.poppedOut == true then
                    Tabbox:SetPoppedOut(true, UDim2Parser.Decode(Data.popoutPos))
                elseif Tabbox.PoppedOut then
                    Tabbox:SetPoppedOut(false)
                end
            end
        end, true)
    end
    SaveManager.Parser = ElementParser

    --// Paths \\--
    local function SplitPath(Path)
        local Result, Current = {}, ""
        for Part in string.gmatch(Path, "[^/]+") do
            Current = Current == "" and Part or (Current .. "/" .. Part)
            table.insert(Result, Current)
        end
        return Result
    end

    local function GetFolderPath()
        if IsStringEmpty(SaveManager.Folder) then
            return false
        end
        return string.format("%s/settings", SaveManager.Folder)
    end

    local function GetSubFolderPath()
        if IsStringEmpty(SaveManager.Folder) or IsStringEmpty(SaveManager.SubFolder) then
            return false
        end
        return string.format("%s/settings/%s", SaveManager.Folder, SaveManager.SubFolder)
    end

    local function GetCurrentSettingsPath()
        local SubFolderPath = GetSubFolderPath()
        if SubFolderPath == false then
            return GetFolderPath()
        end
        return SubFolderPath
    end

    local function GetConfigPath(ConfigName)
        local Path = GetCurrentSettingsPath()
        if Path == false then
            return false
        end
        return string.format("%s/%s.json", Path, ConfigName)
    end

    local function DoesConfigExist(ConfigName)
        local Path = GetConfigPath(ConfigName)
        return Path ~= false and isfile(Path)
    end

    local function GetAutoloadPath()
        local Path = GetCurrentSettingsPath()
        if Path == false then
            return false
        end
        return string.format("%s/autoload.txt", Path)
    end

    --// Indexes \\--
    function SaveManager:GetConfigFilePath(ConfigName)
        return GetConfigPath(ConfigName)
    end

    function SaveManager:SetLoadingOrder(Enabled, Order)
        SaveManager.UseLoadingOrder = Enabled == true
        if typeof(Order) == "table" then
            SaveManager.LoadingOrder = Order
        end
    end

    function SaveManager:SetIgnoreIndexes(Indexes)
        assert(typeof(Indexes) == "table", "Expected table, got " .. typeof(Indexes))
        for _, Index in Indexes do
            SaveManager.Ignore[Index] = true
        end
    end

    function SaveManager:IgnoreThemeSettings()
        SaveManager:SetIgnoreIndexes({
            "BackgroundColor",
            "MainColor",
            "AccentColor",
            "OutlineColor",
            "FontColor",
            "FontFace",
            "BackgroundImage",
            "ThemeManager_ThemeList",
            "ThemeManager_CustomThemeList",
            "ThemeManager_CustomThemeName",
            "ThemeManager_ThemeJSON",
        })
    end

    --// Folders \\--
    function SaveManager:GetPaths()
        local SubFolderPath = GetSubFolderPath()
        if SubFolderPath == false then
            local FolderPath = GetFolderPath()
            return FolderPath == false and {} or SplitPath(FolderPath)
        end
        return SplitPath(SubFolderPath)
    end

    function SaveManager:BuildFolderTree(SkipWhenCreated)
        if not (isfolder and makefolder) then
            return false
        end

        local Paths = SaveManager:GetPaths()
        if #Paths == 0 then
            return false
        end

        if SkipWhenCreated == true and isfolder(Paths[#Paths]) then
            return true
        end

        for _, Path in Paths do
            if not isfolder(Path) then
                pcall(makefolder, Path)
            end
        end

        return true
    end

    function SaveManager:CheckFolderTree()
        return SaveManager:BuildFolderTree(true)
    end

    function SaveManager:CheckSubFolder(CreateFolder)
        local SubFolderPath = GetSubFolderPath()
        if SubFolderPath == false then
            return false
        end

        local Exists = isfolder(SubFolderPath)
        if not CreateFolder then
            return Exists
        end

        if not Exists then
            pcall(makefolder, SubFolderPath)
        end
        return true
    end

    function SaveManager:SetFolder(Folder)
        assert(IsValidFolderPath(Folder), "Invalid path provided")
        SaveManager.FolderCustomized = true
        SaveManager.Folder = Folder
        SaveManager:BuildFolderTree()
    end

    function SaveManager:SetSubFolder(SubFolder)
        assert(IsValidFolderPath(SubFolder), "Invalid path provided")
        SaveManager.SubFolder = SubFolder
        SaveManager:BuildFolderTree()
    end

    --// Configs \\--
    function SaveManager:RefreshConfigList()
        local SettingsPath = GetCurrentSettingsPath()
        if SettingsPath == false or not listfiles then
            return {}
        end

        if makefolder and not isfolder(SettingsPath) then
            pcall(makefolder, SettingsPath)
        end

        local Success, Files = pcall(listfiles, SettingsPath)
        if not (Success and typeof(Files) == "table") then
            Notify(string.format("Failed to load config list: %s", tostring(Files)))
            return {}
        end

        local Names = {}
        for _, FilePath in Files do
            FilePath = tostring(FilePath):gsub("\\", "/")
            local FileName = FilePath:match("([^/]+)%.json$")
            if FileName and FileName ~= "autoload" then
                table.insert(Names, FileName)
            end
        end
        table.sort(Names, function(A, B)
            return A:lower() < B:lower()
        end)

        return Names
    end

    function SaveManager:SaveJSON(ConfigName)
        local Library = SaveManager.Library
        local IgnoreIndexes = SaveManager.Ignore

        local CurrentData = {
            timestamp = os.date("%d.%m.%Y %H:%M:%S"),
            name = ConfigName or "",
            objects = {},
            keybindMenu = nil,
        }

        if Library.KeybindFrame then
            local Hidden = {}
            for Index, Option in Library.Options do
                if Option.Type == "KeyPicker" and Option.NoUI ~= true and Option.MenuVisible == false then
                    Hidden[Index] = true
                end
            end

            local KeybindMenu = Library.KeybindMenu
            CurrentData.keybindMenu = {
                visible = Library.KeybindFrame.Visible,
                position = UDim2Parser.Encode(Library.KeybindFrame.Position),
                collapsed = KeybindMenu and KeybindMenu.Collapsed == true or false,
                settingsOpen = false,
                settingsPosition = (KeybindMenu and KeybindMenu.SettingsFrame) and UDim2Parser.Encode(KeybindMenu.SettingsFrame.Position) or nil,
                hidden = Hidden,
            }
        end

        for Index, Toggle in Library.Toggles do
            if Toggle.Type and not IgnoreIndexes[Index] and not IsInternalIndex(Index) and ElementParser[Toggle.Type] then
                table.insert(CurrentData.objects, ElementParser[Toggle.Type].Save(Index, Toggle))
            end
        end

        for Index, Option in Library.Options do
            if Option.Type and not IgnoreIndexes[Index] and not IsInternalIndex(Index) and ElementParser[Option.Type] then
                local Success, Data = pcall(ElementParser[Option.Type].Save, Index, Option)
                if Success then
                    table.insert(CurrentData.objects, Data)
                end
            end
        end

        for TabIndex, Tab in Library.Tabs do
            if Tab.Groupboxes then
                for Index, Groupbox in Tab.Groupboxes do
                    if typeof(Index) == "string" and not IgnoreIndexes[Index] then
                        table.insert(CurrentData.objects, ElementParser.Groupbox.Save(Index, Groupbox, TabIndex))
                    end
                end
            end
            if Tab.Tabboxes then
                for Index, Tabbox in Tab.Tabboxes do
                    if typeof(Index) == "string" and not IgnoreIndexes[Index] then
                        table.insert(CurrentData.objects, ElementParser.Tabbox.Save(Index, Tabbox, TabIndex))
                    end
                end
            end
        end

        local Success, Encoded = pcall(HttpService.JSONEncode, HttpService, CurrentData)
        if not Success then
            return "", false, "Failed to encode data"
        end

        return Encoded, true
    end

    function SaveManager:Save(ConfigName)
        if IsStringEmpty(ConfigName) or ConfigName:lower() == "autoload" then
            return false, "Invalid config name provided"
        end

        local ConfigPath = GetConfigPath(ConfigName)
        if ConfigPath == false then
            return false, "Invalid config name provided"
        end

        SaveManager:CheckFolderTree()

        local Encoded, Success, ErrorMessage = SaveManager:SaveJSON(ConfigName)
        if not Success then
            return false, ErrorMessage
        end

        local WriteSuccess, WriteError = pcall(writefile, ConfigPath, Encoded)
        if not WriteSuccess then
            return false, "Failed to write config file: " .. tostring(WriteError)
        end

        return true
    end

    function SaveManager:LoadJSON(Content)
        if IsStringEmpty(Content) then
            return false, "No JSON provided"
        end

        local Success, Decoded = pcall(HttpService.JSONDecode, HttpService, Content)
        if not Success or typeof(Decoded) ~= "table" or typeof(Decoded.objects) ~= "table" then
            return false, "Failed to decode config data"
        end

        local Library = SaveManager.Library
        local IgnoreIndexes = SaveManager.Ignore

        if SaveManager.UseLoadingOrder and typeof(SaveManager.LoadingOrder) == "table" then
            local Order = SaveManager.LoadingOrder
            table.sort(Decoded.objects, function(A, B)
                return (table.find(Order, A.type) or math.huge) < (table.find(Order, B.type) or math.huge)
            end)
        end

        if Library.KeybindFrame and typeof(Decoded.keybindMenu) == "table" then
            local MenuData = Decoded.keybindMenu
            local Visible = MenuData.visible == true

            Library.KeybindFrame.Visible = Visible
            Library.KeybindFrame.Position = UDim2Parser.Decode(MenuData.position) or Library.KeybindFrame.Position

            local MenuToggle = Library.Toggles and Library.Toggles.KeybindMenuOpen
            if MenuToggle and MenuToggle.Value ~= Visible then
                MenuToggle:SetValue(Visible)
            end

            local KeybindMenu = Library.KeybindMenu
            if KeybindMenu then
                if KeybindMenu.SetCollapsed then
                    KeybindMenu:SetCollapsed(MenuData.collapsed == true)
                end

                if typeof(MenuData.hidden) == "table" then
                    for Index, Option in Library.Options do
                        if Option.Type == "KeyPicker" and Option.NoUI ~= true and Option.SetMenuVisibility then
                            Option:SetMenuVisibility(MenuData.hidden[Index] ~= true)
                        end
                    end
                end

                local SettingsPosition = UDim2Parser.Decode(MenuData.settingsPosition)
                if SettingsPosition and KeybindMenu.SettingsFrame then
                    KeybindMenu.SettingsFrame.Position = SettingsPosition
                end
                if KeybindMenu.SetSettingsOpen then
                    KeybindMenu:SetSettingsOpen(false)
                end
            end
        end

        local Pending = {}
        for _, Object in Decoded.objects do
            if Object.type and not IgnoreIndexes[Object.idx] and not IsInternalIndex(Object.idx) and ElementParser[Object.type] then
                local Registry = Object.type == "Toggle" and Library.Toggles or Library.Options
                local IsElement = Object.type ~= "Groupbox" and Object.type ~= "Tabbox"
                if IsElement and typeof(Object.idx) == "string" and Registry[Object.idx] == nil then
                    -- element not created yet (script still building its UI): apply it when it appears
                    Pending[Object.idx] = Object
                else
                    task.defer(function()
                        local Ok, Error = pcall(ElementParser[Object.type].Load, Object.idx, Object)
                        if not Ok then
                            warn("[Onyx SaveManager] failed to load", Object.idx, Error)
                        end
                    end)
                end
            end
        end

        SaveManager.Pending = Pending
        if next(Pending) and not SaveManager.PendingWatcher then
            SaveManager.PendingWatcher = task.spawn(function()
                local Rounds = 0
                while next(SaveManager.Pending) and Rounds < 75 and not Library.Unloaded do
                    Rounds += 1
                    task.wait(0.4)
                    for Index, Object in SaveManager.Pending do
                        local Registry = Object.type == "Toggle" and Library.Toggles or Library.Options
                        if Registry[Index] ~= nil then
                            SaveManager.Pending[Index] = nil
                            pcall(ElementParser[Object.type].Load, Index, Object)
                        end
                    end
                end
                SaveManager.PendingWatcher = nil
            end)
        end

        return true
    end

    function SaveManager:Load(ConfigName)
        if IsStringEmpty(ConfigName) then
            return false, "No config is selected"
        end

        local ConfigPath = GetConfigPath(ConfigName)
        if ConfigPath == false or not isfile(ConfigPath) then
            return false, "Config file does not exist"
        end

        local Success, Content = pcall(readfile, ConfigPath)
        if not Success then
            return false, "Failed to read config file"
        end

        return SaveManager:LoadJSON(Content)
    end

    function SaveManager:Delete(ConfigName)
        if IsStringEmpty(ConfigName) then
            return false, "No config is selected"
        end

        local ConfigPath = GetConfigPath(ConfigName)
        if ConfigPath == false or not isfile(ConfigPath) then
            return false, "Config file does not exist"
        end

        local Success, ErrorMessage = pcall(delfile, ConfigPath)
        if not Success then
            return false, "Failed to delete config file: " .. tostring(ErrorMessage)
        end

        if ConfigName == SaveManager.AutoloadConfig then
            SaveManager:DeleteAutoLoadConfig()
        end

        return true
    end

    --// Autoload \\--
    function SaveManager:GetAutoloadConfig()
        SaveManager:CheckFolderTree()

        local AutoloadPath = GetAutoloadPath()
        if AutoloadPath == false then
            return "none", false, "Invalid path provided"
        end
        if not isfile(AutoloadPath) then
            return "none", false, "Autoload config is not set"
        end

        local Success, Name = pcall(readfile, AutoloadPath)
        if not (Success and typeof(Name) == "string") then
            return "none", false, tostring(Name)
        end
        Name = Trim(Name)

        if not DoesConfigExist(Name) then
            return "none", false, "Config file not found"
        end

        SaveManager.AutoloadConfig = Name
        return Name, true
    end

    function SaveManager:SaveAutoloadConfig(ConfigName)
        if IsStringEmpty(ConfigName) then
            return false, "No config is selected"
        end

        SaveManager:CheckFolderTree()

        local AutoloadPath = GetAutoloadPath()
        if AutoloadPath == false then
            return false, "Invalid path provided"
        end
        if not DoesConfigExist(ConfigName) then
            return false, "Config does not exist"
        end

        local Success, ErrorMessage = pcall(writefile, AutoloadPath, ConfigName)
        if not Success then
            return false, tostring(ErrorMessage)
        end

        SaveManager.AutoloadConfig = ConfigName
        return true
    end

    function SaveManager:LoadAutoloadConfig()
        SaveManager.AutoloadAttempted = true
        local Name, Success, FetchError = SaveManager:GetAutoloadConfig()
        if not Success then
            if FetchError ~= "Autoload config is not set" then
                Notify(string.format("Failed to load autoload config: %s", tostring(FetchError)))
            end
            return
        end

        local LoadSuccess, LoadError = SaveManager:Load(Name)
        if not LoadSuccess then
            Notify(string.format("Failed to load autoload config: %s", tostring(LoadError)))
            return
        end

        if SaveManager.Library then
            SaveManager.Library:Notify({
                Title = "Config loaded",
                Description = string.format("Autoload config %q was applied.", Name),
                Icon = "folder-check",
                Time = 4,
            })
        end
    end

    function SaveManager:DeleteAutoLoadConfig()
        SaveManager:CheckFolderTree()

        local AutoloadPath = GetAutoloadPath()
        if AutoloadPath == false then
            return false, "Invalid path provided"
        end
        if not isfile(AutoloadPath) then
            return false, "Autoload config is not set"
        end

        local Success, ErrorMessage = pcall(delfile, AutoloadPath)
        if not Success then
            return false, tostring(ErrorMessage)
        end

        SaveManager.AutoloadConfig = nil
        return true
    end

    --// Interface \\--
    local function ShowDialog(Condition, Index, Title, Description, ActionText, Action, Variant)
        if Condition() == false then
            return Action()
        end

        local Window = SaveManager.Library and SaveManager.Library.Window
        if not (Window and Window.AddDialog) then
            return Action()
        end

        return Window:AddDialog(Index, {
            Title = Title,
            Description = Description,
            AutoDismiss = false,
            FooterButtons = {
                Cancel = {
                    Title = "Cancel",
                    Variant = "Ghost",
                    Order = 1,
                    Callback = function(Dialog)
                        Dialog:Dismiss()
                    end,
                },
                Confirm = {
                    Title = ActionText,
                    Variant = Variant or "Destructive",
                    Order = 2,
                    Callback = function(Dialog)
                        Dialog:Dismiss()
                        Action()
                    end,
                },
            },
        })
    end

    function SaveManager:BuildConfigSection(Tab, IconName)
