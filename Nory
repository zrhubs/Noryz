            })
            AddCorner(Box, 0.45)
            local BoxStroke = AddStroke(Box, "OutlineColor", 0)
            local BoxFill = New("Frame", {
                BackgroundColor3 = "WhiteColor",
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Parent = Box,
            })
            AddCorner(BoxFill, 0.45)
            AddAccentGradient(BoxFill, 45)
            local BoxCheck = MakeIcon("check", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                ImageColor3 = "WhiteColor",
                ImageTransparency = 1,
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(10, 10),
                ZIndex = 2,
                Parent = Box,
            })

            local Image = New("ImageLabel", {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, Info.Multi and 30 or 8, 0.5, 0),
                Size = UDim2.fromOffset(16, 16),
                Visible = false,
                Parent = Button,
            })

            local Text = New("TextLabel", {
                Position = UDim2.fromOffset(Info.Multi and 30 or 10, 0),
                Size = UDim2.new(1, Info.Multi and -38 or -34, 1, 0),
                Text = "",
                TextSize = 13.5,
                TextTransparency = 0.25,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = Button,
            })

            local Check = MakeIcon("check", {
                AnchorPoint = Vector2.new(1, 0.5),
                ImageColor3 = "AccentColor",
                ImageTransparency = 1,
                Position = UDim2.new(1, -8, 0.5, 0),
                Size = UDim2.fromOffset(13, 13),
                Visible = not Info.Multi,
                Parent = Button,
            })

            Row.Button = Button
            Row.Container = Button
            Row.Image = Image
            Row.Text = Text

            function Row:UpdateButton(Instant)
                local Entry = Row.Entry
                if not Entry then
                    return
                end

                local Selected = IsSelected(Entry)
                Row.Selected = Selected

                local Info2 = Instant and TweenInfo.new(0) or Library.TweenInfo
                Tween(Button, Info2, {
                    BackgroundTransparency = Selected and 0.35 or (Row.Hovering and not Entry.IsDisabled and 0.6 or 1),
                })
                Tween(Text, Info2, {
                    TextTransparency = Entry.IsDisabled and 0.7 or ((Selected or Row.Hovering) and 0 or 0.25),
                })
                SetTheme(Text, "TextColor3", Selected and not Info.Multi and Palette.AccentText or "FontColor")
                Tween(Check, Info2, { ImageTransparency = Selected and 0 or 1 })

                Tween(BoxFill, Info2, { BackgroundTransparency = Selected and 0 or 1 })
                Tween(BoxCheck, Info2, { ImageTransparency = Selected and 0 or 1 })
                SetTheme(BoxStroke, "Color", Selected and "AccentColor" or "OutlineColor")

                if Entry.ValueImage then
                    Image.ImageTransparency = Entry.IsDisabled and 0.7 or 0
                end
            end

            table.insert(Dropdown.Connections, Button.MouseButton1Click:Connect(function()
                local Entry = Row.Entry
                if not Entry or Entry.IsDisabled then
                    return
                end

                local Selected = IsSelected(Entry)
                local Try = not Selected

                if not (Dropdown:GetActiveValues(true) == 1 and not Try and not Info.AllowNull) then
                    if Info.Multi then
                        Dropdown.Value[Entry.Value] = Try and true or nil
                    else
                        Dropdown.Value = Try and Entry.Value or nil
                    end

                    for _, Other in Pool do
                        Other:UpdateButton()
                    end
                end

                Dropdown:Display()
                Library:UpdateDependencyBoxes()
                Dropdown:RunChanged()

                if not Info.Multi then
                    MenuTable:Close()
                end
            end))

            table.insert(Dropdown.Connections, Button.MouseEnter:Connect(function()
                Row.Hovering = true
                Row:UpdateButton()
            end))
            table.insert(Dropdown.Connections, Button.MouseLeave:Connect(function()
                Row.Hovering = false
                Row:UpdateButton()
            end))

            return Row
        end

        function Dropdown:RefreshPool()
            local Total = #FilteredEntries
            while #Pool < Total do
                table.insert(Pool, CreatePoolRow())
            end

            for Index, Row in Pool do
                local Entry = FilteredEntries[Index]
                Row.Entry = Entry
                Row.Index = Entry and Index or nil

                if not Entry then
                    Row.Button.Visible = false
                    continue
                end

                Row.Button.Visible = true
                Row.Button.LayoutOrder = Index
                Row.Text.Text = Entry.FormattedValue
                Row.Hovering = false

                local BaseX = Info.Multi and 30 or 10
                if Entry.ValueImage then
                    Row.Image.Visible = true
                    Library:ApplyLucideIcon(Row.Image, Entry.ValueImage)
                    Row.Text.Position = UDim2.fromOffset(BaseX + 22, 0)
                    Row.Text.Size = UDim2.new(1, -(BaseX + 22 + 26), 1, 0)
                else
                    Row.Image.Visible = false
                    Row.Text.Position = UDim2.fromOffset(BaseX, 0)
                    Row.Text.Size = UDim2.new(1, -(BaseX + 26), 1, 0)
                end

                Row:UpdateButton(true)
            end

            EmptyLabel.Visible = Total == 0
        end

        function Dropdown:RunChanged()
            if Dropdown.Disabled then
                return
            end
            Library:SafeCallback(Dropdown.Callback, Dropdown.Value)
            Library:SafeCallback(Dropdown.Changed, Dropdown.Value)
        end

        function Dropdown:BuildDropdownList()
            RecomputeFilteredEntries()
            MenuTable.Menu.CanvasPosition = Vector2.zero
            Dropdown:RefreshPool()
            Dropdown:RecalculateListSize(#FilteredEntries)
        end

        local function ValueExists(Value)
            if IsSequentialArray(Dropdown.Values) then
                for _, Existing in Dropdown.Values do
                    if Existing == Value then
                        return true
                    end
                end
                return false
            end
            return Dropdown.Values[Value] ~= nil
        end

        function Dropdown:SetValue(Value)
            if Info.Multi then
                if typeof(Value) == "string" then
                    Value = Value == "" and {} or { [Value] = true }
                end

                local Table = {}
                for Key, Active in Value or {} do
                    if typeof(Active) ~= "boolean" then
                        if ValueExists(Active) then
                            Table[Active] = true
                        end
                    elseif Active and ValueExists(Key) then
                        Table[Key] = true
                    end
                end
                Dropdown.Value = Table
            else
                if Value ~= nil and ValueExists(Value) then
                    Dropdown.Value = Value
                elseif not Value then
                    Dropdown.Value = nil
                end
            end

            Dropdown:Display()
            for _, Row in Pool do
                Row:UpdateButton()
            end

            if not Dropdown.Disabled then
                Library:UpdateDependencyBoxes()
            end

            Dropdown:RunChanged()
        end

        function Dropdown:SetValues(Values)
            Dropdown.Values = Values or {}

            local Changed = false
            if Info.Multi then
                for Value in Dropdown.Value do
                    if not ValueExists(Value) then
                        Dropdown.Value[Value] = nil
                        Changed = true
                    end
                end
            elseif Dropdown.Value ~= nil and not ValueExists(Dropdown.Value) then
                Dropdown.Value = nil
                Changed = true
            end

            Dropdown:BuildDropdownList()
            Dropdown:Display()

            if Changed then
                if not Dropdown.Disabled then
                    Library:UpdateDependencyBoxes()
                end
                Dropdown:RunChanged()
            end
        end

        function Dropdown:AddValues(Values)
            if typeof(Values) ~= "table" and typeof(Values) ~= "string" then
                return
            end

            local IsDictionary = not IsSequentialArray(Dropdown.Values) and next(Dropdown.Values) ~= nil
            if IsDictionary then
                if typeof(Values) == "string" then
                    Dropdown.Values[Values] = Values
                elseif IsSequentialArray(Values) then
                    for _, Value in Values do
                        Dropdown.Values[Value] = Value
                    end
                else
                    for Key, Value in Values do
                        Dropdown.Values[Key] = Value
                    end
                end
            else
                if typeof(Values) == "table" then
                    for _, Value in Values do
                        table.insert(Dropdown.Values, Value)
                    end
                else
                    table.insert(Dropdown.Values, Values)
                end
            end

            Dropdown:BuildDropdownList()
        end

        function Dropdown:SetDisabledValues(DisabledValues)
            Dropdown.DisabledValues = DisabledValues or {}
            Dropdown:BuildDropdownList()
        end

        function Dropdown:AddDisabledValues(DisabledValues)
            if typeof(DisabledValues) == "table" then
                for _, Value in DisabledValues do
                    table.insert(Dropdown.DisabledValues, Value)
                end
            elseif typeof(DisabledValues) == "string" then
                table.insert(Dropdown.DisabledValues, DisabledValues)
            else
                return
            end
            Dropdown:BuildDropdownList()
        end

        function Dropdown:SetValueImages(ValueImages)
            if typeof(ValueImages) ~= "table" then
                return
            end
            Dropdown.ValueImages = ValueImages
            Dropdown:BuildDropdownList()
            Dropdown:Display()
        end

        function Dropdown:AddValueImages(ValueImages)
            if typeof(ValueImages) ~= "table" then
                return
            end
            Dropdown.ValueImages = Dropdown.ValueImages or {}
            for Key, Value in ValueImages do
                Dropdown.ValueImages[Key] = Value
            end
            Dropdown:BuildDropdownList()
            Dropdown:Display()
        end

        function Dropdown:SetDisabled(Disabled)
            Dropdown.Disabled = Disabled
            if Dropdown.TooltipTable then
                Dropdown.TooltipTable.Disabled = Disabled
            end
            MenuTable:Close()
            DisplayContainer.Active = not Disabled
            Dropdown:UpdateColors()
            Dropdown:Display()
            Library:UpdateDependencyBoxes()
        end

        function Dropdown:SetVisible(Visible)
            Dropdown.Visible = Visible
            Holder.Visible = Visible
            Groupbox:Resize()
        end

        function Dropdown:SetText(Text)
            Dropdown.Text = Text
            Holder.Size = UDim2.new(1, 0, 0, Text and 50 or 29)
            Label.Text = Text or ""
            Label.Visible = Text ~= nil
        end

        function Dropdown:SetDragSelect(Value)
            if not Info.Multi or Library.IsMobile then
                Value = false
            end
            Dropdown.DragSelect = Value == true
        end

        table.insert(Dropdown.Connections, DisplayContainer.MouseButton1Click:Connect(function()
            if Dropdown.Disabled then
                return
            end
            if MenuTable.Active and SearchBox and SearchBox:IsFocused() then
                return
            end
            MenuTable:Toggle()
        end))
        table.insert(Dropdown.Connections, DisplayContainer.MouseEnter:Connect(function()
            Hovering = true
            RefreshDisplayVisual()
        end))
        table.insert(Dropdown.Connections, DisplayContainer.MouseLeave:Connect(function()
            Hovering = false
            RefreshDisplayVisual()
        end))

        if SearchBox then
            table.insert(Dropdown.Connections, SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                Dropdown:BuildDropdownList()
                MenuTable:Refresh()
            end))
        end

        --// Defaults \\--
        local Defaults = {}
        do
            local Default = Info.Default
            if Default ~= nil then
                local IsDictionary = not IsSequentialArray(Dropdown.Values)
                local function ResolveOne(Candidate)
                    if IsDictionary then
                        return Dropdown.Values[Candidate] ~= nil and Candidate or nil
                    end
                    for _, Existing in Dropdown.Values do
                        if Existing == Candidate then
                            return Existing
                        end
                    end
                    return nil
                end

                local DefaultType = typeof(Default)
                if DefaultType == "string" then
                    local Value = ResolveOne(Default)
                    if Value ~= nil then
                        table.insert(Defaults, Value)
                    end
                elseif DefaultType == "table" then
                    for _, Candidate in Default do
                        local Value = ResolveOne(Candidate)
                        if Value ~= nil then
                            table.insert(Defaults, Value)
                        end
                    end
                elseif Dropdown.Values[Default] ~= nil then
                    table.insert(Defaults, IsDictionary and Default or Dropdown.Values[Default])
                end
            end
        end

        for _, Value in Defaults do
            if Info.Multi then
                Dropdown.Value[Value] = true
            else
                Dropdown.Value = Value
                break
            end
        end

        if typeof(Dropdown.Tooltip) == "string" or typeof(Dropdown.DisabledTooltip) == "string" then
            Dropdown.TooltipTable = Library:AddTooltip(Dropdown.Tooltip, Dropdown.DisabledTooltip, DisplayContainer)
            Dropdown.TooltipTable.Disabled = Dropdown.Disabled
        end

        Dropdown:UpdateColors()
        Dropdown:Display()
        Dropdown:BuildDropdownList()

        Dropdown.Holder = Holder
        table.insert(Groupbox.Elements, Dropdown)

        Dropdown.Default = Defaults
        Dropdown.DefaultValues = Dropdown.Values
        Options[Idx] = Dropdown

        function Dropdown:Destroy()
            Dropdown.Destroyed = true
            for _, Connection in Dropdown.Connections do
                Connection:Disconnect()
            end
            if Dropdown.TooltipTable then
                Dropdown.TooltipTable:Destroy()
            end
            MenuTable:Destroy()
            Holder:Destroy()
            RemoveElement(Groupbox, Dropdown)
            Options[Idx] = nil
        end

        Groupbox:Resize()
        return Dropdown
    end

