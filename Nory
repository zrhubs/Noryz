                Text = "Auto-save",
                Default = Prefs.Data.AutoSave == true,
                Tooltip = "Remembers every option automatically and restores it the next time you run the script",
            })
            C.AutoSave = Internal(Toggles, "OnyxSettings_AutoSave")
            C.AutoSave:OnChanged(function(Value)
                if Settings.Guard then
                    return
                end
                Prefs:Set("AutoSave", Value)
                Settings.LastFingerprint = nil
                if Value then
                    Settings:AutoSaveNow()
                end
            end)

            Groupbox:AddInput("OnyxSettings_ConfigCode", {
                Text = "Config code",
                Placeholder = "paste a config code to import",
            })
            local CodeInput = Internal(Options, "OnyxSettings_ConfigCode")

            Groupbox:AddButton({
                Text = "Import",
                Icon = "download",
                Func = function()
                    local Content = CodeInput.Value
                    if typeof(Content) ~= "string" or Content:gsub("%s", "") == "" then
                        Notify("Nothing to import", "Paste a config code into the box above.", "info")
                        return
                    end
                    Confirm("OnyxSettings_ImportConfig", "Import config", "Apply the pasted config? Your current settings will be replaced.", "Import", "Primary", function()
                        local Ok, Error = SaveManager:LoadJSON(Content)
                        if not Ok then
                            Library:Notify({ Title = "Import failed", Description = tostring(Error), Type = "Error", Time = 4 })
                            return
                        end
                        CodeInput:SetValue("")
                        Library:Notify({ Title = "Config imported", Description = "Save it under a name to keep it.", Type = "Success", Time = 4 })
                    end)
                end,
            }):AddButton({
                Text = "Copy code",
                Icon = "copy",
                Func = function()
                    local Encoded = SaveManager:SaveJSON()
                    local Clipboard = setclipboard or toclipboard
                    if Clipboard and pcall(Clipboard, Encoded) then
                        Notify("Copied", "Share the code, others can import it here.", "copy")
                    else
                        CodeInput:SetValue(Encoded)
                    end
                end,
            })

            RefreshConfigs()
        end

        local function BuildPage()
            if Settings.Built then
                return
            end
            Settings.Built = true

            local PageName = ConfigSystem and "Settings" or "Appearance"
            local ExistingTab = Library.Tabs[PageName]
            local Tab = Window:AddTab({
                Name = PageName,
                Icon = ConfigSystem and "settings" or "palette",
                Description = ConfigSystem and "Configs, themes and appearance" or "Themes, colors and scale",
                Order = 100000,
            })
            -- not part of the script's own tabs (sidebar, search, configs)
            Library.Tabs[PageName] = ExistingTab
            Tab:SetVisible(false)
            Settings.Tab = Tab
            Window.SettingsTab = Tab

            local Show, Hide = Tab.Show, Tab.Hide
            function Tab:Show(...)
                Ui.SetActive(true)
                Settings:SyncControls()
                return Show(self, ...)
            end
            function Tab:Hide(...)
                Ui.SetActive(false)
                return Hide(self, ...)
            end

            local C = Settings.Controls
            local function Guarded(Callback)
                return function(...)
                    if Settings.Guard then
                        return
                    end
                    Callback(...)
                end
            end

            --// Layout: with configs -> left: Configs + My themes, right: Themes + Customize
            --//         without     -> left: Themes, right: Customize + My themes
            if ConfigSystem then
                local Configs = Tab:AddGroupbox({ Side = "Left", Name = "Configs", IconName = "folder-cog", Description = "Save, load and share your setup", PopOut = false })
                BuildConfigs(Configs)
            end

            local Themes = Tab:AddGroupbox({ Side = ConfigSystem and "Right" or "Left", Name = "Themes", IconName = "swatch-book", Description = "Pick a look, it is remembered", PopOut = false })
            BuildGallery(Themes)

            local Customize = Tab:AddGroupbox({ Side = "Right", Name = "Customize", IconName = "paintbrush", Description = "Fine tune the current theme", PopOut = false })

            Customize:AddLabel("Accent color"):AddColorPicker("OnyxSettings_AccentColor", {
                Default = Library.Scheme.AccentColor,
                Title = "Accent color",
            })
            C.AccentColor = Internal(Options, "OnyxSettings_AccentColor")
            BuildSwatches(Customize)
            Customize:AddDivider()

            local function ColorRow(Text, Key)
                Customize:AddLabel(Text):AddColorPicker("OnyxSettings_" .. Key, {
                    Default = Library.Scheme[Key],
                    Title = Text,
                })
                C[Key] = Internal(Options, "OnyxSettings_" .. Key)
            end
            ColorRow("Background", "BackgroundColor")
            ColorRow("Surface", "MainColor")
            ColorRow("Outline", "OutlineColor")
            ColorRow("Text", "FontColor")

            for _, Key in SchemeKeys do
                C[Key]:OnChanged(Guarded(function()
                    SetSchemeColor(Key, C[Key].Value)
                    SyncOwnedOptions()
                    SaveColors()
                    for _, Refresh in Swatches do
                        Refresh()
                    end
                end))
            end

            Customize:AddDivider()

            local FontList = {}
            for _, Name in FontChoices do
                if FontEnum(Name) then
                    table.insert(FontList, Name)
                end
            end
            local CurrentFont = ThemeManager.CurrentFontName or Prefs.Data.Font or "BuilderSans"
            Customize:AddDropdown("OnyxSettings_Font", {
                Text = "Font",
                Values = FontList,
                Default = table.find(FontList, CurrentFont) and CurrentFont or FontList[1],
            })
            C.Font = Internal(Options, "OnyxSettings_Font")
            C.Font:OnChanged(Guarded(function(Value)
                local Item = FontEnum(Value)
                if Item then
                    Library:SetFont(Item)
                    ThemeManager.CurrentFontName = Value
                    Prefs:Set("Font", Value)
                end
            end))

            Customize:AddSlider("OnyxSettings_Corner", {
                Text = "Corner radius",
                Min = 0,
                Max = 16,
                Rounding = 0,
                Default = Library.CornerRadius,
                Suffix = "px",
            })
            C.Corner = Internal(Options, "OnyxSettings_Corner")
            C.Corner:OnChanged(Guarded(function(Value)
                Window:SetCornerRadius(Value)
                Prefs:Set("Corner", Value)
            end))

            local CurrentScale = string.format("%d%%", math.floor(Library.DPIScale * 100 + 0.5))
            Customize:AddDropdown("OnyxSettings_Scale", {
                Text = "Interface scale",
                Values = ScaleChoices,
                Default = table.find(ScaleChoices, CurrentScale) and CurrentScale or "100%",
            })
            C.Scale = Internal(Options, "OnyxSettings_Scale")
            C.Scale:OnChanged(Guarded(function(Value)
                local Number = tonumber((tostring(Value):gsub("%%", "")))
                if Number then
                    Library:SetDPIScale(Number)
                    Prefs:Set("Scale", Number)
                end
            end))

            Customize:AddButton({
                Text = "Reset colors",
                Icon = "rotate-ccw",
                Func = function()
                    ApplyThemeByName(MatchingTheme() or "Default")
                    Notify("Colors reset", "Back to the original theme colors.", "rotate-ccw")
                end,
            })

            --// Right: saved themes and sharing \\--
            local Saved = Tab:AddGroupbox({ Side = ConfigSystem and "Left" or "Right", Name = "My themes", IconName = "bookmark", Description = "Save, share and import looks", PopOut = false })

            Saved:AddInput("OnyxSettings_ThemeName", {
                Text = "Theme name",
                Placeholder = "my theme",
            })
            local ThemeNameInput = Internal(Options, "OnyxSettings_ThemeName")

            Saved:AddButton({
                Text = "Save theme",
                Icon = "bookmark-plus",
                Func = function()
                    local Raw = ThemeNameInput.Value
                    local Name = SafeName(Raw)
                    if typeof(Raw) ~= "string" or Raw:gsub("%s", "") == "" or ThemeManager.BuiltInThemes[Name] then
                        Notify("Theme not saved", "Pick a name that is not one of the built-in themes.", "triangle-alert")
                        return
                    end
                    if not FileApi() then
                        Notify("Theme not saved", "Your executor has no file access.", "triangle-alert")
                        return
                    end
                    local Ok, Error = ThemeManager:SaveCustomTheme(Name)
                    if not Ok then
                        Notify("Theme not saved", tostring(Error), "triangle-alert")
                        return
                    end
                    Prefs:Set("Theme", Name)
                    Gallery.Rebuild()
                    ThemeNameInput:SetValue("")
                    Notify("Theme saved", string.format("%q was added to your themes.", Name), "palette")
                end,
            }):AddButton({
                Text = "Delete",
                Icon = "trash-2",
                Risky = true,
                Func = function()
                    local Name = Prefs.Data.Theme
                    if not Name or ThemeManager.BuiltInThemes[Name] then
                        Notify("Nothing to delete", "Select one of your saved themes in the gallery first.", "info")
                        return
                    end
                    Confirm("OnyxSettings_DeleteTheme", "Delete theme", string.format("Delete %q? This cannot be undone.", Name), "Delete", "Destructive", function()
                        ThemeManager:Delete(Name)
                        Prefs:Set("Theme", nil)
                        Gallery.Rebuild()
                    end)
                end,
            })

            Saved:AddDivider()

            Saved:AddInput("OnyxSettings_ThemeCode", {
                Text = "Theme code",
                Placeholder = "paste a theme code to import",
            })
            local ThemeCodeInput = Internal(Options, "OnyxSettings_ThemeCode")

            Saved:AddButton({
                Text = "Import",
                Icon = "download",
                Func = function()
                    local Content = ThemeCodeInput.Value
                    if typeof(Content) ~= "string" or Content:gsub("%s", "") == "" then
                        Notify("Nothing to import", "Paste a theme code into the box above.", "info")
                        return
                    end
                    local Ok, Error = ThemeManager:LoadJSON(Content)
                    if not Ok then
                        Notify("Import failed", tostring(Error), "triangle-alert")
                        return
                    end
                    ThemeCodeInput:SetValue("")
                    Prefs:Set("Theme", nil)
                    Prefs:Set("Colors", CurrentColors())
                    Settings:SyncControls()
                    Notify("Theme imported", "Save it under a name to keep it in your gallery.", "download")
                end,
            }):AddButton({
                Text = "Copy code",
                Icon = "copy",
                Func = function()
                    local Encoded = ThemeManager:SaveJSON()
                    local Clipboard = setclipboard or toclipboard
                    if Clipboard and pcall(Clipboard, Encoded) then
                        Notify("Copied", "Share the code, others can import it here.", "copy")
                    else
                        ThemeCodeInput:SetValue(Encoded)
                    end
                end,
            })
        end

        function Settings:Open()
            BuildPage()
            if Library.ActiveTab == Settings.Tab then
                local Previous = Library.PreviousTab
                if Previous and Previous ~= Settings.Tab and not Previous.Destroyed then
                    Previous:Show()
                else
                    for _, Other in Library.Tabs do
                        if Other ~= Settings.Tab then
                            Other:Show()
                            break
                        end
                    end
                end
                return
            end
            if Settings.RefreshConfigs then
                Settings.RefreshConfigs()
            end
            Settings.Tab:Show()
        end

        function Window:OpenSettings()
            Settings:Open()
        end
        Window.OpenThemes = Window.OpenSettings

        Ui.Button.MouseButton1Click:Connect(function()
            Settings:Open()
        end)

        --// Startup restore + auto-save loop (only with the config system) \\--
        if ConfigSystem then
            task.spawn(function()
                -- wait until the script has finished creating its elements
                local LastCount, Stable = -1, 0
                for _ = 1, 50 do
                    task.wait(0.3)
                    if Library.Unloaded then
                        return
                    end
                    local Count = 0
                    for _ in Library.Options do
                        Count += 1
                    end
                    for _ in Library.Toggles do
                        Count += 1
                    end
                    Stable = Count == LastCount and Stable + 1 or 0
                    LastCount = Count
                    if Stable >= 3 then
                        break
                    end
                end

                -- a script that loads configs itself (SaveManager:LoadAutoloadConfig) keeps control
                if not SaveManager.AutoloadAttempted and FileApi() and FolderExists(SaveManager.Folder) then
                    if Prefs.Data.AutoSave == true and ConfigExists(AutoSaveName) then
                        pcall(SaveManager.Load, SaveManager, AutoSaveName)
                    elseif AutoloadName() then
                        SaveManager:LoadAutoloadConfig()
                    end
                end

                task.wait(1)
                Settings.LastFingerprint = Fingerprint()
                while not Library.Unloaded do
                    task.wait(2)
                    Settings:AutoSaveNow()
                end
            end)

            Library:OnUnload(function()
                pcall(Settings.AutoSaveNow, Settings, true)
            end)
        end

        return Settings
    end
end

do
    local Env = getgenv()
    Env.Library = Library
    Env.OnyxLibrary = Library
    Env.Toggles = Toggles
    Env.Options = Options
end

return Library

