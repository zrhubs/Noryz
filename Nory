local function GetCoreGuiInset()
    local Success, Inset = pcall(function()
        return game:GetService("GuiService"):GetGuiInset()
    end)
    if Success and typeof(Inset) == "Vector2" then
        return Inset
    end
    return Vector2.new(0, 36)
end

local function GetViewportSize()
    local Camera = workspace.CurrentCamera
    return Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
end

local function GetOverlappingDraggable(UI, TargetPosition)
    local Pos1 = TargetPosition or UI.AbsolutePosition
    local Size1 = UI.AbsoluteSize

    for _, Other in Library.DraggableElements do
        if Other == UI or not Other.Parent or not Other.Visible then
            continue
        end

        local Pos2, Size2 = Other.AbsolutePosition, Other.AbsoluteSize
        if Pos1.X < Pos2.X + Size2.X and Pos1.X + Size1.X > Pos2.X and Pos1.Y < Pos2.Y + Size2.Y and Pos1.Y + Size1.Y > Pos2.Y then
            return Other
        end
    end

    return nil
end

local function PositionDraggable(UI)
    task.defer(function()
        if not UI.Parent then
            return
        end

        local Attempts = 0
        local Target = UI.AbsolutePosition
        local Other = GetOverlappingDraggable(UI, Target)
        while Other and Attempts < 12 do
            Attempts += 1
            Target = Vector2.new(Target.X, Other.AbsolutePosition.Y + Other.AbsoluteSize.Y + 8)
            Other = GetOverlappingDraggable(UI, Target)
        end

        if Attempts > 0 then
            local Delta = Target - UI.AbsolutePosition
            UI.Position = UDim2.new(UI.Position.X.Scale, UI.Position.X.Offset + Delta.X, UI.Position.Y.Scale, UI.Position.Y.Offset + Delta.Y)
        end
    end)
end

local function GetSnapTargets(ElementSize, ViewportSize, Margin, AvoidCoreGui)
    local TopMargin = Margin
    if AvoidCoreGui then
        TopMargin = Margin
    end

    local TargetsX = {
        { Name = "left", Value = Margin },
        { Name = "center", Value = (ViewportSize.X - ElementSize.X) / 2 },
        { Name = "right", Value = ViewportSize.X - ElementSize.X - Margin },
    }
    local TargetsY = {
        { Name = "top", Value = TopMargin },
        { Name = "center", Value = (ViewportSize.Y - ElementSize.Y) / 2 },
        { Name = "bottom", Value = ViewportSize.Y - ElementSize.Y - Margin },
    }
    return TargetsX, TargetsY
end

local function GetClosestSnap(Value, Targets, Distance)
    local Best, BestName, BestDistance = nil, nil, Distance
    for _, Target in Targets do
        local Diff = math.abs(Value - Target.Value)
        if Diff <= BestDistance then
            Best, BestName, BestDistance = Target.Value, Target.Name, Diff
        end
    end
    return Best, BestName
end

--// Critically damped spring (frame-rate independent). Gives dragging a soft, weighty follow
--// without overshoot, identical at 30 or 240 fps.
local function SmoothDamp(Current, Target, Velocity, SmoothTime, DeltaTime)
    SmoothTime = math.max(SmoothTime, 0.0001)
    local Omega = 2 / SmoothTime
    local X = Omega * DeltaTime
    local Exp = 1 / (1 + X + 0.48 * X * X + 0.235 * X * X * X)
    local Change = Current - Target
    local Temp = (Velocity + Omega * Change) * DeltaTime
    local NewVelocity = (Velocity - Omega * Temp) * Exp
    local Output = Target + (Change + Temp) * Exp
    if (Target - Current > 0) == (Output > Target) then
        Output = Target
        NewVelocity = 0
    end
    return Output, NewVelocity
end

function Library:MakeDraggable(UI, DragFrame, IgnoreToggled, IsMainWindow, SnapConfig, Hooks)
    local Dragging = false
    local DragInput = nil
    local StartMouse, StartOffset
    local Target, Current = nil, nil
    local VelocityX, VelocityY = 0, 0
    local SmoothConnection = nil
    local EndConnection = nil

    local function GetBase()
        local Parent = UI.Parent
        local ParentPos, ParentSize = Vector2.zero, GetViewportSize()
        if Parent and Parent:IsA("GuiBase2d") then
            ParentPos, ParentSize = Parent.AbsolutePosition, Parent.AbsoluteSize
        end
        local Size, Anchor, Pos = UI.AbsoluteSize, UI.AnchorPoint, UI.Position
        local BaseX = ParentPos.X + Pos.X.Scale * ParentSize.X - Anchor.X * Size.X
        local BaseY = ParentPos.Y + Pos.Y.Scale * ParentSize.Y - Anchor.Y * Size.Y
        return BaseX, BaseY, ParentPos, ParentSize, Size
    end

    --// keeps windows reachable: the main window keeps its header on screen, small panels stay fully visible
    local function Constrain(OffsetX, OffsetY)
        local BaseX, BaseY, ParentPos, ParentSize, Size = GetBase()
        local Left, Top = BaseX + OffsetX, BaseY + OffsetY

        if SnapConfig and SnapConfig.Enabled then
            local Viewport = ParentSize
            local TargetsX, TargetsY = GetSnapTargets(Size, Viewport, SnapConfig.Margin or 8, SnapConfig.AvoidCoreGui ~= false)
            local SnapX = GetClosestSnap(Left - ParentPos.X, TargetsX, SnapConfig.Distance or 24)
            local SnapY = GetClosestSnap(Top - ParentPos.Y, TargetsY, SnapConfig.Distance or 24)
            if SnapX then
                Left = ParentPos.X + SnapX
            end
            if SnapY then
                Top = ParentPos.Y + SnapY
            end
        end

        if Library.ClampDraggables ~= false then
            local MinX, MaxX, MinY, MaxY
            if IsMainWindow then
                local KeepX = math.min(Size.X, 160)
                MinX, MaxX = ParentPos.X - Size.X + KeepX, ParentPos.X + ParentSize.X - KeepX
                MinY, MaxY = ParentPos.Y, ParentPos.Y + ParentSize.Y - math.min(Size.Y, 64)
            else
                MinX, MaxX = ParentPos.X + 4, ParentPos.X + ParentSize.X - Size.X - 4
                MinY, MaxY = ParentPos.Y + 4, ParentPos.Y + ParentSize.Y - Size.Y - 4
            end
            Left = math.clamp(Left, MinX, math.max(MinX, MaxX))
            Top = math.clamp(Top, MinY, math.max(MinY, MaxY))
        end

        return Left - BaseX, Top - BaseY
    end

    local function Write(X, Y)
        local Pos = UI.Position
        UI.Position = UDim2.new(Pos.X.Scale, math.floor(X + 0.5), Pos.Y.Scale, math.floor(Y + 0.5))
    end

    local function StopSmooth()
        if SmoothConnection then
            SmoothConnection:Disconnect()
            SmoothConnection = nil
        end
    end

    local function StartSmooth()
        if SmoothConnection then
            return
        end

        SmoothConnection = RunService.RenderStepped:Connect(function(DeltaTime)
            if not (Target and Current) or not UI.Parent then
                StopSmooth()
                return
            end

            DeltaTime = math.clamp(DeltaTime, 1 / 480, 1 / 20)
            local SmoothTime = math.max(tonumber(Library.DragSmoothness) or 0.045, 0.001)
            if not Dragging then
                SmoothTime *= 1.2
            end

            local X, Y
            X, VelocityX = SmoothDamp(Current.X, Target.X, VelocityX, SmoothTime, DeltaTime)
            Y, VelocityY = SmoothDamp(Current.Y, Target.Y, VelocityY, SmoothTime, DeltaTime)
            Current = Vector2.new(X, Y)

            if not Dragging and math.abs(Target.X - X) < 0.5 and math.abs(Target.Y - Y) < 0.5 then
                Current = Target
                VelocityX, VelocityY = 0, 0
                Write(Target.X, Target.Y)
                StopSmooth()
                return
            end

            Write(X, Y)
        end)
    end

    local function EndDrag()
        local Was = Dragging
        Dragging = false
        DragInput = nil
        if EndConnection then
            EndConnection:Disconnect()
            EndConnection = nil
        end
        if Was and Hooks and Hooks.End then
            task.spawn(Hooks.End)
        end
    end

    local BeganConnection = DragFrame.InputBegan:Connect(function(Input)
        if not IsClickInput(Input) then
            return
        end
        if IsMainWindow and Library.CantDragForced then
            return
        end
        if not IgnoreToggled and not Library.Toggled then
            return
        end

        Dragging = true
        DragInput = Input
        StartMouse = Vector2.new(Input.Position.X, Input.Position.Y)

        --// when the previous drag is still settling, continue from where it is heading so nothing jumps
        if not (SmoothConnection and Target) then
            Current = Vector2.new(UI.Position.X.Offset, UI.Position.Y.Offset)
            Target = Current
            VelocityX, VelocityY = 0, 0
        end
        StartOffset = Target

        if Hooks and Hooks.Start then
            task.spawn(Hooks.Start)
        end

        if EndConnection then
            EndConnection:Disconnect()
        end
        EndConnection = Input.Changed:Connect(function()
            if Input.UserInputState == Enum.UserInputState.End then
                EndDrag()
            end
        end)
    end)

    local ChangedConnection = UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then
            return
        end

        if (not IgnoreToggled and not Library.Toggled) or (IsMainWindow and Library.CantDragForced) or not ScreenGui.Parent then
            EndDrag()
            return
        end

        if not (Input == DragInput or Input.UserInputType == Enum.UserInputType.MouseMovement) then
            return
        end
        if not IsHoverInput(Input) and Input ~= DragInput then
            return
        end

        local NewX = StartOffset.X + (Input.Position.X - StartMouse.X)
        local NewY = StartOffset.Y + (Input.Position.Y - StartMouse.Y)
        NewX, NewY = Constrain(NewX, NewY)
        Target = Vector2.new(NewX, NewY)

        if Library.SmoothDragging then
            StartSmooth()
        else
            StopSmooth()
            Current = Target
            Write(NewX, NewY)
        end
    end)

    Library:GiveSignal(BeganConnection)
    Library:GiveSignal(ChangedConnection)

    UI.Destroying:Connect(function()
        StopSmooth()
        EndDrag()
        BeganConnection:Disconnect()
        ChangedConnection:Disconnect()
    end)

    return {
        IsDragging = function()
            return Dragging
        end,
        Stop = function()
            EndDrag()
            Target = nil
            StopSmooth()
        end,
    }
end

function Library:MakeResizable(UI, DragFrame, Callback)
    local Dragging = false
    local DragInput, StartMouse, StartSize
    local EndConnection

    local BeganConnection = DragFrame.InputBegan:Connect(function(Input)
        if not IsClickInput(Input) then
            return
        end

        Dragging = true
        DragInput = Input
        StartMouse = Input.Position
        StartSize = UI.Size
        Library.CantDragForced = true

        if EndConnection then
            EndConnection:Disconnect()
        end
        EndConnection = Input.Changed:Connect(function()
            if Input.UserInputState == Enum.UserInputState.End then
                Dragging = false
                Library.CantDragForced = Library.LockedDragging == true
                EndConnection:Disconnect()
                EndConnection = nil
            end
        end)
    end)

    local ChangedConnection = UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then
            return
        end
        if not UI.Visible or not ScreenGui.Parent then
            Dragging = false
            return
        end
        if not (Input == DragInput or Input.UserInputType == Enum.UserInputType.MouseMovement) then
            return
        end

        local Scale = math.max(Library.DPIScale, 0.01)
        local Delta = (Input.Position - StartMouse) / Scale
        local Viewport = GetViewportSize() / Scale
        UI.Size = UDim2.new(
            StartSize.X.Scale,
            math.clamp(StartSize.X.Offset + Delta.X, Library.OriginalMinSize.X, math.max(Library.OriginalMinSize.X, Viewport.X - 16)),
            StartSize.Y.Scale,
            math.clamp(StartSize.Y.Offset + Delta.Y, Library.OriginalMinSize.Y, math.max(Library.OriginalMinSize.Y, Viewport.Y - 16))
        )

        if Callback then
            Library:SafeCallback(Callback)
        end
    end)

    Library:GiveSignal(BeganConnection)
    Library:GiveSignal(ChangedConnection)

    UI.Destroying:Connect(function()
        BeganConnection:Disconnect()
        ChangedConnection:Disconnect()
        if EndConnection then
            EndConnection:Disconnect()
        end
    end)
end

