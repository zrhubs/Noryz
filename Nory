--// Mouse controller \\--
-- While the menu is open the cursor has to be free (even in first person / gun games), and the moment
-- it closes the game must get back the mouse state it wants *right now*.
-- The previous snapshot approach restored whatever the game had when the menu was opened, which is
-- stale if the game locked the mouse while the menu was up (respawn, round start, equipping a gun...).
-- Here every frame we look at what the game wrote since our last write and remember it, so on close
-- the latest game value is handed back. GuiButton.Modal is used as well, which is how Roblox itself
-- frees the cursor in first person; when it turns off the engine falls back to the game's own state.
local MouseController = {
    Active = false,
    Unlock = true,
    GameBehavior = nil,
    GameIconEnabled = nil,
    WrittenIcon = nil,
    Binding = Library.ShowCursorBinding,
    GuardBinding = Library.ShowCursorBinding .. "Guard",
}
Library.MouseController = MouseController

local function ReadMouse()
    local Behavior, IconEnabled
    pcall(function()
        Behavior = UserInputService.MouseBehavior
        IconEnabled = UserInputService.MouseIconEnabled
    end)
    return Behavior, IconEnabled
end

function MouseController:Step()
    local Behavior, IconEnabled = ReadMouse()

    if self.Unlock and Behavior ~= nil and Behavior ~= Enum.MouseBehavior.Default then
        -- anything other than Default at this point was written by the game since our last frame
        self.GameBehavior = Behavior
        pcall(function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end)
    end

    if not Library.IsMobile then
        if self.WrittenIcon ~= nil and IconEnabled ~= nil and IconEnabled ~= self.WrittenIcon then
            self.GameIconEnabled = IconEnabled
        end

        local ShowCustom = Library.ShowCustomCursor == true
        local WantIcon = not ShowCustom
        if IconEnabled ~= WantIcon then
            pcall(function()
                UserInputService.MouseIconEnabled = WantIcon
            end)
        end
        self.WrittenIcon = WantIcon

        if Cursor then
            Cursor.Visible = ShowCustom
            if ShowCustom then
                Cursor.Position = UDim2.fromOffset(Mouse.X, Mouse.Y)
            end
        end
    end
end

function MouseController:Open(Unlock)
    self.Unlock = Unlock ~= false

    if not self.Active then
        self.Active = true
        local Behavior, IconEnabled = ReadMouse()
        self.GameBehavior = Behavior
        self.GameIconEnabled = IconEnabled
        self.WrittenIcon = nil
    end

    pcall(function()
        RunService:UnbindFromRenderStep(self.GuardBinding)
    end)
    ModalElement.Modal = self.Unlock

    pcall(function()
        RunService:UnbindFromRenderStep(self.Binding)
    end)
    -- Last + 1 so we run after the camera scripts (they may re-lock the mouse every frame)
    RunService:BindToRenderStep(self.Binding, Enum.RenderPriority.Last.Value + 1, function()
        if Library.Unloaded or not Library.Toggled or not ScreenGui.Parent then
            self:Close()
            return
        end
        self:Step()
    end)
    self:Step()
end

function MouseController:Close()
    pcall(function()
        RunService:UnbindFromRenderStep(self.Binding)
    end)
    ModalElement.Modal = false
    if Cursor then
        Cursor.Visible = false
    end

    if not self.Active then
        return
    end
    self.Active = false

    local Target = self.GameBehavior
    if typeof(Library.MouseBehaviorOnClose) == "EnumItem" then
        Target = Library.MouseBehaviorOnClose
    end

    if self.Unlock and Target ~= nil then
        pcall(function()
            UserInputService.MouseBehavior = Target
        end)
    end
    if self.WrittenIcon ~= nil and self.GameIconEnabled ~= nil then
        pcall(function()
            UserInputService.MouseIconEnabled = self.GameIconEnabled
        end)
    end
    self.WrittenIcon = nil

    -- Guard for a few frames: if something left the cursor unlocked right after closing
    -- (another UI's binding, a frame-order race), lock it back to what the game wanted.
    if self.Unlock and Target ~= nil and Target ~= Enum.MouseBehavior.Default then
        local Frames = 0
        pcall(function()
            RunService:BindToRenderStep(self.GuardBinding, Enum.RenderPriority.Last.Value + 2, function()
                Frames += 1
                if Library.Toggled or Library.Unloaded or Frames > 4 then
                    pcall(function()
                        RunService:UnbindFromRenderStep(self.GuardBinding)
                    end)
                    return
                end
                if UserInputService.MouseBehavior == Enum.MouseBehavior.Default then
                    UserInputService.MouseBehavior = Target
                end
            end)
        end)
    end
end

