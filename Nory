local CurrentHoverInstance = nil
local TooltipFollow = nil

local function HideTooltip()
    if TooltipFollow then
        TooltipFollow:Disconnect()
        TooltipFollow = nil
    end
    TooltipFrame.Visible = false
    CurrentHoverInstance = nil
end

local function PositionTooltip()
    local Viewport = GetViewportSize()
    local Inset = GetCoreGuiInset()
    local X = Mouse.X + (Library.ShowCustomCursor and 12 or 16)
    local Y = Mouse.Y + (Library.ShowCustomCursor and 12 or 18)
    local Size = TooltipFrame.AbsoluteSize
    if X + Size.X > Viewport.X - 6 then
        X = Mouse.X - Size.X - 10
    end
    if Y + Size.Y > Viewport.Y - Inset.Y - 6 then
        Y = Mouse.Y - Size.Y - 10
    end
    TooltipFrame.Position = UDim2.fromOffset(X, Y)
end

function Library:AddTooltip(InfoStr, DisabledInfoStr, HoverInstance)
    local TooltipTable = {
        Disabled = false,
        Hovering = false,
        Signals = {},
    }

    local function DoHover()
        if CurrentHoverInstance == HoverInstance then
            return
        end
        if Library.ActiveDialog and not HoverInstance:IsDescendantOf(Library.ActiveDialog.Frame or ScreenGui) then
            return
        end
        if CurrentMenu and Library:MouseIsOverFrame(CurrentMenu.Menu, Mouse) then
            return
        end

        local Text = TooltipTable.Disabled and DisabledInfoStr or InfoStr
        if typeof(Text) ~= "string" or Text == "" then
            return
        end

        HideTooltip()
        CurrentHoverInstance = HoverInstance
        TooltipTable.Hovering = true

        local HolderGui = HoverInstance:FindFirstAncestorOfClass("ScreenGui")
        if HolderGui and HolderGui ~= ScreenGui and Library.ActiveLoading and HolderGui == Library.ActiveLoading.ScreenGui then
            TooltipFrame.Parent = HolderGui
        else
            TooltipFrame.Parent = TooltipLayer
        end

        TooltipLabel.Text = Text
        TooltipFrame.BackgroundTransparency = 1
        TooltipLabel.TextTransparency = 1
        TooltipStroke.Transparency = 1
        TooltipFrame.Visible = true
        PositionTooltip()

        Tween(TooltipFrame, Library.TweenInfo, { BackgroundTransparency = 0 })
        Tween(TooltipLabel, Library.TweenInfo, { TextTransparency = 0.08 })
        Tween(TooltipStroke, Library.TweenInfo, { Transparency = 0 })

        TooltipFollow = RunService.RenderStepped:Connect(function()
            local Visible = (Library.Toggled or Library.ActiveLoading ~= nil)
                and HoverInstance.Parent ~= nil
                and HoverInstance.Visible
                and Library:MouseIsOverFrame(HoverInstance, Mouse)
                and not (CurrentMenu and Library:MouseIsOverFrame(CurrentMenu.Menu, Mouse))

            if not Visible then
                TooltipTable.Hovering = false
                if CurrentHoverInstance == HoverInstance then
                    HideTooltip()
                end
                return
            end

            PositionTooltip()
        end)
    end

    local function GiveSignal(Connection)
        table.insert(TooltipTable.Signals, Connection)
        return Connection
    end

    GiveSignal(HoverInstance.MouseEnter:Connect(DoHover))
    GiveSignal(HoverInstance.MouseMoved:Connect(DoHover))
    GiveSignal(HoverInstance.MouseLeave:Connect(function()
        TooltipTable.Hovering = false
        if CurrentHoverInstance == HoverInstance then
            HideTooltip()
        end
    end))

    function TooltipTable:Destroy()
        for Index = #TooltipTable.Signals, 1, -1 do
            local Connection = table.remove(TooltipTable.Signals, Index)
            if Connection and Connection.Connected then
                Connection:Disconnect()
            end
        end
        if CurrentHoverInstance == HoverInstance then
            HideTooltip()
        end
    end

    table.insert(Tooltips, TooltipTable)
    return TooltipTable
end

function Library:OnUnload(Callback)
    table.insert(Library.UnloadSignals, Callback)
end

