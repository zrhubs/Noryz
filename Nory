        Data.Closable = Info.Closable == true

        Data.Icon = Info.Icon
        Data.BigIcon = Info.BigIcon
        Data.IconColor = Info.IconColor

        --// Type = "Success" | "Warning" | "Error" | "Info" picks a matching icon and color
        local Preset = typeof(Info.Type) == "string" and NotificationTypes[Info.Type:lower()]
        if Preset then
            Data.Icon = Data.Icon or Preset.Icon
            if typeof(Data.IconColor) ~= "Color3" and Preset.Color then
