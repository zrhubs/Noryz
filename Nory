            ["One Dark"] = { 16, { FontColor = "d7dae0", MainColor = "2c313a", AccentColor = "61afef", BackgroundColor = "21252b", OutlineColor = "3e4451", BackgroundImage = "" } },
            ["Light"] = { 17, { FontColor = "1c1d26", MainColor = "e9eaf0", AccentColor = "5b6cff", BackgroundColor = "f8f8fb", OutlineColor = "d4d6e0", BackgroundImage = "" } },
        },
    }

    function ThemeManager:SetLibrary(Library)
        ThemeManager.Library = Library
    end

    --// Helpers \\--
    local function Trim(Text)
        return (tostring(Text):match("^%s*(.-)%s*$"))
    end

    local function IsStringEmpty(Text)
        return typeof(Text) ~= "string" or Trim(Text) == ""
    end

    local function IsValidFolderPath(Name)
        return typeof(Name) == "string" and Trim(Name) ~= "" and not Name:find('[<>:"|%?%*%z]')
    end

    local function Notify(...)
        if ThemeManager.Library and ThemeManager.Library.Notify then
            ThemeManager.Library:Notify(...)
        end
    end

    local function Linearize(Channel)
        if Channel <= 0.03928 then
            return Channel / 12.92
        end
        return ((Channel + 0.055) / 1.055) ^ 2.4
    end

    local function RelativeLuminance(Color)
        return 0.2126 * Linearize(Color.R) + 0.7152 * Linearize(Color.G) + 0.0722 * Linearize(Color.B)
    end

    local function ContrastRatio(A, B)
        local LA, LB = RelativeLuminance(A), RelativeLuminance(B)
        return (math.max(LA, LB) + 0.05) / (math.min(LA, LB) + 0.05)
    end

    local function IsValidThemeData(Data)
        if typeof(Data) ~= "table" then
            return false
        end
        for _, Index in SchemeIndexes do
            if typeof(Data[Index]) ~= "string" then
                return false
            end
        end
        return true
    end

    local function ParseHex(Value)
        if typeof(Value) == "Color3" then
            return Value
        end
        if typeof(Value) ~= "string" then
            return nil
        end
        local Success, Color = pcall(Color3.fromHex, (Value:gsub("#", "")))
        return Success and Color or nil
    end

    --// Paths \\--
    local function SplitPath(Path)
        local Result, Current = {}, ""
        for Part in string.gmatch(Path, "[^/]+") do
            Current = Current == "" and Part or (Current .. "/" .. Part)
            table.insert(Result, Current)
        end
        return Result
    end

    local function GetThemesPath()
        if IsStringEmpty(ThemeManager.Folder) then
            return false
        end
        return string.format("%s/themes", ThemeManager.Folder)
    end

    local function GetThemePath(ThemeName)
        local Path = GetThemesPath()
        if Path == false then
            return false
        end
        return string.format("%s/%s.json", Path, ThemeName)
    end

    local function GetDefaultThemePath()
        local Path = GetThemesPath()
        if Path == false then
            return false
        end
        return string.format("%s/default.txt", Path)
    end

    local function DoesThemeExist(ThemeName)
        if ThemeManager.BuiltInThemes[ThemeName] then
            return true
        end
        local Path = GetThemePath(ThemeName)
        return Path ~= false and isfile(Path)
    end

    function ThemeManager:GetPaths()
        local Path = GetThemesPath()
        return Path == false and {} or SplitPath(Path)
    end

    function ThemeManager:BuildFolderTree(SkipWhenCreated)
        if not (isfolder and makefolder) then
            return false
        end

        local Paths = ThemeManager:GetPaths()
        if #Paths == 0 then
            return false
        end
        if SkipWhenCreated == true and isfolder(Paths[#Paths]) then
            return true
        end

        for _, Path in Paths do
            if not isfolder(Path) then
                pcall(makefolder, Path)
            end
        end
        return true
    end

    function ThemeManager:CheckFolderTree()
        return ThemeManager:BuildFolderTree(true)
    end

    function ThemeManager:SetFolder(Folder)
        assert(IsValidFolderPath(Folder), "Invalid path provided")
        ThemeManager.FolderCustomized = true
        ThemeManager.Folder = Folder
        ThemeManager:BuildFolderTree()
    end

    --// Custom themes \\--
    function ThemeManager:ReloadCustomThemes()
        local Path = GetThemesPath()
        if Path == false or not listfiles then
            return {}
        end

        if makefolder and not isfolder(Path) then
            pcall(makefolder, Path)
        end

        local Success, Files = pcall(listfiles, Path)
        if not (Success and typeof(Files) == "table") then
            Notify(string.format("Failed to load theme list: %s", tostring(Files)))
            return {}
        end

        local Names = {}
        for _, FilePath in Files do
            FilePath = tostring(FilePath):gsub("\\", "/")
            local Name = FilePath:match("([^/]+)%.json$")
            if Name and Name ~= "default" then
                table.insert(Names, Name)
            end
        end
        table.sort(Names, function(A, B)
            return A:lower() < B:lower()
        end)
        return Names
    end

    function ThemeManager:GetCustomTheme(ThemeName)
        if IsStringEmpty(ThemeName) then
            return nil
        end

        local Path = GetThemePath(ThemeName)
        if Path == false or not isfile(Path) then
            return nil
        end

        local ReadSuccess, Content = pcall(readfile, Path)
        if not ReadSuccess then
            return nil
        end

        local DecodeSuccess, Decoded = pcall(HttpService.JSONDecode, HttpService, Content)
        if not DecodeSuccess or typeof(Decoded) ~= "table" then
            return nil
        end

        return Decoded
    end

    local function BuildCurrentThemeData()
        local Library = ThemeManager.Library
        local Owned = ThemeManager.OwnedOptions
        local Data = {
            FontFace = Owned.FontFace and Owned.FontFace.Value or ThemeManager.CurrentFontName or "BuilderSans",
            BackgroundImage = Owned.BackgroundImage and Owned.BackgroundImage.Value or ThemeManager.CurrentBackgroundImage or "",
        }
        for _, Index in SchemeIndexes do
            local Option = Owned[Index]
            Data[Index] = (Option and Option.Value or Library.Scheme[Index]):ToHex()
        end
        return Data
    end

    function ThemeManager:SaveJSON()
        local Success, Encoded = pcall(HttpService.JSONEncode, HttpService, BuildCurrentThemeData())
        if not Success then
            return "", false, "Failed to encode data"
        end
        return Encoded, true
    end

    function ThemeManager:SaveCustomTheme(ThemeName)
        if IsStringEmpty(ThemeName) or ThemeName:lower() == "default" then
            return false, "Invalid theme name provided"
        end

        local Path = GetThemePath(ThemeName)
        if Path == false then
            return false, "Invalid theme name provided"
        end

        ThemeManager:CheckFolderTree()

        local Encoded, Success, ErrorMessage = ThemeManager:SaveJSON()
        if not Success then
            return false, ErrorMessage
        end

        local WriteSuccess, WriteError = pcall(writefile, Path, Encoded)
        if not WriteSuccess then
            return false, "Failed to write theme file: " .. tostring(WriteError)
        end

        return true
    end

    function ThemeManager:Delete(ThemeName)
        if IsStringEmpty(ThemeName) then
            return false, "No theme is selected"
        end

        local Path = GetThemePath(ThemeName)
        if Path == false or not isfile(Path) then
            return false, "Theme file does not exist"
        end

        local Success, ErrorMessage = pcall(delfile, Path)
        if not Success then
            return false, "Failed to delete theme file: " .. tostring(ErrorMessage)
        end

        if ThemeName == ThemeManager.DefaultThemeName then
            ThemeManager:DeleteDefaultTheme()
        end
        return true
    end

    --// Default theme \\--
    function ThemeManager:GetDefaultTheme()
        ThemeManager:CheckFolderTree()

        local Path = GetDefaultThemePath()
        if Path == false then
            return "none", false, "Invalid path provided"
        end
        if not isfile(Path) then
            return "none", false, "Default theme is not set"
        end

        local Success, Name = pcall(readfile, Path)
        if not (Success and typeof(Name) == "string") then
            return "none", false, tostring(Name)
        end
        Name = Trim(Name)

        if not DoesThemeExist(Name) then
            return "none", false, "Theme file not found"
        end

        ThemeManager.DefaultThemeName = Name
        return Name, true
    end

    function ThemeManager:SetDefaultTheme(Theme)
        assert(ThemeManager.Library, "Library is not set, call ThemeManager:SetLibrary(Library) first.")
        assert(not ThemeManager.AppliedToTab, "Cannot set default theme after applying ThemeManager to a tab!")
        assert(typeof(Theme) == "table", "Theme must be a table")

        local Library = ThemeManager.Library
        local Fallback = ThemeManager.BuiltInThemes["Default"][2]
        local FinalTheme = {}

        for _, Index in SchemeIndexes do
            local Color = ParseHex(Theme[Index]) or ParseHex(Fallback[Index])
            Library.Scheme[Index] = Color
            FinalTheme[Index] = Color:ToHex()
        end

        local FontFace = Theme.FontFace
        if typeof(FontFace) == "EnumItem" then
            Library.Scheme.Font = Font.fromEnum(FontFace)
            FinalTheme.FontFace = FontFace.Name
        elseif typeof(FontFace) == "string" and pcall(function()
            return Enum.Font[FontFace]
        end) then
            Library.Scheme.Font = Font.fromEnum(Enum.Font[FontFace])
            FinalTheme.FontFace = FontFace
        end

        FinalTheme.BackgroundImage = typeof(Theme.BackgroundImage) == "string" and Theme.BackgroundImage or ""
        ThemeManager.BuiltInThemes["Default"] = { 1, FinalTheme }

        Library:UpdateColorsUsingRegistry()
    end

    function ThemeManager:SaveDefault(ThemeName)
        if IsStringEmpty(ThemeName) then
            return false, "No theme is selected"
        end

        ThemeManager:CheckFolderTree()

        local Path = GetDefaultThemePath()
        if Path == false then
            return false, "Invalid path provided"
        end
        if not DoesThemeExist(ThemeName) then
            return false, "Theme does not exist"
        end

        local Success, ErrorMessage = pcall(writefile, Path, ThemeName)
        if not Success then
            return false, tostring(ErrorMessage)
        end

        ThemeManager.DefaultThemeName = ThemeName
        return true
    end

    function ThemeManager:LoadDefault()
        local Name, Success, FetchError = ThemeManager:GetDefaultTheme()
        if not Success then
            if FetchError ~= "Default theme is not set" then
                Notify(string.format("Failed to apply default theme: %s", tostring(FetchError)))
            end
            return
        end

        local Options = ThemeManager.Library.Options
        if not ThemeManager:GetCustomTheme(Name) then
            if Options.ThemeManager_ThemeList then
                Options.ThemeManager_ThemeList:SetValue(Name)
            else
                ThemeManager:ApplyTheme(Name)
            end
            return
        end

        local ApplySuccess, ApplyError = ThemeManager:ApplyTheme(Name)
        if not ApplySuccess then
            Notify(string.format("Failed to apply default theme: %s", tostring(ApplyError)))
            return
        end
    end

    function ThemeManager:DeleteDefaultTheme()
        ThemeManager:CheckFolderTree()

        local Path = GetDefaultThemePath()
        if Path == false then
            return false, "Invalid path provided"
        end
        if not isfile(Path) then
            return false, "Default theme is not set"
        end

        local Success, ErrorMessage = pcall(delfile, Path)
        if not Success then
            return false, tostring(ErrorMessage)
        end

        ThemeManager.DefaultThemeName = nil
        return true
    end

    --// Contrast \\--
    function ThemeManager:GetContrastReport()
        local Library = ThemeManager.Library
        local Options = Library.Options
        local FontColor = Options.FontColor and Options.FontColor.Value or Library.Scheme.FontColor
        local Background = Options.BackgroundColor and Options.BackgroundColor.Value or Library.Scheme.BackgroundColor
        local Main = Options.MainColor and Options.MainColor.Value or Library.Scheme.MainColor

        local Worst, WorstName = math.huge, ""
        for _, Surface in {
            { Name = "font color vs. background color", Color = Background },
            { Name = "font color vs. main color", Color = Main },
        } do
            local Ratio = ContrastRatio(FontColor, Surface.Color)
            if Ratio < Worst then
                Worst, WorstName = Ratio, Surface.Name
            end
        end

        return { Ratio = Worst, PairName = WorstName, Passes = Worst >= ContrastWarnThreshold }
    end

    function ThemeManager:UpdateContrastWarning()
        local Label = ThemeManager.ContrastLabel
        if not Label or Label.Destroyed then
            return
        end

        local Library = ThemeManager.Library
        local Report = ThemeManager:GetContrastReport()

        if Report.Passes then
            Label:SetText(string.format("Contrast: good <font transparency=\"0.45\">(%.1f:1)</font>", Report.Ratio))
            Label.TextLabel.TextColor3 = Library.Scheme.FontColor
            Library.Registry[Label.TextLabel] = Library.Registry[Label.TextLabel] or {}
            Library.Registry[Label.TextLabel].TextColor3 = "FontColor"
        else
            Label:SetText(string.format(
                "Low contrast (%.1f:1) between %s. Aim for at least %.1f:1 so text stays readable.",
                Report.Ratio,
                Report.PairName,
                ContrastWarnThreshold
            ))
            Label.TextLabel.TextColor3 = Library.Scheme.RedColor
            Library.Registry[Label.TextLabel] = Library.Registry[Label.TextLabel] or {}
            Library.Registry[Label.TextLabel].TextColor3 = "RedColor"

            if not ThemeManager.ContrastWasPoor then
                Notify({
                    Title = "Low contrast theme",
                    Description = string.format("Your %s has a contrast ratio of %.1f:1. Text may be hard to read.", Report.PairName, Report.Ratio),
                    Icon = "triangle-alert",
                    Time = 8,
                })
            end
        end

        ThemeManager.ContrastWasPoor = not Report.Passes
    end

    --// Applying \\--
    function ThemeManager:ThemeUpdate()
        local Library = ThemeManager.Library
        for _, Index in SchemeIndexes do
            local Option = ThemeManager.OwnedOptions[Index]
            if Option and not Option.Destroyed then
                Library.Scheme[Index] = Option.Value
            end
        end
        Library:UpdateColorsUsingRegistry()
        ThemeManager:UpdateContrastWarning()
    end

    function ThemeManager:ApplyThemeData(ThemeData)
        if typeof(ThemeData) ~= "table" then
            return false, "Invalid theme data"
        end

        local Library = ThemeManager.Library
        ThemeManager.Applying = true

        for Index, Value in ThemeData do
            local Option = ThemeManager.OwnedOptions[Index]
            if Option and Option.Destroyed then
                Option = nil
            end

            if Index == "FontFace" then
                if typeof(Value) == "string" and pcall(function()
                    return Enum.Font[Value]
                end) then
                    Library:SetFont(Enum.Font[Value])
                    ThemeManager.CurrentFontName = Value
                    if Option and Option.Value ~= Value then
                        Option:SetValue(Value)
                    end
                end
            elseif Index == "BackgroundImage" then
                if typeof(Value) == "string" then
                    Library:SetBackgroundImage(Value)
                    ThemeManager.CurrentBackgroundImage = Value
                    if Option and Option.Value ~= Value then
                        Option:SetValue(Value)
                    end
                end
            elseif table.find(SchemeIndexes, Index) then
                local Color = ParseHex(Value)
                if Color then
                    Library.Scheme[Index] = Color
                    if Option then
                        Option:SetValueRGB(Color)
                    end
                end
            end
        end

        ThemeManager.Applying = false
        ThemeManager:ThemeUpdate()
        return true
    end

    function ThemeManager:ApplyTheme(ThemeName)
        if IsStringEmpty(ThemeName) then
            return false, "No theme is selected"
        end

        local Custom = ThemeManager:GetCustomTheme(ThemeName)
        local BuiltIn = ThemeManager.BuiltInThemes[ThemeName]
        local Data = Custom or (BuiltIn and BuiltIn[2])
        if not Data then
            return false, "Theme not found"
        end

        return ThemeManager:ApplyThemeData(Data)
    end

    function ThemeManager:LoadJSON(Content)
        if IsStringEmpty(Content) then
            return false, "No JSON provided"
        end

        local Success, Decoded = pcall(HttpService.JSONDecode, HttpService, Content)
        if not Success or not IsValidThemeData(Decoded) then
            return false, "Failed to decode theme data"
        end

        return ThemeManager:ApplyThemeData(Decoded)
    end

    --// Interface \\--
    local function ShowDialog(Condition, Index, Title, Description, ActionText, Action, Variant)
        if Condition() == false then
            return Action()
        end

        local Window = ThemeManager.Library and ThemeManager.Library.Window
        if not (Window and Window.AddDialog) then
            return Action()
        end

        return Window:AddDialog(Index, {
