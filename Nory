--// Context menus / popups \\--
local CurrentMenu = nil

function Library:AddContextMenu(Holder, Size, Offset, List, ActiveCallback, IgnoreCornerRadius, SpecificCornersOnly, AnimationType)
    local Menu
    local ParentGui = Overlay

    local HolderGui = Holder:FindFirstAncestorOfClass("ScreenGui")
    if HolderGui and HolderGui ~= ScreenGui and Library.ActiveLoading and HolderGui == Library.ActiveLoading.ScreenGui then
        ParentGui = HolderGui
    end

    local ResolvedSize = typeof(Size) == "function" and Size() or Size
    if List then
        Menu = New("ScrollingFrame", {
            Active = true,
            AutomaticCanvasSize = List == 2 and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
            AutomaticSize = List == 1 and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
            BackgroundColor3 = Palette.Popup,
            BackgroundTransparency = 0,
            CanvasSize = UDim2.fromOffset(0, 0),
            ClipsDescendants = true,
            ScrollBarImageColor3 = "AccentColor",
            ScrollBarImageTransparency = 0.35,
            ScrollBarThickness = List == 2 and 3 or 0,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Size = ResolvedSize,
            Visible = false,
            ZIndex = 2,
            Parent = ParentGui,
        })
    else
        Menu = New("Frame", {
            Active = true,
            BackgroundColor3 = Palette.Popup,
            ClipsDescendants = true,
            Size = ResolvedSize,
            Visible = false,
            ZIndex = 2,
            Parent = ParentGui,
        })
    end

    local MenuScale = AddScale(Menu)
    local MenuStroke = AddStroke(Menu, "OutlineColor", 0)
    local Corner = nil
    if IgnoreCornerRadius ~= true then
        Corner = AddCorner(Menu, 0.6)
    end

    --// soft shadow that follows the menu
    local Shadow = New("Frame", {
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 1,
        Parent = ParentGui,
    })
    for Index = 1, 3 do
        local Grow = Index * 4
        local Layer = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Palette.Shadow,
            BackgroundTransparency = 0.86 + Index * 0.035,
            Position = UDim2.new(0.5, 0, 0.5, 3),
            Size = UDim2.new(1, Grow * 2, 1, Grow * 2),
            ZIndex = 1,
            Parent = Shadow,
        })
        New("UICorner", { CornerRadius = UDim.new(0, 6 + Grow), Parent = Layer })
    end

    local function SyncShadow()
        Shadow.Position = UDim2.fromOffset(Menu.AbsolutePosition.X, Menu.AbsolutePosition.Y)
        Shadow.Size = UDim2.fromOffset(Menu.AbsoluteSize.X, Menu.AbsoluteSize.Y)
    end
    Menu:GetPropertyChangedSignal("AbsolutePosition"):Connect(SyncShadow)
    Menu:GetPropertyChangedSignal("AbsoluteSize"):Connect(SyncShadow)
    Menu:GetPropertyChangedSignal("Visible"):Connect(function()
        Shadow.Visible = Menu.Visible
        SyncShadow()
    end)

    local Table = {
        Connections = {},
        Destroyed = false,

        Active = false,
        ActiveCallback = ActiveCallback,

        Holder = Holder,
        Menu = Menu,
        Corner = Corner,
        Stroke = MenuStroke,
        Shadow = Shadow,

        List = nil,
        Signal = nil,

        Size = Size,
        Offset = Offset,
        AutoSizeY = List == 1,
        FlipUp = false,

        OpenCloseTween = nil,
        Animated = function()
            if AnimationType == "none" then
                return false
            end
            local Key = AnimationType or "Dropdown"
            if not (Library.Animations and Library.Animations[Key] == true) then
                return false
            end
            return true, Library[Key .. "TransitionInfo"] or Library.DropdownTransitionInfo
        end,
    }

    if List == 1 then
        Table.List = New("UIListLayout", {
            Parent = Menu,
        })
    end

    local function ResolveOffset()
        local Resolved = typeof(Table.Offset) == "function" and Table.Offset() or Table.Offset or { 0, 0 }
        return Resolved[1] or 0, Resolved[2] or 0
    end

    function Table:UpdatePosition(TargetHeight)
        local OffsetX, OffsetY = ResolveOffset()
        local HolderPos, HolderSize = Holder.AbsolutePosition, Holder.AbsoluteSize
        local Viewport = GetViewportSize()
        local Inset = GetCoreGuiInset()
        local Height = (TargetHeight or (Menu.AbsoluteSize.Y / math.max(MenuScale.Scale, 0.01))) * MenuScale.Scale

        local X = HolderPos.X + OffsetX
        local Y = HolderPos.Y + OffsetY

        --// flip above the holder when there is no room below
        Table.FlipUp = false
        if OffsetY >= HolderSize.Y * 0.5 and Y + Height > Viewport.Y - Inset.Y - 8 and HolderPos.Y - Height - 6 > 0 then
            Table.FlipUp = true
            Y = HolderPos.Y - (OffsetY - HolderSize.Y)
        end

        local Width = Menu.AbsoluteSize.X
        if X + Width > Viewport.X - 6 then
            X = math.max(6, Viewport.X - 6 - Width)
        end

        Menu.AnchorPoint = Table.FlipUp and Vector2.new(0, 1) or Vector2.zero
        Menu.Position = UDim2.fromOffset(math.floor(X), math.floor(Y))
    end

    local function GetTargetSize()
        local Target = typeof(Table.Size) == "function" and Table.Size() or Table.Size
        if Table.AutoSizeY then
            local ContentHeight = 0
            if Table.List then
                ContentHeight = Table.List.AbsoluteContentSize.Y / math.max(MenuScale.Scale, 0.01)
            end
            local Padding = Menu:FindFirstChildOfClass("UIPadding")
            if Padding then
                ContentHeight += Padding.PaddingTop.Offset + Padding.PaddingBottom.Offset
            end
            return UDim2.new(Target.X.Scale, Target.X.Offset, 0, ContentHeight), ContentHeight
        end
        return Target, Target.Y.Offset
    end

    function Table:Open()
        if Table.Destroyed then
            return
        end
        if CurrentMenu == Table then
            return
        elseif CurrentMenu then
            CurrentMenu:Close()
        end

        CurrentMenu = Table
        Table.Active = true

        Menu.Parent = nil
        Menu.Parent = ParentGui

        if typeof(ActiveCallback) == "function" then
            Library:SafeCallback(ActiveCallback, true)
        end

        if Table.OpenCloseTween then
            StopTween(Table.OpenCloseTween, true)
            Table.OpenCloseTween = nil
        end

        local TargetSize, TargetHeight = GetTargetSize()
        local IsAnimated, Info = Table.Animated()

        Menu.AutomaticSize = Enum.AutomaticSize.None
        Menu.Size = UDim2.new(TargetSize.X.Scale, TargetSize.X.Offset, 0, IsAnimated and 0 or TargetHeight)
        Menu.Visible = true
        Table:UpdatePosition(TargetHeight)

        if IsAnimated then
            MenuStroke.Transparency = 1
            Tween(MenuStroke, Info, { Transparency = 0 })

            local OpenTween = TweenService:Create(Menu, Info, { Size = UDim2.new(TargetSize.X.Scale, TargetSize.X.Offset, 0, TargetHeight) })
            Table.OpenCloseTween = OpenTween
            OpenTween.Completed:Connect(function(State)
                if Table.OpenCloseTween ~= OpenTween then
                    return
                end
                Table.OpenCloseTween = nil
                if State == Enum.PlaybackState.Completed and Table.AutoSizeY and Table.Active then
                    Menu.AutomaticSize = Enum.AutomaticSize.Y
                    Menu.Size = UDim2.new(TargetSize.X.Scale, TargetSize.X.Offset, 0, 0)
                end
            end)
            OpenTween:Play()
        elseif Table.AutoSizeY then
            Menu.AutomaticSize = Enum.AutomaticSize.Y
            Menu.Size = UDim2.new(TargetSize.X.Scale, TargetSize.X.Offset, 0, 0)
        end

        if Table.Signal then
            Table.Signal:Disconnect()
        end
        Table.Signal = Holder:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            if not Table.Active then
                return
            end

            Table:UpdatePosition()

            local Container = Library.WindowContainer
            if Container and Holder:IsDescendantOf(Container) and not Library:IsInsideFrame(Container, Holder) then
                Table:Close()
            end
        end)
    end

    function Table:Close()
        if CurrentMenu ~= Table then
            return
        end

        if Table.Signal then
            Table.Signal:Disconnect()
            Table.Signal = nil
        end

        Table.Active = false
        CurrentMenu = nil

        if typeof(ActiveCallback) == "function" then
            Library:SafeCallback(ActiveCallback, false)
        end

        if Table.OpenCloseTween then
            StopTween(Table.OpenCloseTween, true)
            Table.OpenCloseTween = nil
        end

        local IsAnimated, Info = Table.Animated()
        if IsAnimated and Menu.Visible then
            local CurrentHeight = Menu.AbsoluteSize.Y / math.max(MenuScale.Scale, 0.01)
            local CurrentWidth = Menu.Size
            Menu.AutomaticSize = Enum.AutomaticSize.None
            Menu.Size = UDim2.new(CurrentWidth.X.Scale, CurrentWidth.X.Offset, 0, CurrentHeight)

            local CloseInfo = TweenInfo.new(Info.Time * 0.75, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            Tween(MenuStroke, CloseInfo, { Transparency = 1 })
            local CloseTween = TweenService:Create(Menu, CloseInfo, { Size = UDim2.new(CurrentWidth.X.Scale, CurrentWidth.X.Offset, 0, 0) })
            Table.OpenCloseTween = CloseTween
            CloseTween.Completed:Connect(function()
                if Table.OpenCloseTween ~= CloseTween then
                    return
                end
                Table.OpenCloseTween = nil
                if not Table.Active then
                    Menu.Visible = false
                end
            end)
            CloseTween:Play()
        else
            Menu.Visible = false
        end
    end

    function Table:Toggle()
        if Table.Active then
            Table:Close()
        else
            Table:Open()
        end
    end

    function Table:SetSize(NewSize)
        Table.Size = NewSize
        local Resolved = typeof(NewSize) == "function" and NewSize() or NewSize
        if not Table.Active then
            Menu.Size = Resolved
            return
        end
        if Table.OpenCloseTween then
            return
        end
        if Table.AutoSizeY then
            Menu.Size = UDim2.new(Resolved.X.Scale, Resolved.X.Offset, 0, 0)
        else
            Menu.Size = Resolved
            Table:UpdatePosition(Resolved.Y.Offset)
        end
    end

    function Table:Refresh()
        if not Table.Active or Table.OpenCloseTween then
            return
        end
        local TargetSize, TargetHeight = GetTargetSize()
        if not Table.AutoSizeY then
            Menu.Size = TargetSize
        end
        Table:UpdatePosition(TargetHeight)
    end

    function Table:Destroy()
        if CurrentMenu == Table then
            Table:Close()
        end
        Table.Destroyed = true

        for _, Connection in Table.Connections do
            Connection:Disconnect()
        end
        if Table.OpenCloseTween then
            StopTween(Table.OpenCloseTween, true)
            Table.OpenCloseTween = nil
        end

        local Index = table.find(Library.ContextMenus, Table)
        if Index then
            table.remove(Library.ContextMenus, Index)
        end

        Shadow:Destroy()
        Menu:Destroy()
    end

    table.insert(Library.ContextMenus, Table)
    return Table
end

function Library:CloseAllMenus()
    if CurrentMenu then
        CurrentMenu:Close()
    end
end

Library:GiveSignal(UserInputService.InputBegan:Connect(function(Input)
    if Library.Unloaded then
        return
    end

    if IsClickInput(Input, true) and CurrentMenu then
        local Location = Input.Position
        if not (Library:MouseIsOverFrame(CurrentMenu.Menu, Location) or Library:MouseIsOverFrame(CurrentMenu.Holder, Location)) then
            local Owned = false
            if CurrentMenu.ExtraFrames then
                for _, Extra in CurrentMenu.ExtraFrames do
                    if Extra.Visible and Library:MouseIsOverFrame(Extra, Location) then
                        Owned = true
                        break
                    end
                end
            end
            if not Owned then
                CurrentMenu:Close()
            end
        end
    end
end))

