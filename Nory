                    ImageColor3 = "FontColor",
                    ImageTransparency = 1,
                    Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(13, 13),
                    Parent = PopOutButton,
                })
                PopOutButton:SetAttribute("OnyxIcon", true)
                PopOutButton.MouseEnter:Connect(function()
                    Tween(PopOutButton, Library.TweenInfo, { BackgroundTransparency = 0 })
                    Tween(PopIcon, Library.TweenInfo, { ImageTransparency = 0 })
                end)
                PopOutButton.MouseLeave:Connect(function()
                    Tween(PopOutButton, Library.TweenInfo, { BackgroundTransparency = 1 })
                    Tween(PopIcon, Library.TweenInfo, { ImageTransparency = 0.6 })
                end)
                Header.MouseEnter:Connect(function()
                    Tween(PopIcon, Library.TweenInfo, { ImageTransparency = 0.6 })
                end)
                Header.MouseLeave:Connect(function()
                    if not Library:MouseIsOverFrame(PopOutButton, Mouse) then
                        Tween(PopIcon, Library.TweenInfo, { ImageTransparency = 1 })
                    end
                end)
            end

            local CollapseButton, CollapseIcon
            if CanCollapse then
                CollapseButton = New("ImageButton", {
                    BackgroundColor3 = "MainColor",
                    BackgroundTransparency = 1,
                    LayoutOrder = 2,
                    Size = UDim2.fromOffset(22, 22),
                    Parent = HeaderButtons,
                })
                AddCorner(CollapseButton, 0.5)
                CollapseIcon = MakeIcon("chevron-down", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    ImageColor3 = "FontColor",
                    ImageTransparency = 0.5,
                    Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(15, 15),
                    Parent = CollapseButton,
                })
                CollapseButton.MouseEnter:Connect(function()
                    Tween(CollapseButton, Library.TweenInfo, { BackgroundTransparency = 0 })
                    Tween(CollapseIcon, Library.TweenInfo, { ImageTransparency = 0 })
                end)
                CollapseButton.MouseLeave:Connect(function()
                    Tween(CollapseButton, Library.TweenInfo, { BackgroundTransparency = 1 })
                    Tween(CollapseIcon, Library.TweenInfo, { ImageTransparency = 0.5 })
                end)
            end

            local HeaderLine = New("Frame", {
                BackgroundColor3 = Palette.OutlineSoft,
                LayoutOrder = 2,
                Size = UDim2.new(1, 0, 0, 1),
                Parent = Card,
            })

            local BodyFrame = New("Frame", {
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                ClipsDescendants = true,
                LayoutOrder = 3,
                Size = UDim2.new(1, 0, 0, 0),
                Parent = Card,
            })

            local GroupboxContainer = New("Frame", {
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 0),
                Parent = BodyFrame,
            })
            New("UIListLayout", {
                Padding = UDim.new(0, 9),
                Parent = GroupboxContainer,
            })
            AddPadding(GroupboxContainer, 11, 13, 13, 13)

            local Groupbox = {
                Type = "Groupbox",
                Name = Info.Name,
                Description = Info.Description,

                Connections = {},
                Destroyed = false,

                Visible = true,
                Collapsed = false,

                BoxHolder = BoxHolder,
                Holder = Card,
                Container = GroupboxContainer,

                Tab = Tab,
                DependencyBoxes = {},
                Elements = {},
            }

            local CollapseToken = 0

            function Groupbox:Resize() end

            function Groupbox:SetDescription(NewDescription)
                Groupbox.Description = NewDescription
                HeaderDescription = NewDescription
                LayoutHeader()
            end

            function Groupbox:SetCollapsed(Collapsed, Silent)
                if not CanCollapse then
                    return
                end
                Collapsed = Collapsed == true
                if not Silent then
                    Groupbox.SearchExpanded = false
                end
                if Groupbox.Collapsed == Collapsed then
                    return
                end
                Groupbox.Collapsed = Collapsed

                CollapseToken += 1
                local Token = CollapseToken
                local Animated = Library.Animations and Library.Animations.Groupbox and Library.Toggled and Card.Parent ~= nil
                local Scale = math.max(Library.DPIScale, 0.01)

                if CollapseIcon then
                    Tween(CollapseIcon, Animated and Library.RotatingChevronTweenInfo or TweenInfo.new(0), { Rotation = Collapsed and -90 or 0 })
                end

                if not Animated then
                    BodyFrame.AutomaticSize = Collapsed and Enum.AutomaticSize.None or Enum.AutomaticSize.Y
                    BodyFrame.Size = UDim2.new(1, 0, 0, 0)
                    BodyFrame.Visible = not Collapsed
                    HeaderLine.Visible = not Collapsed
                    return
                end

                local ContentHeight = GroupboxContainer.AbsoluteSize.Y / Scale
                if Collapsed then
                    BodyFrame.AutomaticSize = Enum.AutomaticSize.None
                    BodyFrame.Size = UDim2.new(1, 0, 0, ContentHeight)
                    local CollapseTween = Tween(BodyFrame, Library.GroupboxTweenInfo, { Size = UDim2.new(1, 0, 0, 0) })
                    CollapseTween.Completed:Connect(function()
                        if Token == CollapseToken then
                            BodyFrame.Visible = false
                            HeaderLine.Visible = false
                        end
                    end)
                else
                    BodyFrame.AutomaticSize = Enum.AutomaticSize.None
                    BodyFrame.Size = UDim2.new(1, 0, 0, 0)
                    BodyFrame.Visible = true
                    HeaderLine.Visible = true
                    if ContentHeight <= 0 then
                        BodyFrame.AutomaticSize = Enum.AutomaticSize.Y
                        return
                    end
                    local ExpandTween = Tween(BodyFrame, Library.GroupboxTweenInfo, { Size = UDim2.new(1, 0, 0, ContentHeight) })
                    ExpandTween.Completed:Connect(function()
                        if Token == CollapseToken and not Groupbox.Collapsed then
                            BodyFrame.AutomaticSize = Enum.AutomaticSize.Y
                            BodyFrame.Size = UDim2.new(1, 0, 0, 0)
                        end
                    end)
                end
            end

            function Groupbox:ToggleCollapsed()
                if not CanCollapse then
                    return
                end
                Groupbox:SetCollapsed(not Groupbox.Collapsed)
            end

            function Groupbox:SetVisible(Visible)
                Groupbox.Visible = Visible == true
                BoxHolder.Visible = Groupbox.Visible
                if Groupbox.RefreshPopOutVisibility then
                    Groupbox.RefreshPopOutVisibility()
                end
                Groupbox:RefreshPopOutPlaceholder()
                if Groupbox.Visible and Library.Searching then
                    Library:UpdateSearch(Library.SearchText)
                end
            end

            function Groupbox:Show()
                Groupbox:SetVisible(true)
            end

            function Groupbox:Hide()
                Groupbox:SetVisible(false)
            end

            MakeBoxPopOut(Groupbox, {
                Enabled = Info.PopOut ~= false,
                MaxPopOutHeight = Info.MaxPopOutHeight,
                PopOutWidth = Info.PopOutWidth,
                Card = Card,
                BoxHolder = BoxHolder,
                Header = Header,
            })

            if PopOutButton then
                PopOutButton.MouseButton1Click:Connect(function()
                    Groupbox:TogglePoppedOut()
                end)
            end

            if CollapseButton then
                CollapseButton.MouseButton1Click:Connect(function()
                    Groupbox:ToggleCollapsed()
                end)
            end

            local PressPosition = nil
            Header.InputBegan:Connect(function(Input)
                if IsClickInput(Input) then
                    PressPosition = Input.Position
                end
            end)
            Header.MouseButton1Click:Connect(function()
                if Groupbox.PoppedOut then
                    return
                end
                if PressPosition and (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(PressPosition.X, PressPosition.Y)).Magnitude > 6 then
                    return
                end
                if CollapseButton and Library:MouseIsOverFrame(HeaderButtons, Mouse) then
                    return
                end
                Groupbox:ToggleCollapsed()
            end)

            Header.MouseEnter:Connect(function()
                TweenTheme(CardStroke, "Color", "OutlineColor")
            end)
            Header.MouseLeave:Connect(function()
                TweenTheme(CardStroke, "Color", Palette.OutlineSoft)
            end)

            function Groupbox:Destroy()
                if Groupbox.PoppedOut then
                    Groupbox:SetPoppedOut(false)
                end
                Groupbox.Destroyed = true
                for _, Connection in Groupbox.Connections do
                    Connection:Disconnect()
                end
                for _, Element in table.clone(Groupbox.Elements) do
                    if Element.Destroy then
                        Element:Destroy()
                    end
                end
                table.clear(Groupbox.Elements)
                for _, Depbox in table.clone(Groupbox.DependencyBoxes) do
                    if Depbox.Destroy then
                        Depbox:Destroy()
                    end
                end
                table.clear(Groupbox.DependencyBoxes)
                BoxHolder:Destroy()
                if Tab.Groupboxes[Info.Name] == Groupbox then
                    Tab.Groupboxes[Info.Name] = nil
                end
            end

            Groupbox.AddTabbox = function(Self, SubInfo)
                if typeof(SubInfo) == "string" then
                    SubInfo = { Name = SubInfo }
                end
                return Builders.Tabbox(Self, SubInfo or {})
            end
            setmetatable(Groupbox, BaseGroupbox)

            Tab.Groupboxes[Info.Name] = Groupbox

            if Info.Visible == false then
                Groupbox:Hide()
            end
            if CanCollapse and Info.Collapsed == true then
                Groupbox:SetCollapsed(true)
            end

            return Groupbox
        end

        function Tab:AddLeftGroupbox(GroupName, IconName, Visible, Collapsed, DisableCollapsing)
            return Tab:AddGroupbox({ Side = 1, Name = GroupName, IconName = IconName, Visible = Visible, Collapsed = Collapsed, DisableCollapsing = DisableCollapsing })
        end

        function Tab:AddRightGroupbox(GroupName, IconName, Visible, Collapsed, DisableCollapsing)
            return Tab:AddGroupbox({ Side = 2, Name = GroupName, IconName = IconName, Visible = Visible, Collapsed = Collapsed, DisableCollapsing = DisableCollapsing })
        end

        local Hovering = false
        function Tab:Hover(Value)
            Hovering = Value
            SetTabButtonState(Entry, Library.ActiveTab == Tab, Hovering)
        end

        function Tab:Show()
            if Library.ActiveTab == Tab then
                return
            end
            if Library.ActiveTab then
                Library.ActiveTab:Hide()
            end

            Library.ActiveTab = Tab
            SetTabButtonState(Entry, true, Hovering)
            SetHeaderText(Name, Description)
            PlayTabAnimation(Tab, true)
            Tab:RefreshSides()

            if Library.Searching then
                Library:UpdateSearch(Library.SearchText)
            end
        end

        function Tab:Hide()
            if Library.Searching then
                ResetTabSearch(Tab)
            end
            PlayTabAnimation(Tab, false)
            Library.PreviousTab = Tab
            if Library.ActiveTab == Tab then
                Library.ActiveTab = nil
            end
            SetTabButtonState(Entry, false, Hovering)
        end

        function Tab:SetVisible(Visible)
            TabButton.Visible = Visible
            if not Visible and Library.ActiveTab == Tab then
                Tab:Hide()
            end
        end

        function Tab:SetOrder(NewOrder)
            Order = NewOrder
            TabButton.LayoutOrder = NewOrder
        end

        function Tab:SetTooltip(Text)
            Tab.Tooltip = Text
            if Tab.TooltipTable then
                Tab.TooltipTable:Destroy()
                Tab.TooltipTable = nil
            end
            if typeof(Text) == "string" then
                Tab.TooltipTable = Library:AddTooltip(Text, nil, TabButton)
            end
        end

        function Tab:Destroy()
            Tab.Destroyed = true
            for _, Connection in Tab.Connections do
                Connection:Disconnect()
            end
            if Tab.TooltipTable then
                Tab.TooltipTable:Destroy()
            end
            for _, Groupbox in Tab.Groupboxes do
                Groupbox:Destroy()
            end
            for _, Tabbox in Tab.Tabboxes do
                Tabbox:Destroy()
            end
            for _, DepGroupbox in table.clone(Tab.DependencyGroupboxes) do
                DepGroupbox:Destroy()
            end
            TabContainer:Destroy()

            local Index = table.find(Library.TabButtons, Entry)
            if Index then
                table.remove(Library.TabButtons, Index)
            end
            TabButton:Destroy()

            if Library.ActiveTab == Tab then
                Library.ActiveTab = nil
            end
            Library.Tabs[Name] = nil
        end

        if typeof(Tooltip) == "string" then
            Tab.TooltipTable = Library:AddTooltip(Tooltip, nil, TabButton)
        end

        TabButton.MouseEnter:Connect(function()
            Tab:Hover(true)
        end)
        TabButton.MouseLeave:Connect(function()
            Tab:Hover(false)
        end)
        TabButton.MouseButton1Click:Connect(function()
            Tab:Show()
        end)

        Library.Tabs[Name] = Tab

        if not Library.ActiveTab then
            Tab:Show()
        end

        return Tab
    end

