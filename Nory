    function Funcs:AddViewport(Idx, Info)
        if self.Destroyed then
            return nil
        end

        Info = Library:Validate(Info, Templates.Viewport)
        local Groupbox = self

        local Dragging = false
        local LastMousePos = nil

        local ViewportObject = Info.Object
        if Info.Clone and typeof(Info.Object) == "Instance" then
            if Info.Object.Archivable then
                ViewportObject = ViewportObject:Clone()
            else
                Info.Object.Archivable = true
                ViewportObject = ViewportObject:Clone()
                Info.Object.Archivable = false
            end
        end

        local Viewport = {
            Object = ViewportObject,
            Camera = Info.Camera or Instance.new("Camera"),
            Interactive = Info.Interactive,
            AutoFocus = Info.AutoFocus,
            Height = Info.Height,
            Visible = Info.Visible,
            Type = "Viewport",
            Connections = {},
            Destroyed = false,
            Parent = Groupbox,
        }

        local Holder = ElementHolder(Groupbox, Info.Height)
        Holder.Visible = Viewport.Visible

        local Box = New("Frame", {
            BackgroundColor3 = "MainColor",
            Size = UDim2.fromScale(1, 1),
            Parent = Holder,
        })
        AddCorner(Box, 0.6)
        AddStroke(Box, "OutlineColor", 0)

        local ViewportFrame = New("ViewportFrame", {
            BackgroundTransparency = 1,
            CurrentCamera = Viewport.Camera,
            Size = UDim2.fromScale(1, 1),
            Parent = Box,
        })
        AddCorner(ViewportFrame, 0.6)

        local DragButton = New("TextButton", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Visible = Viewport.Interactive,
            ZIndex = 2,
            Parent = Box,
        })

        Viewport.Camera.Parent = ViewportFrame
        if ViewportObject then
            ViewportObject.Parent = ViewportFrame
        end

        local function GetModelSize(Model)
            if Model:IsA("BasePart") then
                return Model.Size
            end
            return select(2, Model:GetBoundingBox())
        end

        local function FocusCamera()
            if not Viewport.Object then
                return
            end
            local Size = GetModelSize(Viewport.Object)
            local MaxExtent = math.max(Size.X, Size.Y, Size.Z)
            local Distance = (MaxExtent / (2 * math.tan(math.rad(Viewport.Camera.FieldOfView) / 2))) * 1.6
            local Center = Viewport.Object:GetPivot().Position
            Viewport.Camera.CFrame = CFrame.new(Center + Vector3.new(0, MaxExtent / 2, Distance), Center)
        end

        if Info.AutoFocus then
            pcall(FocusCamera)
        end

        table.insert(Viewport.Connections, DragButton.MouseButton1Down:Connect(function()
            Dragging = true
            LastMousePos = UserInputService:GetMouseLocation()
        end))
        table.insert(Viewport.Connections, UserInputService.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                Dragging = false
            end
        end))
        table.insert(Viewport.Connections, UserInputService.InputChanged:Connect(function(Input)
            if not (Viewport.Interactive and Viewport.Object) then
                return
            end

            if Input.UserInputType == Enum.UserInputType.MouseWheel and Library:MouseIsOverFrame(Box, Mouse) then
                local Center = Viewport.Object:GetPivot().Position
                local Offset = Viewport.Camera.CFrame.Position - Center
                local Distance = math.clamp(Offset.Magnitude - Input.Position.Z * 2, 1, 500)
                Viewport.Camera.CFrame = CFrame.new(Center + Offset.Unit * Distance, Center)
            elseif Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
                local MousePos = UserInputService:GetMouseLocation()
                local Delta = MousePos - (LastMousePos or MousePos)
                LastMousePos = MousePos

                local Center = Viewport.Object:GetPivot().Position
                local Rotation = CFrame.Angles(0, -Delta.X * 0.01, 0) * CFrame.Angles(-Delta.Y * 0.01, 0, 0)
                local Offset = Viewport.Camera.CFrame.Position - Center
                Viewport.Camera.CFrame = CFrame.new(Center + Rotation:VectorToWorldSpace(Offset), Center)
            end
        end))

        function Viewport:SetObject(Object, Clone)
            if Viewport.Object then
                Viewport.Object:Destroy()
            end
            if Clone then
                local Archivable = Object.Archivable
                Object.Archivable = true
                Object = Object:Clone()
                Object.Archivable = Archivable
            end
            Viewport.Object = Object
            Object.Parent = ViewportFrame
            if Viewport.AutoFocus then
                pcall(FocusCamera)
            end
        end

        function Viewport:SetHeight(Height)
            Viewport.Height = Height
            Holder.Size = UDim2.new(1, 0, 0, Height)
            Groupbox:Resize()
        end

        function Viewport:Focus()
            pcall(FocusCamera)
        end

        function Viewport:SetCamera(Camera)
            Viewport.Camera = Camera
            ViewportFrame.CurrentCamera = Camera
        end

        function Viewport:SetInteractive(Interactive)
            Viewport.Interactive = Interactive
            DragButton.Visible = Interactive
        end

        function Viewport:SetVisible(Visible)
            Viewport.Visible = Visible
            Holder.Visible = Visible
            Groupbox:Resize()
        end

        function Viewport:Destroy()
            Viewport.Destroyed = true
            for _, Connection in Viewport.Connections do
                Connection:Disconnect()
            end
            if Viewport.Object then
                pcall(Viewport.Object.Destroy, Viewport.Object)
            end
            Holder:Destroy()
            RemoveElement(Groupbox, Viewport)
            Options[Idx] = nil
        end

        Viewport.Holder = Holder
        table.insert(Groupbox.Elements, Viewport)
        Options[Idx] = Viewport
        Groupbox:Resize()
        return Viewport
    end

