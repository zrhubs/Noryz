--// Fonts / background helpers \\--
function Library:SetFont(FontFace)
    if typeof(FontFace) == "EnumItem" then
        FontFace = Font.fromEnum(FontFace)
    end
    if typeof(FontFace) ~= "Font" then
        return
    end

    Library.Scheme.Font = FontFace
    Library:UpdateColorsUsingRegistry()

    if Library.Window and Library.Window.RefreshTitleSize then
        Library.Window:RefreshTitleSize()
    end
end

function Library:SetBackgroundImage(Image)
    assert(typeof(Image) == "string" or typeof(Image) == "number", "Expected string/number got " .. typeof(Image))
    Library.Scheme.BackgroundImage = Image
    if Library.Window then
        Library.Window:SetBackgroundImage(tostring(Image))
    end
    Library:UpdateColorsUsingRegistry()
end

local function ApplyCornerRadius(Radius)
    local Alive = {}
    for _, Corner in Library.Corners do
        if Corner.Parent then
            local Factor = CornerFactors[Corner] or 1
            Corner.CornerRadius = UDim.new(0, math.floor(Radius * Factor + 0.5))
            table.insert(Alive, Corner)
        end
    end
    Library.Corners = Alive
end

--// Search \\--
local function ElementMatches(Element, Query)
    if not Element then
        return false, 0
    end

    local Best = 0
    local Matched = false
    for _, Field in { Element.Text, Element.Tooltip, Element.DisabledTooltip } do
        local Ok, Score = MatchText(Field, Query)
        if Ok then
            Matched = true
            Best = math.max(Best, Score)
        end
    end

    if not Matched and typeof(Element.Values) == "table" then
        local Checked = 0
        for Key, Value in Element.Values do
            Checked += 1
            if Checked > 200 then
                break
            end
            if MatchText(tostring(Value), Query) or (typeof(Key) == "string" and MatchText(Key, Query)) then
                Matched = true
                Best = math.max(Best, 1)
                break
            end
        end
    end

    return Matched, Best
end

local function ApplySearchToBox(Box, Query, ForceAll)
    local Visible = 0
    local Best = 0

    for _, Element in Box.Elements do
        if not Element.Holder then
            continue
        end

        if Element.Type == "Divider" then
            Element.Holder.Visible = ForceAll and Element.Visible ~= false
            continue
        end

        if Element.SubButton then
            local MainMatch = ForceAll or ElementMatches(Element, Query)
            local SubMatch = ForceAll or ElementMatches(Element.SubButton, Query)
            Element.Base.Visible = MainMatch and true or false
            Element.SubButton.Base.Visible = SubMatch and Element.SubButton.Visible ~= false
            local Show = (MainMatch or SubMatch) and Element.Visible ~= false
            Element.Holder.Visible = Show
            if Show then
                Visible += 1
            end
            continue
        end

        local Matched, Score = ElementMatches(Element, Query)
        local Show = (ForceAll or Matched) and Element.Visible ~= false
        Element.Holder.Visible = Show
        if Show then
            Visible += 1
            Best = math.max(Best, Score)
        end
    end

    for _, Depbox in Box.DependencyBoxes or {} do
        if Depbox.Visible then
            local SubVisible, SubBest = ApplySearchToBox(Depbox, Query, ForceAll)
            Visible += SubVisible
            Best = math.max(Best, SubBest)
            Depbox.Container.Visible = SubVisible > 0
        end
    end

    return Visible, Best
end

local function RestoreBox(Box)
    for _, Element in Box.Elements do
        if not Element.Holder then
            continue
        end
        Element.Holder.Visible = Element.Visible ~= false
        if Element.SubButton then
            Element.Base.Visible = true
            Element.SubButton.Base.Visible = Element.SubButton.Visible ~= false
        end
    end
    for _, Depbox in Box.DependencyBoxes or {} do
        RestoreBox(Depbox)
        Depbox.Container.Visible = Depbox.Visible == true
    end
end

local function ForEachBox(Tab, Callback)
    for _, Groupbox in Tab.Groupboxes do
        Callback(Groupbox, "Groupbox")
    end
    for _, Tabbox in Tab.Tabboxes do
        Callback(Tabbox, "Tabbox")
    end
    for _, DepGroupbox in Tab.DependencyGroupboxes do
        Callback(DepGroupbox, "DependencyGroupbox")
    end
end

local function ResetTabSearch(Tab)
    if Tab.IsKeyTab then
        return
    end

    ForEachBox(Tab, function(Box, Kind)
        if Kind == "Tabbox" then
            for _, SubTab in Box.Tabs do
                RestoreBox(SubTab)
            end
            Box.BoxHolder.Visible = Box.Visible ~= false
            if Box.SearchPreviousTab and Box.Tabs then
                local Previous = Box.SearchPreviousTab
                Box.SearchPreviousTab = nil
                if Previous ~= Box.ActiveTab and not Previous.Destroyed then
                    Previous:Show()
                end
            end
        elseif Kind == "DependencyGroupbox" then
            RestoreBox(Box)
            Box.Holder.Visible = Box.Visible == true
        else
            RestoreBox(Box)
            Box.BoxHolder.Visible = Box.Visible ~= false
            if Box.SearchExpanded then
                Box.SearchExpanded = false
                Box:SetCollapsed(true, true)
            end
        end
    end)
end

local function ApplySearchToTab(Tab, Query)
    if Tab.IsKeyTab then
        return 0, 0
    end

    local Total, Best = 0, 0

    ForEachBox(Tab, function(Box, Kind)
        if Kind == "Tabbox" then
            if Box.Visible == false then
                return
            end

            local BoxVisible, FirstMatch = 0, nil
            for _, SubTab in Box.Tabs do
                local Count, Score = ApplySearchToBox(SubTab, Query, false)
                if Count > 0 then
                    BoxVisible += Count
                    Best = math.max(Best, Score)
                    FirstMatch = FirstMatch or SubTab
                end
            end

            Box.BoxHolder.Visible = BoxVisible > 0
            if BoxVisible > 0 and Box.ActiveTab and FirstMatch then
                local ActiveCount = ApplySearchToBox(Box.ActiveTab, Query, false)
                if ActiveCount == 0 then
                    Box.SearchPreviousTab = Box.SearchPreviousTab or Box.ActiveTab
                    FirstMatch:Show()
                end
            end
            Total += BoxVisible
            return
        end

        if Kind == "DependencyGroupbox" then
            if not Box.Visible then
                Box.Holder.Visible = false
                return
            end
            local Count, Score = ApplySearchToBox(Box, Query, false)
            Box.Holder.Visible = Count > 0
            Total += Count
            Best = math.max(Best, Score)
            return
        end

        if Box.Visible == false then
            return
        end

        local NameMatch, NameScore = MatchText(Box.Name, Query)
        local Count, Score = ApplySearchToBox(Box, Query, NameMatch)
        Box.BoxHolder.Visible = Count > 0
        if Count > 0 then
            Total += Count
            Best = math.max(Best, Score, NameMatch and NameScore or 0)
            if Box.Collapsed and not Box.SearchExpanded then
                Box.SearchExpanded = true
                Box:SetCollapsed(false, true)
            end
        end
    end)

    return Total, Best
end

function Library:UpdateSearch(SearchText)
    SearchText = tostring(SearchText or "")
    Library.SearchText = SearchText

    local TabsToSearch = {}
    for _, Tab in Library.Tabs do
        if typeof(Tab) == "table" and not Tab.IsKeyTab then
            table.insert(TabsToSearch, Tab)
        end
    end

    for _, Tab in TabsToSearch do
        ResetTabSearch(Tab)
    end

    local Query = NormalizeSearch(SearchText)
    if Query == "" then
        Library.Searching = false
        Library.LastSearchTab = nil
        return
    end

    if not Library.GlobalSearch and Library.ActiveTab and Library.ActiveTab.IsKeyTab then
        Library.Searching = false
        return
    end

    Library.Searching = true

    if not Library.GlobalSearch then
        if Library.ActiveTab then
            ApplySearchToTab(Library.ActiveTab, Query)
        end
        return
    end

    local BestTab, BestScore = nil, -1
    local ActiveCount = 0
    for _, Tab in TabsToSearch do
        local Count, Score = ApplySearchToTab(Tab, Query)
        if Tab == Library.ActiveTab then
            ActiveCount = Count
        end
        if Count > 0 and Score > BestScore then
            BestTab, BestScore = Tab, Score
        end
    end

    if ActiveCount == 0 and BestTab and BestTab ~= Library.ActiveTab then
        local Marker = SearchText
        task.defer(function()
            if Library.SearchText == Marker then
                BestTab:Show()
            end
        end)
    end
end

--// Pop-out support for groupboxes / tabboxes \\--
local function MakeBoxPopOut(Box, Options)
    Box.PopOutEnabled = Options.Enabled ~= false
    Box.PoppedOut = false
    Box.PopOutFloat = nil
    Box.PopOutPlaceholder = nil
    Box.PopOutMaxHeight = Options.MaxPopOutHeight
    Box.PopOutWidth = Options.PopOutWidth

    local Card = Options.Card
    local BoxHolder = Options.BoxHolder
    local DragHandle = nil

    local function RefreshFloatVisibility()
        if Box.PopOutFloat then
            Box.PopOutFloat.Visible = Library.Toggled and Box.Visible ~= false
        end
    end
    Box.RefreshPopOutVisibility = RefreshFloatVisibility

    function Box:RefreshPopOutPlaceholder()
        if Box.PopOutPlaceholder then
            Box.PopOutPlaceholder.Visible = Box.PoppedOut and Box.Visible ~= false
        end
    end

    function Box:SetMaxPopOutHeight(Height)
        Box.PopOutMaxHeight = Height
    end

    function Box:SetPopOutWidth(Width)
        Box.PopOutWidth = Width
        if Box.PopOutFloat and Width then
            Box.PopOutFloat.Size = UDim2.fromOffset(Width, 0)
        end
    end

    function Box:SetPoppedOut(Value, FloatPosition)
        Value = Value == true
        if not Box.PopOutEnabled and Value then
            return
        end
        if Value == Box.PoppedOut then
            return
        end

        if Value then
            local Scale = math.max(Library.DPIScale, 0.01)
            local Width = Box.PopOutWidth or math.max(220, Card.AbsoluteSize.X / Scale)

            local Float = New("Frame", {
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Position = FloatPosition or UDim2.fromOffset(Card.AbsolutePosition.X + 24, Card.AbsolutePosition.Y + 24),
                Size = UDim2.fromOffset(Width, 0),
                Parent = Floats,
            })
            AddScale(Float)
            AddShadow(Float, nil, 16, 0.45, 0)

            local Placeholder = New("TextButton", {
                BackgroundColor3 = Palette.Card,
                BackgroundTransparency = 0.5,
                LayoutOrder = -1,
                Size = UDim2.new(1, 0, 0, 42),
                Parent = BoxHolder,
            })
            AddCorner(Placeholder, 0.85)
            AddStroke(Placeholder, Palette.OutlineSoft, 0)
            New("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                Text = string.format("%s  <font transparency=\"0.5\">is popped out · click to dock</font>", tostring(Box.Name or "Box")),
                TextSize = 13,
                TextTransparency = 0.25,
                TextXAlignment = Enum.TextXAlignment.Center,
                Parent = Placeholder,
            })
            Placeholder.MouseButton1Click:Connect(function()
                Box:SetPoppedOut(false)
            end)

            Card.Parent = Float
            Box.PopOutFloat = Float
            Box.PopOutPlaceholder = Placeholder
            Box.PoppedOut = true

            DragHandle = Library:MakeDraggable(Float, Options.Header, true)
            table.insert(Library.DraggableElements, Float)
            RefreshFloatVisibility()
        else
            Card.Parent = BoxHolder
            local Index = table.find(Library.DraggableElements, Box.PopOutFloat)
            if Index then
                table.remove(Library.DraggableElements, Index)
            end
            if DragHandle then
                DragHandle.Stop()
                DragHandle = nil
            end
            if Box.PopOutFloat then
                Box.PopOutFloat:Destroy()
            end
            if Box.PopOutPlaceholder then
                Box.PopOutPlaceholder:Destroy()
            end
            Box.PopOutFloat = nil
            Box.PopOutPlaceholder = nil
            Box.PoppedOut = false
        end

        if Options.After then
            Options.After(Value)
        end
    end

    function Box:TogglePoppedOut()
        Box:SetPoppedOut(not Box.PoppedOut)
    end
end

--// Window \\--
function Library:CreateWindow(WindowInfo)
    WindowInfo = Library:Validate(WindowInfo, Templates.Window)

    local Viewport = GetViewportSize()
    if RunService:IsStudio() and Viewport.X <= 5 and Viewport.Y <= 5 then
        repeat
            task.wait()
            Viewport = GetViewportSize()
        until Viewport.X > 5 and Viewport.Y > 5
    end

    local MaxX = math.max(320, Viewport.X - 40)
    local MaxY = math.max(240, Viewport.Y - 70)

    Library.OriginalMinSize = Vector2.new(math.min(Library.OriginalMinSize.X, MaxX), math.min(Library.OriginalMinSize.Y, MaxY))
    Library.MinSize = Library.OriginalMinSize * Library.DPIScale

    local DefaultSize = Library.IsMobile and UDim2.fromOffset(620, 360) or WindowInfo.Size
    if Library.IsMobile and WindowInfo.Size ~= Templates.Window.Size then
        DefaultSize = WindowInfo.Size
    end
    WindowInfo.Size = UDim2.fromOffset(
        math.clamp(DefaultSize.X.Offset, Library.OriginalMinSize.X, MaxX),
        math.clamp(DefaultSize.Y.Offset, Library.OriginalMinSize.Y, MaxY)
    )

    if typeof(WindowInfo.Font) == "EnumItem" then
        WindowInfo.Font = Font.fromEnum(WindowInfo.Font)
    end
    WindowInfo.CornerRadius = math.clamp(tonumber(WindowInfo.CornerRadius) or 8, 0, 20)

    local TabButtonsStyle = WindowInfo.TabButtonsStyle

    if WindowInfo.Compact ~= nil then
        WindowInfo.SidebarCompacted = WindowInfo.Compact
    end
    if WindowInfo.SidebarMinWidth ~= nil then
        WindowInfo.MinSidebarWidth = WindowInfo.SidebarMinWidth
    end

    Library.CornerRadius = WindowInfo.CornerRadius
    ApplyCornerRadius(Library.CornerRadius)
    Library:SetNotifySide(WindowInfo.NotifySide)
    Library.ShowCustomCursor = WindowInfo.ShowCustomCursor
    if typeof(WindowInfo.Font) == "Font" then
        Library.Scheme.Font = WindowInfo.Font
        Library:UpdateColorsUsingRegistry()
    end
    Library.ToggleKeybind = WindowInfo.ToggleKeybind
    Library.WindowTitle = WindowInfo.Title

    if WindowInfo.MouseBehaviorOnClose ~= nil then
        local Behavior = WindowInfo.MouseBehaviorOnClose
        if typeof(Behavior) == "string" then
            local Success, Item = pcall(function()
                return Enum.MouseBehavior[Behavior]
            end)
            Behavior = Success and Item or nil
        end
        Library.MouseBehaviorOnClose = Behavior
    end

    --// Re-executing the same script replaces its old window instead of stacking a second copy
    --// (two copies would fight over the menu key and the mouse). Other scripts are left alone.
    do
        local Env = getgenv()
        local Instances = Env.OnyxInstances
        if typeof(Instances) ~= "table" then
            Instances = {}
            Env.OnyxInstances = Instances
        end
        for Index = #Instances, 1, -1 do
            local Other = Instances[Index]
            if Other ~= Library then
                if typeof(Other) ~= "table" or Other.Unloaded then
                    table.remove(Instances, Index)
                elseif WindowInfo.ReplaceExisting ~= false and Other.WindowTitle == WindowInfo.Title then
                    pcall(Other.Unload, Other)
                    table.remove(Instances, Index)
                end
            end
        end
        if not table.find(Instances, Library) then
            table.insert(Instances, Library)
        end
    end
    Library.GlobalSearch = WindowInfo.GlobalSearch

    Library.Animations = WindowInfo.Animations
    Library.TabTransitionInfo = TweenInfo.new(math.max(0, WindowInfo.TabTransitionTime or 0.32), Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    Library.TabSwipeOffset = math.max(1, WindowInfo.TabSwipeOffset or 12)
    Library.TabSwipeFrom = WindowInfo.TabSwipeFrom or "bottom"

    Watermark:SetText(WindowInfo.Title)
    Watermark:SetVisible(WindowInfo.ShowWatermark ~= false)

    local SidebarWidth = math.clamp(tonumber(WindowInfo.SidebarWidth) or 190, 120, 320)
    if Library.IsMobile then
        SidebarWidth = math.min(SidebarWidth, 160)
    end
    local IsCompact = false
    local LastExpandedWidth = SidebarWidth

    local HeaderHeight = 58
