local function WaitForEvent(Event, Timeout, Condition)
    local Bindable = Instance.new("BindableEvent")
    local Fired = false
    local Connection = Event:Connect(function(...)
        if Fired then
            return
        end
        Fired = true
        Bindable:Fire(not Condition or (typeof(Condition) == "function" and Condition(...)))
    end)
    task.delay(Timeout, function()
        if Fired then
            return
        end
        Fired = true
        Bindable:Fire(false)
    end)

    local Result = Bindable.Event:Wait()
    Connection:Disconnect()
    Bindable:Destroy()
    return Result
end

--// Fuzzy search \\--
local function FuzzyScore(Text, Search)
    if Search == "" then
        return true, 0
    end
    if Text == "" then
        return false, 0
    end

    local ExactIndex = Text:find(Search, 1, true)
    if ExactIndex then
        local PrevChar = ExactIndex > 1 and Text:sub(ExactIndex - 1, ExactIndex - 1) or ""
        local AtBoundary = ExactIndex == 1 or PrevChar:match("[%s%p_]") ~= nil
        return true, 1e5 - ExactIndex + (AtBoundary and 500 or 0) + (#Search * 5)
    end

    if #Search > #Text then
        return false, 0
    end

    local SearchIndex, Score, Run, LastMatch = 1, 0, 0, 0
    for TextIndex = 1, #Text do
        if SearchIndex > #Search then
            break
        end
        if Text:sub(TextIndex, TextIndex) == Search:sub(SearchIndex, SearchIndex) then
            local PrevChar = TextIndex > 1 and Text:sub(TextIndex - 1, TextIndex - 1) or ""
            local AtBoundary = TextIndex == 1 or PrevChar:match("[%s%p_]") ~= nil
            Run = (LastMatch == TextIndex - 1) and (Run + 1) or 1
            Score += 1 + (AtBoundary and 6 or 0) + math.min(Run - 1, 5) * 3
            LastMatch = TextIndex
            SearchIndex += 1
        end
    end

    if SearchIndex <= #Search then
        return false, 0
    end

    return true, Score - (LastMatch - #Search) * 0.05
end

local function NormalizeSearch(Search)
    return (tostring(Search):lower():gsub("%s+", ""))
end

local function StripRichText(Text)
    return (tostring(Text):gsub("<[^>]->", ""))
end

local function MatchText(Text, Search)
    if typeof(Text) ~= "string" or Text == "" then
        return false, 0
    end
    return FuzzyScore(NormalizeSearch(StripRichText(Text)), Search)
end

local function GetPlayers(ExcludeLocalPlayer)
    local PlayerList = Players:GetPlayers()

    if ExcludeLocalPlayer then
        local Index = table.find(PlayerList, LocalPlayer)
        if Index then
            table.remove(PlayerList, Index)
        end
    end

    table.sort(PlayerList, function(A, B)
        return A.Name:lower() < B.Name:lower()
    end)

    return PlayerList
end

local function GetTeams()
    local TeamList = Teams:GetTeams()
    table.sort(TeamList, function(A, B)
        return A.Name:lower() < B.Name:lower()
    end)
    return TeamList
end

--// Color helpers \\--
local function Luminance(Color)
    return 0.2126 * Color.R + 0.7152 * Color.G + 0.0722 * Color.B
end

local function ShiftAccent(Color)
    local H, S, V = Color:ToHSV()
    if S < 0.08 then
        return Color:Lerp(Color3.new(1, 1, 1), 0.3)
    end
    return Color3.fromHSV((H - 0.06) % 1, math.clamp(S * 0.82, 0, 1), math.clamp(V * 1.06 + 0.06, 0, 1))
end

