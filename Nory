local ThemeProperties = {
    BackgroundColor3 = true,
    TextColor3 = true,
    ImageColor3 = true,
    BorderColor3 = true,
    Color = true,
    PlaceholderColor3 = true,
    ScrollBarImageColor3 = true,
    TextStrokeColor3 = true,
    FontFace = true,
}

local function ResolveThemeValue(Value)
    if typeof(Value) == "function" then
        local Success, Result = pcall(Value)
        if Success then
            return true, Result
        end
        return false, nil
    end

    if typeof(Value) == "string" then
        local SchemeValue = GetSchemeValue(Value)
        if SchemeValue ~= nil then
            return true, SchemeValue
        end
    end

    return false, Value
end

local function ApplyProperties(Object, Properties)
    local Theme = Library.Registry[Object]
    local Parent = nil

    for Property, Value in Properties do
        if Property == "Parent" then
            Parent = Value
            continue
        end

        if ThemeProperties[Property] then
            local IsTheme, Resolved = ResolveThemeValue(Value)
            if IsTheme then
                Theme = Theme or {}
                Theme[Property] = Value
                Value = Resolved
            elseif Theme then
                Theme[Property] = nil
            end
        end

        if Value ~= nil then
            Object[Property] = Value
        end
    end

    if Theme and next(Theme) then
        Library.Registry[Object] = Theme
    end

    if Parent then
        Object.Parent = Parent
    end
end

