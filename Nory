        if Entry.Icon then
            if not Entry.IsCustomIcon then
                SetTheme(Entry.Icon, "ImageColor3", Active and "AccentColor" or "FontColor")
            end
            Tween(Entry.Icon, Library.TweenInfo, {
                ImageTransparency = Active and 0 or (Hovering and 0.15 or 0.5),
            })
        end
        Tween(Entry.Indicator, Info, {
            BackgroundTransparency = Active and 0 or 1,
            Size = UDim2.fromOffset(TabButtonsStyle.IndicatorWidth or 3, Active and (TabButtonsStyle.IndicatorHeight or 16) or 0),
        })
    end

    local function ParseTabArgs(...)
        local Name, Icon, Description, Tooltip, Order
        if select("#", ...) == 1 and typeof((...)) == "table" then
            local Info = select(1, ...)
            Name = Info.Name or "Tab"
            Icon = Info.Icon
            Description = Info.Description
            Tooltip = Info.Tooltip
            Order = Info.Order
        else
            Name = select(1, ...) or "Tab"
            Icon = select(2, ...)
            Description = select(3, ...)
            Order = select(4, ...)
        end
        if not tonumber(Order) then
            Order = #TabList:GetChildren()
        end
        return tostring(Name), Icon, Description, Tooltip, tonumber(Order)
    end

    --// Tabbox builder (used by tabs and nested in groupboxes) \\--
    Builders.Tabbox = function(ParentObj, Info)
        Info = Library:Validate(Info, Templates.Tabbox)
        local IsNested = ParentObj.Type == "Groupbox" or ParentObj.Type == "SubTab" or ParentObj.IsDependencyBox or ParentObj.IsDependencyGroupbox
        local Tab = IsNested and ParentObj.Tab or ParentObj

        if typeof(Info.Side) == "string" then
            local Lower = Info.Side:lower()
            if not SideIndex[Lower] then
                error(string.format("Invalid side: %s", Info.Side))
            end
            Info.Side = SideIndex[Lower]
        end

        local BoxHolder = New("Frame", {
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder = NextOrder(),
            Size = UDim2.new(1, 0, 0, 0),
            Parent = IsNested and ParentObj.Container or (Info.Side == 1 and Tab.Sides[1] or Tab.Sides[2]),
        })
        New("UIListLayout", {
            Padding = UDim.new(0, 10),
            Parent = BoxHolder,
        })

        local Card = New("Frame", {
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = IsNested and "MainColor" or Palette.Card,
            BackgroundTransparency = IsNested and 0.6 or 0,
            Size = UDim2.new(1, 0, 0, 0),
            Parent = BoxHolder,
        })
        AddCorner(Card, 0.85)
        AddStroke(Card, Palette.OutlineSoft, 0)
        New("UIListLayout", {
            Parent = Card,
        })

        local HeaderFrame = New("Frame", {
            BackgroundTransparency = 1,
            LayoutOrder = 1,
            Size = UDim2.new(1, 0, 0, 44),
            Parent = Card,
        })
        local Segments = New("Frame", {
            BackgroundColor3 = "BackgroundColor",
            BackgroundTransparency = 0.25,
            Position = UDim2.fromOffset(8, 8),
            Size = UDim2.new(1, -16, 0, 30),
            Parent = HeaderFrame,
        })
        AddCorner(Segments, 0.7)
        New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalFlex = Enum.UIFlexAlignment.Fill,
            Padding = UDim.new(0, 3),
            VerticalAlignment = Enum.VerticalAlignment.Center,
            Parent = Segments,
        })
        AddPadding(Segments, 3, 3, 3, 3)

        local Tabbox = {
            Type = "Tabbox",
            Name = Info.Name,
            Connections = {},
            Destroyed = false,
            Visible = true,
            ActiveTab = nil,
            BoxHolder = BoxHolder,
            Holder = Card,
            Tabs = {},
            ParentBox = IsNested and ParentObj or nil,
            Tab = Tab,
        }

        local TotalTabs = 0

        function Tabbox:UpdateCorners() end

        function Tabbox:Resize()
            if IsNested and ParentObj.Resize then
                ParentObj:Resize()
            end
        end

        function Tabbox:SetVisible(Visible)
            Tabbox.Visible = Visible == true
            BoxHolder.Visible = Tabbox.Visible
            if Tabbox.RefreshPopOutVisibility then
                Tabbox.RefreshPopOutVisibility()
            end
            Tabbox:RefreshPopOutPlaceholder()
        end

        function Tabbox:Show()
            Tabbox:SetVisible(true)
        end

        function Tabbox:Hide()
            Tabbox:SetVisible(false)
        end

        function Tabbox:AddTab(Name, IconName)
            TotalTabs += 1
            local TabIndex = TotalTabs
            local IsNameEmpty = Name == nil or Trim(tostring(Name)) == ""
            local StoringIndex = IsNameEmpty and tostring(TabIndex) or Name

            local Button = New("TextButton", {
                BackgroundColor3 = "MainColor",
                BackgroundTransparency = 1,
                LayoutOrder = TabIndex,
                Size = UDim2.new(0, 0, 1, 0),
                Parent = Segments,
            })
            AddCorner(Button, 0.55)
            local ButtonStroke = AddStroke(Button, Palette.OutlineSoft, 1)

            local ButtonContent = New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(0, 16),
                Parent = Button,
            })
            New("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                HorizontalAlignment = Enum.HorizontalAlignment.Center,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                Padding = UDim.new(0, 6),
                Parent = ButtonContent,
            })

            local ButtonIcon
            local BoxIcon = Library:GetCustomIcon(IconName)
            if BoxIcon then
                ButtonIcon = New("ImageLabel", {
                    ImageColor3 = BoxIcon.Custom and "WhiteColor" or "AccentColor",
                    ImageTransparency = 0.45,
                    Size = UDim2.fromOffset(14, 14),
                    Parent = ButtonContent,
                })
                Library:ApplyLucideIcon(ButtonIcon, BoxIcon)
            end

            local ButtonLabel
            if not IsNameEmpty then
                ButtonLabel = New("TextLabel", {
                    AutomaticSize = Enum.AutomaticSize.X,
                    FontFace = Fonts.Medium,
                    LayoutOrder = 1,
                    Size = UDim2.fromOffset(0, 16),
                    Text = tostring(Name),
                    TextSize = 13.5,
                    TextTransparency = 0.45,
                    Parent = ButtonContent,
                })
            end

            local Container = New("Frame", {
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder = 3,
                Size = UDim2.new(1, 0, 0, 0),
                Visible = false,
                Parent = Card,
            })
            New("UIListLayout", {
                Padding = UDim.new(0, 8),
                Parent = Container,
            })
            AddPadding(Container, 6, 12, 14, 12)

            local SubTab = {
                Type = "SubTab",
                Name = Name,
                Connections = {},
                Destroyed = false,
                ButtonHolder = Button,
                Container = Container,
                Tab = Tab,
                Tabbox = Tabbox,
                Elements = {},
                DependencyBoxes = {},
            }

            local Hovering = false
            local function Refresh()
                local Active = Tabbox.ActiveTab == SubTab
                Tween(Button, Library.TweenInfo, { BackgroundTransparency = Active and 0 or (Hovering and 0.6 or 1) })
                Tween(ButtonStroke, Library.TweenInfo, { Transparency = Active and 0 or 1 })
                if ButtonLabel then
                    Tween(ButtonLabel, Library.TweenInfo, { TextTransparency = Active and 0 or (Hovering and 0.2 or 0.45) })
                end
                if ButtonIcon then
                    Tween(ButtonIcon, Library.TweenInfo, { ImageTransparency = Active and 0 or (Hovering and 0.2 or 0.45) })
                end
            end

            function SubTab:Show()
                if Tabbox.ActiveTab and Tabbox.ActiveTab ~= SubTab then
                    Tabbox.ActiveTab:Hide()
                end
                Tabbox.ActiveTab = SubTab
                Container.Visible = true
                Refresh()
                Tabbox:RefreshPopOutPlaceholder()
                Tabbox:Resize()
            end

            function SubTab:Hide()
                Container.Visible = false
                if Tabbox.ActiveTab == SubTab then
                    Tabbox.ActiveTab = nil
                end
                Refresh()
            end

            function SubTab:Resize()
                Tabbox:Resize()
            end

            function SubTab:UpdateCorners() end

            function SubTab:Destroy()
                SubTab.Destroyed = true
                for _, Connection in SubTab.Connections do
                    Connection:Disconnect()
                end
                for _, Element in table.clone(SubTab.Elements) do
                    if Element.Destroy then
                        Element:Destroy()
                    end
                end
                for _, Depbox in table.clone(SubTab.DependencyBoxes) do
                    if Depbox.Destroy then
                        Depbox:Destroy()
                    end
                end
                Container:Destroy()
                Button:Destroy()
            end

            table.insert(SubTab.Connections, Button.MouseEnter:Connect(function()
                Hovering = true
                Refresh()
            end))
            table.insert(SubTab.Connections, Button.MouseLeave:Connect(function()
                Hovering = false
                Refresh()
            end))
            table.insert(SubTab.Connections, Button.MouseButton1Click:Connect(function()
                SubTab:Show()
            end))

            SubTab.AddTabbox = function(Self, SubInfo)
                if typeof(SubInfo) == "string" then
                    SubInfo = { Name = SubInfo }
                end
                return Builders.Tabbox(Self, SubInfo or {})
            end
            setmetatable(SubTab, BaseGroupbox)

            Tabbox.Tabs[StoringIndex] = SubTab
            if not Tabbox.ActiveTab then
                SubTab:Show()
            else
                Refresh()
            end

            return SubTab, StoringIndex
        end

        MakeBoxPopOut(Tabbox, {
            Enabled = Info.PopOut ~= false,
            MaxPopOutHeight = Info.MaxPopOutHeight,
            PopOutWidth = Info.PopOutWidth,
            Card = Card,
            BoxHolder = BoxHolder,
            Header = HeaderFrame,
        })

        function Tabbox:Destroy()
            if Tabbox.PoppedOut then
                Tabbox:SetPoppedOut(false)
            end
            Tabbox.Destroyed = true
            for _, Connection in Tabbox.Connections do
                Connection:Disconnect()
            end
            for _, SubTab in Tabbox.Tabs do
                SubTab:Destroy()
            end
            BoxHolder:Destroy()
        end

        if Tab.Tabboxes then
            if Info.Name then
                Tab.Tabboxes[Info.Name] = Tabbox
            else
                table.insert(Tab.Tabboxes, Tabbox)
            end
        end

        return Tabbox
    end

    --// Regular tabs \\--
    function Window:AddTab(...)
        local Name, IconName, Description, Tooltip, Order = ParseTabArgs(...)
        local Icon = Library:GetCustomIcon(IconName)

        local Entry = CreateTabButton(Name, Icon, Order)
        local TabButton = Entry.Button

        local TabContainer = New("Frame", {
            BackgroundTransparency = 1,
